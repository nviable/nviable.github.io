---
/**
 * Experience detail — Figma design language:
 * - Full-bleed Indigo Hero (#282b61) with breadcrumb, category eyebrow, title, subtitle, and meta
 * - Full-bleed Yellow Band (#f6eb0f) with keywords & back navigation
 * - Prose MDX body
 * Route: /experience/:slug
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { pagesConfig } from '../../pages.config';

export async function getStaticPaths() {
  const entries = await getCollection('experience');
  return entries.map((e) => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const entry = slug ? await getEntry('experience', slug) : undefined;

if (!entry) {
  return Astro.redirect('/experience');
}

const { Content } = await render(entry);

const categoryLabel: Record<string, string> = {
  about: 'About',
  personal: 'Personal',
  experience: 'Position',
  education: 'Education',
};

const seoTitle = `${entry.data.title} · ${pagesConfig.experience.heading}`;
const seoDescription =
  entry.data.description ??
  entry.data.metaLine ??
  pagesConfig.experience.description;

const keywords = entry.data.keywords ?? [];
---

<BaseLayout>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDescription}
    type="website"
    image={`/og/experience/${entry.id}.png`}
  />

  <StructuredData
    type="BreadcrumbList"
    data={{
      items: [
        { name: 'Home', url: '/' },
        { name: pagesConfig.experience.heading, url: '/experience' },
        { name: entry.data.breadcrumbLabel, url: `/experience/${entry.id}` },
      ],
    }}
  />

  <main class="experience-detail-page">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. PURPLE INDIGO HERO
         ════════════════════════════════════════════════════════════════════════ -->
    <header class="indigo-hero">
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="350"
        height="196"
        class="indigo-hero__corner indigo-hero__corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="368"
        height="219"
        class="indigo-hero__corner indigo-hero__corner--br"
        aria-hidden="true"
      />

      <div class="indigo-hero__inner">
        <nav class="indigo-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/experience">{pagesConfig.experience.heading}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{entry.data.breadcrumbLabel}</span>
        </nav>

        <p class="indigo-hero__eyebrow">{categoryLabel[entry.data.category] ?? 'Experience'}</p>
        <h1 class="indigo-hero__title">{entry.data.title}</h1>
        {entry.data.subtitle && <p class="indigo-hero__subtitle">{entry.data.subtitle}</p>}
        {entry.data.metaLine && (
          <div class="indigo-hero__stats">
            <span class="indigo-hero__stat-pill">{entry.data.metaLine}</span>
          </div>
        )}
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. YELLOW BAND WITH KEYWORDS & BACK LINK
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="yellow-band">
      <div class="yellow-band__inner">
        <div class="yellow-band__group">
          {keywords.length > 0 ? (
            <>
              <span class="yellow-band__label">Keywords:</span>
              {keywords.map((k) => (
                <span class="yellow-band__pill yellow-band__pill--static">{k}</span>
              ))}
            </>
          ) : (
            <span class="yellow-band__label">
              {categoryLabel[entry.data.category] ?? 'Experience'} · {entry.data.breadcrumbLabel}
            </span>
          )}
        </div>

        <a href="/experience" class="yellow-band__pill">← All experience</a>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. PROSE BODY
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="page-container experience-detail">
      <div class="exp-detail-body prose">
        <Content />
      </div>

      <div class="exp-detail-back">
        <BackLink href="/experience" text="All experience" />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .experience-detail-page {
    width: 100%;
  }

  .experience-detail {
    max-width: 780px;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .experience-detail .exp-detail-body.prose {
    max-width: 65ch;
  }

  .experience-detail .exp-detail-back {
    margin: 2.5rem 0 0;
  }
</style>
