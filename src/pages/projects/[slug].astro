---
/**
 * Project detail page — structured frontmatter (abstract, highlights, collaborators,
 * artifacts) plus MDX body; related papers via relatedPublications.
 *
 * Route: /projects/[slug]
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ProjectAbstractCard from '../../components/ProjectAbstractCard.astro';
import ProjectHighlightStrip from '../../components/ProjectHighlightStrip.astro';
import ProjectCollaborators from '../../components/ProjectCollaborators.astro';
import ProjectArtifactButtons from '../../components/ProjectArtifactButtons.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

const { Content } = await render(project);

const {
  title,
  subtitle,
  role,
  institution,
  year,
  duration,
  abstract,
  highlights,
  collaborators,
  type: classificationType,
  domains,
  methodologyClass,
  artifacts,
  relatedProjects,
  relatedPublications,
  status,
} = project.data;

const metaDescription =
  abstract.replace(/\s+/g, ' ').trim().slice(0, 155) +
  (abstract.replace(/\s+/g, ' ').trim().length > 155 ? '…' : '');

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
  inactive: { label: 'Inactive', class: 'status--inactive' },
};
const statusInfo = statusConfig[status || 'completed'];

const allText = [abstract, ...highlights, project.body || ''].join(' ');
const readingTime = formatReadingTime(calculateReadingTime(allText));
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Case Study`}
    description={metaDescription}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{
      title,
      description: abstract,
      year,
      keywords: domains.join(', '),
    }}
  />

  <main class="case-study">
    <header class="case-study-header">
      <div class="header-badges">
        {status && status !== 'completed' && (
          <span class:list={['status-badge', statusInfo.class]}>
            {statusInfo.label}
          </span>
        )}
      </div>
      <h1>{title}</h1>
      {subtitle && <p class="case-study-subtitle">{subtitle}</p>}

      <ProjectHighlightStrip highlights={highlights} />

      <div class="case-study-meta">
        <span class="meta-item">{role}</span>
        <span class="meta-separator">·</span>
        <span class="meta-item">{institution}</span>
        <span class="meta-separator">·</span>
        <span class="meta-item">{year}</span>
        {duration && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-item">{duration}</span>
          </>
        )}
        <span class="meta-separator">·</span>
        <span class="meta-item">{readingTime}</span>
      </div>

      <div class="case-study-classification">
        <span class="classification-type">{classificationType}</span>
        {domains.length > 0 && (
          <span class="classification-domains">
            {domains.map((d) => (
              <span class="domain-chip">{d}</span>
            ))}
          </span>
        )}
        <span class="classification-method">{methodologyClass}</span>
      </div>
    </header>

    <ProjectAbstractCard abstract={abstract} />

    <ProjectCollaborators collaborators={collaborators} />

    {Content && (
      <section class="case-study-content">
        <Content />
      </section>
    )}

    <ProjectArtifactButtons artifacts={artifacts} />

    <RelatedContent
      relatedProjects={relatedProjects}
      relatedPublications={relatedPublications}
    />

    <BackLink href="/projects" text="All projects" />
  </main>

  <ScrollToTop />

  <style>
    .case-study {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .case-study-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .header-badges {
      margin-bottom: 0.75rem;
    }

    .header-badges:empty {
      display: none;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.625rem;
      border-radius: 4px;
    }

    .status--ongoing {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }

    .status--archived {
      background: rgba(115, 115, 115, 0.15);
      color: var(--color-text-muted);
    }

    .status--inactive {
      background: rgba(234, 179, 8, 0.12);
      color: #ca8a04;
    }

    .case-study-header h1 {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .case-study-subtitle {
      font-size: 1.25rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
      margin: 0 0 1rem;
    }

    .case-study-classification {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    .classification-type {
      font-weight: 600;
      color: var(--color-text-secondary);
    }

    .classification-domains {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .domain-chip {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--color-border);
    }

    .classification-method {
      flex-basis: 100%;
      font-size: 0.8125rem;
    }

    @media (min-width: 640px) {
      .classification-method {
        flex-basis: auto;
        margin-left: 0;
      }
    }

    .case-study-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
    }

    .meta-separator {
      opacity: 0.5;
    }

    .case-study-content {
      margin-bottom: 2.5rem;
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .case-study-content :global(h2) {
      font-size: 1.75rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .case-study-content :global(h3) {
      font-size: 1.25rem;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-weight: 600;
      color: var(--color-text);
    }

    .case-study-content :global(p) {
      margin-bottom: 1rem;
    }

    .case-study-content :global(ul),
    .case-study-content :global(ol) {
      margin-bottom: 1rem;
      padding-left: 1.25rem;
    }

    .case-study-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.9375rem;
    }

    .case-study-content :global(th),
    .case-study-content :global(td) {
      border: 1px solid var(--color-border);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }

    @media (max-width: 768px) {
      .case-study {
        padding: 1.5rem 1rem;
      }

      .case-study-header h1 {
        font-size: 2rem;
      }
    }
  </style>
</BaseLayout>
