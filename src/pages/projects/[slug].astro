---
/**
 * Project detail page — structured frontmatter plus MDX body.
 *
 * Header (wider than the prose): title, status, primary link, and abstract
 * on one side; dates, classification, and the cover on the other.
 * Team is a compact block under the highlights.
 * Covers render at their own aspect. Logos stay small on gray; figures can be larger.
 * Body (65ch, centered): the MDX story only. The abstract lives in the header.
 * Related items sit in a wider two-column block after the story.
 *
 * Route: /projects/[slug]
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ProjectHighlightStrip from '../../components/ProjectHighlightStrip.astro';
import ProjectCollaborators from '../../components/ProjectCollaborators.astro';
import ProjectArtifactButtons from '../../components/ProjectArtifactButtons.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { getCollection, getEntry, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';
import { projectCoverKind } from '../../utils/projectImage';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(project);

const {
  title,
  subtitle,
  year,
  duration,
  abstract,
  highlights,
  collaborators,
  type: classificationType,
  domains,
  methodologyClass,
  artifacts,
  relatedProjects,
  relatedPublications,
  status,
  coverImage,
} = project.data;

const metaDescription =
  abstract.replace(/\s+/g, ' ').trim().slice(0, 155) +
  (abstract.replace(/\s+/g, ' ').trim().length > 155 ? '…' : '');

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
  inactive: { label: 'Inactive', class: 'status--inactive' },
};
const statusInfo = statusConfig[status || 'completed'];
const showStatus = Boolean(status && status !== 'completed');

const TYPE_LABELS: Record<string, string> = {
  'research-project': 'Research project',
  tool: 'Tool',
  collaboration: 'Collaboration',
  course: 'Course',
};

const METHOD_LABELS: Record<string, string> = {
  qualitative: 'Qualitative',
  quantitative: 'Quantitative',
  mixed: 'Mixed methods',
  systems: 'Systems',
  design: 'Design',
};

function humanLabel(value: string, labels: Record<string, string>): string {
  return labels[value] ?? value;
}

const typeLabel = humanLabel(classificationType, TYPE_LABELS);
const methodLabel = humanLabel(methodologyClass, METHOD_LABELS);

/** Duration once, without a status word the badge already shows. */
function dateLabel(value: string | undefined, projectYear: number): string {
  const stripped = (value ?? '')
    .replace(/\s*\((?:ongoing|inactive|archived|completed)\)/gi, '')
    .replace(/\s+/g, ' ')
    .trim();
  return stripped || String(projectYear);
}

const dates = dateLabel(duration, year);

const allText = [abstract, ...highlights, project.body || ''].join(' ');
const readingMinutes = calculateReadingTime(allText);
const readingTime = formatReadingTime(readingMinutes);
/** Short pages don't get "3 min read" chrome. Dungeons & Deepfakes is the long page. */
const showReadingTime = readingMinutes >= 8;

const primaryArtifact = artifacts[0];
const secondaryArtifacts = artifacts.slice(1);

const coverKind = projectCoverKind(coverImage);

const contents = headings.filter((heading) => heading.depth === 2);
const showContents = contents.length >= 3;
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Case Study`}
    description={metaDescription}
    type="article"
    image={`/og/projects/${slug}.png`}
  />

  <StructuredData
    type="Project"
    data={{
      title,
      description: abstract,
      year,
      keywords: domains.join(', '),
    }}
  />

  <main class="case-study">
    <header class="case-study-header">
      <div class="case-study-top">
        <div class="case-study-lead">
          <h1>{title}</h1>
          {subtitle && <p class="case-study-subtitle">{subtitle}</p>}
          {showStatus && (
            <span class:list={['status-badge', statusInfo.class]}>
              {statusInfo.label}
            </span>
          )}
          {primaryArtifact && (
            <a
              class="btn btn-primary case-study-primary"
              href={primaryArtifact.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {primaryArtifact.label}
              <ArrowUpRight class="leave-icon" size={14} stroke-width={2} aria-hidden="true" />
            </a>
          )}
          <p class="case-study-abstract">{abstract}</p>
        </div>

        <div class="case-study-aside">
          <p class="case-study-meta-line"><span class="meta-part">{dates}</span>{showReadingTime && <span class="meta-part">{readingTime}</span>}</p>
          <div class="case-study-classification">
            <span class="classification-type">{typeLabel}</span>
            {domains.length > 0 && (
              <span class="classification-domains">
                {domains.map((d) => (
                  <span class="domain-chip">{d}</span>
                ))}
              </span>
            )}
            <span class="classification-method">{methodLabel}</span>
          </div>
          {coverImage && coverKind && (
            <figure class:list={['case-study-cover', `case-study-cover--${coverKind}`]}>
              <img
                src={coverImage}
                alt={coverKind === 'figure' ? title : ''}
                loading="eager"
                decoding="async"
                onerror="this.closest('figure')?.remove()"
              />
            </figure>
          )}
        </div>
      </div>

      <ProjectHighlightStrip highlights={highlights} />
      <ProjectCollaborators collaborators={collaborators} />
    </header>

    <div class="case-study-body">
      <section class="case-study-content">
        {showContents && (
          <nav class="case-study-contents" aria-label="Contents">
            <ol>
              {contents.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
        {Content && <Content />}
      </section>

      <ProjectArtifactButtons artifacts={secondaryArtifacts} />
    </div>

    <div class="case-study-related">
      <RelatedContent
        relatedProjects={relatedProjects}
        relatedPublications={relatedPublications}
      />
      <BackLink href="/projects" text="All projects" />
    </div>
  </main>

  <ScrollToTop />

  <style>
    .case-study {
      max-width: var(--max-width-wide);
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
    }

    .case-study-body {
      max-width: var(--max-width-prose);
      margin: 0 auto;
    }

    .case-study-related {
      max-width: 100%;
      margin-top: 2.5rem;
    }

    .case-study-header {
      margin-bottom: 2rem;
      padding-bottom: 1.75rem;
      border-bottom: 1px solid var(--color-border);
    }

    .case-study-top {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
      gap: 1.5rem 2.75rem;
      align-items: start;
    }

    .case-study-lead {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-width: 0;
    }

    .case-study-primary {
      --btn-pad-y: 0.4rem;
      --btn-pad-x: 0.8rem;
      align-self: flex-start;
      margin-top: 0.75rem;
      font-size: 0.8125rem;
    }

    .case-study-abstract {
      margin: 1.15rem 0 0;
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
      text-align: start;
    }

    .case-study-aside {
      min-width: 0;
    }

    .case-study-cover {
      margin: 1.1rem 0 0;
    }

    .case-study-cover img {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
    }

    .case-study-cover--logo {
      display: inline-block;
      max-width: 100%;
      padding: 0.75rem 0.9rem;
      background: var(--color-card);
    }

    .case-study-cover--logo img {
      max-width: 11rem;
      max-height: 4.25rem;
      object-fit: contain;
      object-position: left center;
    }

    .case-study-cover--figure img {
      max-width: min(100%, 18rem);
    }

    .status-badge {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      margin-top: 0.75rem;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.625rem;
      border-radius: var(--border-radius-pill);
    }

    .status--ongoing {
      background: color-mix(in srgb, var(--color-quaternary) 18%, transparent);
      color: var(--color-status-ongoing);
    }

    .status--archived {
      background: rgba(115, 115, 115, 0.15);
      color: var(--color-text-muted);
    }

    .status--inactive {
      background: var(--color-tertiary-surface);
      color: var(--color-status-caution);
    }

    .case-study-header h1 {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .case-study-subtitle {
      font-size: 1.25rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
      margin: 0;
    }

    .case-study-meta-line {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.45;
      color: var(--color-text-muted);
    }

    .case-study-meta-line + .case-study-meta-line {
      margin-top: 0.15rem;
    }

    .meta-part:not(:last-child)::after {
      content: " · ";
    }

    .case-study-classification {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-top: 0.85rem;
      min-width: 0;
      max-width: 100%;
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    .classification-type {
      min-width: 0;
      max-width: 100%;
      font-weight: 600;
      color: var(--color-text-secondary);
    }

    .classification-domains {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .domain-chip {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: var(--border-radius-pill);
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
    }

    .classification-method {
      flex-basis: 100%;
      font-size: 0.8125rem;
    }

    @media (min-width: 640px) {
      .classification-method {
        flex-basis: auto;
      }
    }

    .case-study-content {
      margin-bottom: 2.5rem;
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
      text-align: justify;
      hyphens: auto;
    }

    .case-study-content :global(h2),
    .case-study-content :global(h3),
    .case-study-contents,
    .case-study-content :global(ul),
    .case-study-content :global(ol),
    .case-study-content :global(figure),
    .case-study-content :global(table) {
      text-align: start;
    }

    .case-study-content :global(a) {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    .case-study-content :global(a):hover {
      text-decoration-thickness: 2px;
    }

    .case-study-contents {
      margin: 0 0 1.75rem;
      font-size: 0.9375rem;
    }

    .case-study-contents ol {
      margin: 0;
      padding-left: 1.25rem;
      list-style-position: outside;
    }

    .case-study-contents li {
      margin: 0.2rem 0;
    }

    /* Paragraphs under "Key decisions" only, until the next heading. */
    .case-study-content :global(h3#key-decisions) ~ :global(p) {
      border-left: 2px solid var(--color-border);
      padding-left: 0.875rem;
    }

    .case-study-content :global(h3#key-decisions) ~ :global(*:not(p)) ~ :global(p) {
      border-left: 0;
      padding-left: 0;
    }

    .case-study-content :global(h2) {
      font-size: 1.75rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 700;
      color: var(--color-text);
    }

    .case-study-content :global(h3) {
      font-size: 1.25rem;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-weight: 600;
      color: var(--color-text);
    }

    .case-study-content :global(p) {
      margin-bottom: 1rem;
    }

    .case-study-content :global(ul),
    .case-study-content :global(ol) {
      margin-bottom: 1rem;
      padding-left: 1.25rem;
    }

    .case-study-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.9375rem;
    }

    .case-study-content :global(th),
    .case-study-content :global(td) {
      border: 1px solid var(--color-border);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }

    @media (max-width: 800px) {
      .case-study-top {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .case-study {
        padding: 1.5rem 1rem 2.5rem;
      }

      .case-study-header h1 {
        font-size: 2rem;
      }
    }
  </style>
</BaseLayout>
