---
/**
 * Project detail page — Figma design language:
 * - Full-bleed Indigo Hero (#282b61) with title, subtitle, abstract, primary CTA,
 *   cover/logo, metadata panel (dates, role, institution, methodology), and highlights.
 * - Full-bleed Yellow Band (#f6eb0f) displaying the project's domains & tags.
 * - Prose case-study body + rounded Team card + Related Publications (rounded homepage paper blocks).
 *
 * Route: /projects/[slug]
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ProjectCollaborators from '../../components/ProjectCollaborators.astro';
import ProjectArtifactButtons from '../../components/ProjectArtifactButtons.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Sparkles from '@lucide/astro/icons/sparkles';
import { getCollection, getEntry, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';
import { projectCoverKind } from '../../utils/projectImage';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(project);

const {
  title,
  subtitle,
  year,
  role,
  institution,
  duration,
  abstract,
  highlights,
  collaborators,
  type: classificationType,
  domains,
  tags = [],
  methodologyClass,
  artifacts,
  relatedProjects,
  relatedPublications,
  status,
  coverImage,
} = project.data;

const metaDescription =
  abstract.replace(/\s+/g, ' ').trim().slice(0, 155) +
  (abstract.replace(/\s+/g, ' ').trim().length > 155 ? '…' : '');

const seoTitle = subtitle ? `${title} — ${subtitle}` : title;

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
  inactive: { label: 'Inactive', class: 'status--inactive' },
};
const statusInfo = statusConfig[status || 'completed'];
const showStatus = Boolean(status && status !== 'completed');

const TYPE_LABELS: Record<string, string> = {
  'research-project': 'Research Project',
  tool: 'Tool & Platform',
  collaboration: 'Collaboration',
  course: 'Course & Simulation',
};

const METHOD_LABELS: Record<string, string> = {
  qualitative: 'Qualitative',
  quantitative: 'Quantitative',
  mixed: 'Mixed Methods',
  systems: 'Systems & HCI',
  design: 'Design Research',
};

function humanLabel(value: string, labels: Record<string, string>): string {
  return labels[value] ?? value;
}

const typeLabel = humanLabel(classificationType, TYPE_LABELS);
const methodLabel = humanLabel(methodologyClass, METHOD_LABELS);

/** Duration once, without a status word the badge already shows. */
function dateLabel(value: string | undefined, projectYear: number): string {
  const stripped = (value ?? '')
    .replace(/\s*\((?:ongoing|inactive|archived|completed)\)/gi, '')
    .replace(/\s+/g, ' ')
    .trim();
  return stripped || String(projectYear);
}

const dates = dateLabel(duration, year);

const allText = [abstract, ...highlights, project.body || ''].join(' ');
const readingMinutes = calculateReadingTime(allText);
const readingTime = formatReadingTime(readingMinutes);
const showReadingTime = readingMinutes >= 8;

const primaryArtifact = artifacts[0];
const secondaryArtifacts = artifacts.slice(1);

const coverKind = projectCoverKind(coverImage);

const contents = headings.filter((heading) => heading.depth === 2);
const showContents = contents.length >= 3;

// Combine unique domains + tags for the yellow band
const combinedTags: string[] = [];
const seenTagLower = new Set<string>();
for (const raw of [...domains, ...tags]) {
  const clean = raw.trim();
  if (!clean) continue;
  const key = clean.toLowerCase();
  if (!seenTagLower.has(key)) {
    seenTagLower.add(key);
    combinedTags.push(clean);
  }
}
---

<BaseLayout>
  <SEO
    slot="head"
    title={seoTitle}
    description={metaDescription}
    type="article"
    image={`/og/projects/${slug}.png`}
  />

  <StructuredData
    type="Project"
    data={{
      title,
      description: abstract,
      year,
      keywords: combinedTags.join(', '),
    }}
  />

  <main class="project-page">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. PURPLE INDIGO HERO SECTION
         ════════════════════════════════════════════════════════════════════════ -->
    <header class="indigo-hero project-hero">
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="350"
        height="196"
        class="indigo-hero__corner indigo-hero__corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="368"
        height="219"
        class="indigo-hero__corner indigo-hero__corner--br"
        aria-hidden="true"
      />

      <div class="indigo-hero__inner">
        <nav class="indigo-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/projects">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <div class="project-hero__grid">
          <div class="project-hero__lead">
            <div class="project-hero__eyebrow-row">
              <p class="indigo-hero__eyebrow">{typeLabel} · {methodLabel}</p>
              {showStatus && (
                <span class:list={['project-hero__status', statusInfo.class]}>
                  {statusInfo.label}
                </span>
              )}
            </div>

            <h1 class="indigo-hero__title">{title}</h1>
            {subtitle && <p class="indigo-hero__subtitle">{subtitle}</p>}

            <p class="project-hero__abstract">{abstract}</p>

            {primaryArtifact && (
              <div class="project-hero__actions">
                <a
                  class="figma-yellow-btn"
                  href={primaryArtifact.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{primaryArtifact.label}</span>
                  <ArrowUpRight size={15} stroke-width={2.25} aria-hidden="true" />
                </a>
              </div>
            )}
          </div>

          <aside class="project-hero__meta-card" aria-label="Project metadata">
            {slug === 'defake-app' ? (
              <div class="project-hero__brand-lockup">
                <img
                  src="/images/figma/defake-icon.svg"
                  alt=""
                  width="42"
                  height="42"
                />
                <img
                  src="/images/figma/defake-logotype.svg"
                  alt=""
                  width="114"
                  height="44"
                />
              </div>
            ) : slug === 'dungeons-and-deepfakes' ? (
              <div class="project-hero__brand-lockup">
                <img
                  src="/images/figma/dnd-logo.svg"
                  alt=""
                  width="48"
                  height="38"
                />
              </div>
            ) : (
              coverImage &&
              coverKind && (
                <figure class:list={['project-hero__cover', `project-hero__cover--${coverKind}`]}>
                  <img
                    src={coverImage}
                    alt={coverKind === 'figure' ? title : ''}
                    loading="eager"
                    decoding="async"
                    onerror="this.closest('figure')?.remove()"
                  />
                </figure>
              )
            )}

            <dl class="project-hero__dl">
              <div class="project-hero__dl-item">
                <dt>Timeline</dt>
                <dd>
                  {dates}
                  {showReadingTime && <span class="project-hero__reading"> · {readingTime}</span>}
                </dd>
              </div>
              <div class="project-hero__dl-item">
                <dt>Role</dt>
                <dd>{role}</dd>
              </div>
              <div class="project-hero__dl-item">
                <dt>Institution</dt>
                <dd>{institution}</dd>
              </div>
              <div class="project-hero__dl-item">
                <dt>Methodology</dt>
                <dd>{typeLabel} · {methodLabel}</dd>
              </div>
            </dl>
          </aside>
        </div>

        {highlights.length > 0 && (
          <ul class="project-hero__highlights" aria-label="Key project highlights">
            {highlights.slice(0, 4).map((h) => (
              <li class="project-hero__highlight-pill">
                <Sparkles size={14} stroke-width={2.2} class="project-hero__highlight-icon" aria-hidden="true" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. YELLOW BAND WITH TAGS & DOMAINS
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="yellow-band" role="region" aria-label="Project domains and tags">
      <div class="yellow-band__inner">
        <div class="yellow-band__group">
          <span class="yellow-band__label">Tags:</span>
          {combinedTags.map((tag) => (
            <span class="yellow-band__pill yellow-band__pill--static">{tag}</span>
          ))}
        </div>

        <div class="yellow-band__group">
          {collaborators.length > 0 && (
            <a href="#team-heading" class="yellow-band__pill">Team ({collaborators.length})</a>
          )}
          {relatedPublications && relatedPublications.length > 0 && (
            <a href="#related-work" class="yellow-band__pill">
              Papers ({relatedPublications.length})
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. CASE STUDY BODY, TEAM, & RELATED WORK
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="case-study">
      <div class="case-study-body">
        {collaborators.length > 0 && (
          <ProjectCollaborators collaborators={collaborators} />
        )}

        <section class="case-study-content">
          {showContents && (
            <nav class="case-study-contents" aria-label="Contents">
              <p class="case-study-contents__title">On this page</p>
              <ol>
                {contents.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
          {Content && <Content />}
        </section>

        <ProjectArtifactButtons artifacts={secondaryArtifacts} />
      </div>

      <div class="case-study-related" id="related-work">
        <RelatedContent
          relatedProjects={relatedProjects}
          relatedPublications={relatedPublications}
        />
        <BackLink href="/projects" text="All projects" />
      </div>
    </div>
  </main>

  <ScrollToTop />

  <style>
    .project-page {
      width: 100%;
    }

    .project-hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.85fr);
      gap: 2rem 2.75rem;
      align-items: start;
    }

    .project-hero__lead {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .project-hero__eyebrow-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 0.45rem;
    }

    .project-hero__eyebrow-row .indigo-hero__eyebrow {
      margin: 0;
    }

    .project-hero__status {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .status--ongoing {
      background: rgba(118, 255, 138, 0.18);
      border: 1px solid rgba(118, 255, 138, 0.45);
      color: #8cff9e;
    }

    .status--archived {
      background: rgba(255, 255, 255, 0.12);
      color: #d6d8ff;
    }

    .status--inactive {
      background: rgba(246, 235, 15, 0.18);
      color: #f6eb0f;
    }

    .project-hero__abstract {
      margin: 1.15rem 0 0;
      font-size: 1.03125rem;
      line-height: 1.72;
      color: rgba(255, 255, 255, 0.92);
    }

    .project-hero__actions {
      margin-top: 1.35rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .project-hero__meta-card {
      padding: 1.35rem 1.45rem;
      border-radius: 16px;
      background: rgba(14, 16, 44, 0.56);
      border: 1px solid rgba(152, 157, 240, 0.28);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .project-hero__brand-lockup {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.94);
      align-self: flex-start;
    }

    .project-hero__cover {
      margin: 0;
    }

    .project-hero__cover img {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
      border-radius: 10px;
    }

    .project-hero__cover--logo {
      display: inline-block;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.94);
      align-self: flex-start;
    }

    .project-hero__cover--logo img {
      max-width: 11rem;
      max-height: 3.75rem;
      object-fit: contain;
    }

    .project-hero__cover--figure img {
      max-height: 11rem;
      object-fit: cover;
    }

    .project-hero__dl {
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 1rem;
    }

    .project-hero__dl-item {
      min-width: 0;
    }

    .project-hero__dl-item dt {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #a8adff;
      margin-bottom: 0.2rem;
    }

    .project-hero__dl-item dd {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.4;
      color: #ffffff;
    }

    .project-hero__reading {
      color: #c8cbff;
      font-weight: 500;
    }

    .project-hero__highlights {
      list-style: none;
      margin: 1.75rem 0 0;
      padding: 1.25rem 0 0;
      border-top: 1px solid rgba(152, 157, 240, 0.22);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.75rem;
    }

    .project-hero__highlight-pill {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      background: rgba(14, 16, 44, 0.45);
      border: 1px solid rgba(152, 157, 240, 0.24);
      font-size: 0.8125rem;
      line-height: 1.45;
      color: #e4e6ff;
    }

    .project-hero__highlight-icon {
      flex-shrink: 0;
      margin-top: 0.12rem;
      color: #f6eb0f;
    }

    /* Case study body */
    .case-study {
      max-width: 1120px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.5rem;
    }

    .case-study-body {
      max-width: var(--max-width-prose);
      margin: 0 auto;
    }

    .case-study-body :global(.project-collaborators) {
      margin-top: 0;
      margin-bottom: 2.25rem;
    }

    .case-study-related {
      max-width: 100%;
      margin-top: 2.5rem;
    }

    .case-study-content {
      margin-bottom: 2.5rem;
      font-size: 1.0625rem;
      line-height: 1.72;
      color: var(--color-text-secondary);
      text-align: justify;
      hyphens: auto;
    }

    .case-study-content :global(h2),
    .case-study-content :global(h3),
    .case-study-contents,
    .case-study-content :global(ul),
    .case-study-content :global(ol),
    .case-study-content :global(figure),
    .case-study-content :global(table) {
      text-align: start;
    }

    .case-study-content :global(a) {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    .case-study-content :global(a):hover {
      text-decoration-thickness: 2px;
    }

    .case-study-contents {
      margin: 0 0 2rem;
      padding: 1.1rem 1.35rem;
      border-radius: 16px;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      font-size: 0.9375rem;
    }

    .case-study-contents__title {
      margin: 0 0 0.5rem;
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
    }

    .case-study-contents ol {
      margin: 0;
      padding-left: 1.25rem;
      list-style-position: outside;
    }

    .case-study-contents li {
      margin: 0.25rem 0;
    }

    .case-study-content :global(h3#key-decisions) ~ :global(p) {
      border-left: 2px solid var(--color-border);
      padding-left: 0.875rem;
    }

    .case-study-content :global(h3#key-decisions) ~ :global(*:not(p)) ~ :global(p) {
      border-left: 0;
      padding-left: 0;
    }

    .case-study-content :global(h2) {
      font-family: var(--font-display);
      font-size: 1.75rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 700;
      color: var(--color-brand-heading, var(--color-text));
    }

    .case-study-content :global(h3) {
      font-family: var(--font-display);
      font-size: 1.25rem;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-weight: 600;
      color: var(--color-text);
    }

    .case-study-content :global(p) {
      margin-bottom: 1rem;
    }

    .case-study-content :global(ul),
    .case-study-content :global(ol) {
      margin-bottom: 1rem;
      padding-left: 1.25rem;
    }

    .case-study-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.9375rem;
    }

    .case-study-content :global(th),
    .case-study-content :global(td) {
      border: 1px solid var(--color-border);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }

    @media (max-width: 860px) {
      .project-hero__grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .case-study {
        padding: 1.75rem 1rem 2.75rem;
      }

      .project-hero__dl {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
