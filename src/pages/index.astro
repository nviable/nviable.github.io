---
/**
 * Home Page — researcher-focused: HCI, digital media forensics, DeFake / verification research.
 * Route: /
 * @page
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import PublicationRows from '../components/PublicationRows.astro';
import Flag from '@lucide/astro/icons/flag';
import Presentation from '@lucide/astro/icons/presentation';
import Users from '@lucide/astro/icons/users';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import File from '@lucide/astro/icons/file';
import { getCollection } from 'astro:content';
import { cvPdfPath, publishedName, siteConfig } from '../config';
import { truncateForPreview } from '../utils/preview';
import { projectCoverKind } from '../utils/projectImage';

const allProjects = await getCollection('projects');

/**
 * One project group on the homepage. DeFake first, then Dungeons & Deepfakes,
 * STOP&SCAN, and Varuna. Inactive work (We.DeFake) stays off this page.
 */
const homeProjectIds = [
  'defake-app',
  'dungeons-and-deepfakes',
  'stop-and-scan',
  'varuna',
] as const;

const homeProjects = homeProjectIds
  .map((id) => allProjects.find((project) => project.id === id))
  .filter((project): project is (typeof allProjects)[number] => Boolean(project));

/** Compact now-slice. Same Lucide icons as /journey, no year in the date. */
type NowTone = 'primary' | 'secondary';

const nowStatic = [
  {
    icon: Flag,
    tone: 'primary' as NowTone,
    date: 'Dec 6',
    datetime: '2025-12-06',
    text: 'Postdoctoral researcher at RIT’s ESL Global Cybersecurity Institute.',
  },
  {
    icon: Users,
    tone: 'primary' as NowTone,
    date: 'Mar 6',
    datetime: '2026-03-06',
    text: 'Leading the DeFake Project, and co-leading STOP&SCAN with the ITU AI for Good AMAS programme.',
  },
];

const nowDynamic = [
  {
    icon: Presentation,
    tone: 'secondary' as NowTone,
    date: 'Oct 20',
    datetime: '2026-10-20',
    text: 'Upcoming talk: STOP&SCAN at IPTC.',
  },
  {
    icon: Presentation,
    tone: 'secondary' as NowTone,
    date: 'Oct 28',
    datetime: '2026-10-28',
    text: 'Upcoming talk: STOP&SCAN at JPEG Trust.',
  },
];

/**
 * Homepage slice is selected work (CHI, CCS, journal, dissertation, book chapter),
 * not under-review papers or earlier ICDIM items.
 */
const allPublications = await getCollection('publications');
const recentPublications = allPublications
  .filter((pub) => {
    const venue = pub.data.venue.toLowerCase();
    const selectedVenue =
      venue.includes('chi') ||
      venue.includes('ccs') ||
      pub.data.kind === 'journal' ||
      pub.data.kind === 'dissertation';
    const underReview = pub.data.status === 'underReview' || pub.data.status === 'inSubmission';
    return selectedVenue && !underReview && !venue.includes('icdim');
  })
  .sort((a, b) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 4);
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${siteConfig.author.name} (${publishedName})`}
    description={`${siteConfig.author.name} (${publishedName}) works on usable systems for internet safety: digital media forensics, content verification, and media literacy.`}
    type="website"
    image="/og/home.png"
    noSuffix
  />

  <!-- Structured Data for Homepage -->
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="hero-name">{siteConfig.author.name}</h1>
          <p class="hero-published">Published as {publishedName}</p>
          <p class="hero-role">{siteConfig.author.title}</p>
          <p class="hero-lead">
            I work on usable systems for internet safety: digital media forensics, content verification, and media literacy. The tools are for journalists, analysts, and investigators; the public pieces, like STOP&amp;SCAN, are for anyone deciding what to trust online.
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn btn-primary">
              Selected work
              <ArrowRight class="arrow-icon" size={16} stroke-width={2} aria-hidden="true" />
            </a>
            <a href={cvPdfPath} class="btn btn-secondary">
              <File size={16} stroke-width={2} aria-hidden="true" />
              CV (PDF)
            </a>
            <a href="/contact" class="btn btn-tertiary">
              Contact
              <ArrowRight class="arrow-icon" size={16} stroke-width={2} aria-hidden="true" />
            </a>
          </div>
        </div>

        <figure class="hero-photo">
          <img
            src="/images/john.jpg"
            alt="John Sohrawardi"
            width="1204"
            height="1089"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="now-list" aria-labelledby="now-list-label">
      <div class="now-columns">
        <div class="now-col">
          <p id="now-list-label" class="now-list-label">Now</p>
          <ul class="now-entries">
            {nowStatic.map((item) => {
              const Icon = item.icon;
              return (
                <li>
                  <span class:list={['now-icon', item.tone === 'secondary' && 'now-icon--secondary']} aria-hidden="true">
                    <Icon size={15} stroke-width={2} />
                  </span>
                  <time datetime={item.datetime}>{item.date}</time>
                  <span>{item.text}</span>
                </li>
              );
            })}
          </ul>
        </div>
        <div class="now-col">
          <div class="now-col-header">
            <ForwardLink href="/journey" text="Journey" variant="muted" class="now-list-view-all" />
          </div>
          <ul class="now-entries">
            {nowDynamic.map((item) => {
              const Icon = item.icon;
              return (
                <li>
                  <span class:list={['now-icon', item.tone === 'secondary' && 'now-icon--secondary']} aria-hidden="true">
                    <Icon size={15} stroke-width={2} />
                  </span>
                  <time datetime={item.datetime}>{item.date}</time>
                  <span>{item.text}</span>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <section class="home-projects" id="projects" aria-labelledby="home-projects-heading">
      <div class="section-header">
        <h2 id="home-projects-heading">Projects</h2>
        <ForwardLink href="/projects" text="View all" variant="muted" />
      </div>
      <div class="home-projects-grid">
        {homeProjects.map((project) => (
          <a href={`/projects/${project.id}`} class="case-snapshot">
            {project.data.coverImage && projectCoverKind(project.data.coverImage) && (
              <img
                src={project.data.coverImage}
                alt=""
                class="project-thumb"
                loading="lazy"
                decoding="async"
                onerror="this.remove()"
              />
            )}
            <span class="case-label">Research · {project.data.role}</span>
            <span class="case-title-row">
              <span class="case-title">{project.data.title}</span>
              <ArrowRight class="case-arrow" size={16} stroke-width={2} aria-hidden="true" />
            </span>
            <span class="case-outcome">{truncateForPreview(project.data.abstract)}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="research-focus" aria-label="Focus and availability">
      <a href="/contact" class="research-focus-availability">
        <span class="availability-dot" aria-hidden="true"></span>
        Open to new roles &amp; collaborations
      </a>
      <p class="research-focus-body">
        I started and lead the <strong>DeFake Project</strong>: detection that shows evidence instead of hiding it behind a score, with about 18 researchers across four universities. <strong>Dungeons &amp; Deepfakes</strong> is the training side. With the ITU AMAS programme I co-lead <strong>STOP&amp;SCAN</strong>, a short public method for checking media.
      </p>
    </section>

    <!-- Recent publications -->
    <section class="recent-publications">
      <div class="section-header">
        <h2>Selected publications</h2>
        <ForwardLink href="/publications" text="View all" variant="muted" />
      </div>

      {recentPublications.length > 0 ? (
        <PublicationRows
          entries={recentPublications.map((pub) => pub.data)}
          fallbackHref="/publications"
        />
      ) : (
        <p class="no-publications">No publications listed yet.</p>
      )}
    </section>

    <section class="cta">
      <h2>Open to new roles and collaborations</h2>
      <p>
        Academic and industry. Email <a href={`mailto:${siteConfig.author.email}`}>{siteConfig.author.email}</a>, or use the contact form.
      </p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary">
          Contact
          <ArrowRight class="arrow-icon" size={16} stroke-width={2} aria-hidden="true" />
        </a>
        <a href={cvPdfPath} class="btn btn-secondary">
          <File size={16} stroke-width={2} aria-hidden="true" />
          CV (PDF)
        </a>
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 3.5rem 0 0;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
      column-gap: 3rem;
      align-items: stretch;
    }

    .hero-name {
      font-size: 2.25rem;
      line-height: 1.2;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin: 0 0 0.35rem;
      color: var(--color-text);
    }

    .hero-published {
      margin: 0 0 0.85rem;
      font-size: 0.9375rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
    }

    .hero-role {
      font-size: 1.0625rem;
      line-height: 1.45;
      color: var(--color-text);
      margin: 0 0 1.25rem;
    }

    .hero-photo {
      margin: 0;
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-bg-secondary);
      min-height: 0;
    }

    .hero-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }

    .hero-lead {
      font-size: 1.125rem;
      color: var(--color-text);
      margin: 0 0 1.75rem;
      line-height: 1.6;
      max-width: 40rem;
    }

    .research-focus {
      margin-bottom: 3.5rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .research-focus-availability {
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0 0 1.25rem;
      padding: 0.35rem 0.75rem;
      border-radius: var(--border-radius-pill);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-text);
      background: var(--color-control-fill);
      border: 1px solid var(--color-border);
      text-decoration: none;
      transition: background var(--transition-base), border-color var(--transition-base);
    }

    .research-focus-availability:hover {
      background: var(--color-card-hover);
      border-color: var(--color-border);
      color: var(--color-text);
    }

    .availability-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-status-ongoing);
      flex-shrink: 0;
    }

    .research-focus-body {
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--color-text-secondary);
      margin: 0;
      max-width: 46rem;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .case-snapshot {
      --card-pad-y: 1.25rem;
      --card-lip: 3px;
      display: block;
      padding: var(--card-pad-y) 1.5rem;
      background: var(--color-card);
      border: none;
      border-bottom: var(--card-lip) solid var(--color-card-edge);
      color: inherit;
      text-decoration: none;
      transition:
        background-color var(--transition-base),
        transform var(--transition-fast);
    }

    .case-snapshot:hover {
      background: var(--color-card-hover);
      color: inherit;
    }

    .case-snapshot:active {
      border-bottom-width: 0;
      padding-bottom: calc(var(--card-pad-y) + var(--card-lip));
      transform: translateY(var(--card-lip));
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      line-height: 1.4;
      transition: color var(--transition-base);
    }

    .case-arrow {
      flex-shrink: 0;
      margin-top: 0.15rem;
      color: var(--color-accent);
      transition:
        color var(--transition-base),
        transform var(--arrow-duration) ease;
    }

    .case-snapshot:hover .case-title,
    .case-snapshot:hover .case-arrow {
      color: var(--color-accent-hover);
    }

    .case-snapshot:hover .case-arrow {
      transform: translateX(var(--arrow-shift));
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .home-projects {
      margin: 3rem 0 3.5rem;
    }

    .home-projects-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      align-items: stretch;
    }

    .home-projects-grid .case-snapshot {
      height: 100%;
    }

    .now-list {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .now-columns {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.35rem;
    }

    .now-list-label,
    .now-col-header {
      display: flex;
      align-items: center;
      min-height: 1.25rem;
      margin: 0 0 0.85rem;
    }

    .now-list-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
    }

    .now-col-header :global(.now-list-view-all) {
      font-size: 0.75rem;
    }

    .now-entries {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (min-width: 769px) {
      .now-columns {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        column-gap: 2.75rem;
        align-items: start;
      }
    }

    .now-entries li {
      display: grid;
      grid-template-columns: 1rem 3.4rem minmax(0, 1fr);
      gap: 0.55rem;
      align-items: start;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--color-text);
      margin: 0;
    }

    .now-icon {
      display: flex;
      color: var(--color-accent);
      margin-top: 0.1rem;
    }

    .now-icon--secondary {
      color: var(--color-text-muted);
    }

    .now-entries time {
      font-size: 0.8125rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--color-text-secondary);
      letter-spacing: 0.01em;
    }

    .introduction {
      max-width: 600px;
      margin-bottom: 5rem;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-child {
      color: var(--color-text);
    }

    .recent-publications {
      margin-bottom: 3.5rem;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 1.25rem;
    }

    .section-header h2 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .no-publications {
      color: var(--color-text-muted);
      font-style: italic;
      padding: 1.5rem 0;
    }

    .thinking {
      margin-bottom: 5rem;
    }

    .thinking h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
    }

    .thinking-list {
      font-size: 1.0625rem;
      line-height: 1.9;
      color: var(--color-text-secondary);
      max-width: 680px;
    }

    .cta {
      padding: 3rem 0;
      border-top: 1px solid var(--color-border);
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 500px;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.25rem 0 0;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        row-gap: 1.5rem;
        align-items: start;
      }

      .hero-photo {
        max-width: min(260px, 72vw);
        justify-self: start;
        height: auto;
      }

      .hero-photo img {
        height: auto;
        aspect-ratio: 1204 / 1089;
        object-fit: cover;
      }

      .home-projects-grid {
        grid-template-columns: 1fr;
      }

      .hero-name {
        font-size: 1.75rem;
      }

      .hero-cta {
        flex-wrap: wrap;
      }

      .case-snapshot {
        --card-pad-y: 1rem;
        padding: var(--card-pad-y) 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .decision-title {
        font-size: 1rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn {
        width: 100%;
      }

      .research-focus-availability {
        margin-bottom: 0.75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .case-snapshot:active,
      .case-arrow {
        transition: none;
      }
    }
  </style>
</BaseLayout>
