---
/**
 * Home Page — Figma concept implementation adapted to Astro with Dark/Light mode support:
 * 1. Full-bleed Indigo Hero with 3-photo Real/Fake deepfake cycling teaser + physics floating word cloud
 * 2. Fixed-height caption bar + Ctrl+K style Topic Explorer modal with grouped Projects (→), Papers (↗), & Media (↗/→)
 * 3. Static "Latest" yellow ribbon below hero (4 recent updates + "view all latest →")
 * 4. Split-column Selected Publications section with green paper/bibtex pills & optional thumbnails
 * 5. Split-column Project Portfolio bento grid (DeFake Project featured + Varuna, Dungeons & Deepfakes, STOP&SCAN)
 * 6. Media & Press Articles 3-card thumbnail grid with category badges
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SquareArrowOutUpRight from '@lucide/astro/icons/square-arrow-out-up-right';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import BookOpenText from '@lucide/astro/icons/book-open-text';
import Newspaper from '@lucide/astro/icons/newspaper';
import FolderGit2 from '@lucide/astro/icons/folder-git-2';
import Search from '@lucide/astro/icons/search';
import X from '@lucide/astro/icons/x';
import FileText from '@lucide/astro/icons/file-text';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import ScanFace from '@lucide/astro/icons/scan-face';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import heroPortrait from '../assets/john.jpg';
import heroFake1 from '../assets/john-fake-1.png';
import heroFake2 from '../assets/john-fake-2.png';
import { cvPdfPath, publishedName, siteConfig } from '../config';
import { DEFAULT_MEDIA_THUMBNAIL, resolveArticleThumbnail } from '../lib/article-thumbnails';

// ─── 1. HERO WORD CLOUD TOPICS (SINGLE SOURCE OF TRUTH) ────────────────────────
const wordCloudTopics = [
  {
    id: 'deepfake',
    label: 'Deepfake Detection',
    size: 'lg',
    blurb: 'Multi-signal explainable interfaces that surface forensic evidence instead of a single black-box score.',
  },
  {
    id: 'training',
    label: 'Immersive Training',
    size: 'lg',
    blurb: 'Scenario-based tabletop and LLM-driven simulations (Dungeons & Deepfakes) for newsroom verification.',
  },
  {
    id: 'hci',
    label: 'User Research',
    size: 'md',
    blurb: 'Mixed-methods studies with journalists, intelligence analysts, and law enforcement across global contexts.',
  },
  {
    id: 'forensics',
    label: 'Digital Forensics',
    size: 'lg',
    blurb: 'Ontology-driven workflows (Varuna) uniting visual, audio, provenance, and biometric verification.',
  },
  {
    id: 'ethics',
    label: 'AI Ethics',
    size: 'md',
    blurb: 'Calibrating human trust, mitigating automation bias, and countering synthetic media harms.',
  },
  {
    id: 'security',
    label: 'Cybersecurity',
    size: 'md',
    blurb: 'Usable security and resilient open-world detection against evolving adversarial manipulation.',
  },
  {
    id: 'design',
    label: 'Product Design',
    size: 'md',
    blurb: 'Translating complex ML models into human-centered investigative products from Figma to production.',
  },
  {
    id: 'branding',
    label: 'Branding',
    size: 'sm',
    blurb: 'Visual identity systems & mascot-guided public literacy frameworks like STOP&SCAN.',
  },
] as const;

type TopicId = (typeof wordCloudTopics)[number]['id'];

/**
 * Maps explicit tags/domains/topics and text cues to the 8 canonical word-cloud topic IDs.
 */
function resolveCloudTopics(rawTags: string[] = [], textContext = ''): TopicId[] {
  const combined = `${rawTags.join(' ')} ${textContext}`.toLowerCase();
  const matched = new Set<TopicId>();

  if (
    combined.includes('deepfake') ||
    combined.includes('spoof') ||
    combined.includes('synthetic-media') ||
    combined.includes('defake')
  ) {
    matched.add('deepfake');
  }
  if (
    combined.includes('immersive training') ||
    combined.includes('role-play') ||
    combined.includes('dungeons') ||
    combined.includes('simulation') ||
    combined.includes('training') ||
    combined.includes('education') ||
    combined.includes('literacy')
  ) {
    matched.add('training');
  }
  if (
    combined.includes('user research') ||
    combined.includes('hci') ||
    combined.includes('human') ||
    combined.includes('journalis') ||
    combined.includes('analyst') ||
    combined.includes('mixed-methods') ||
    combined.includes('mixed methods') ||
    combined.includes('usability')
  ) {
    matched.add('hci');
  }
  if (
    combined.includes('digital forensics') ||
    combined.includes('forensic') ||
    combined.includes('varuna') ||
    combined.includes('ontology') ||
    combined.includes('optical flow') ||
    combined.includes('audio') ||
    combined.includes('video') ||
    combined.includes('jpeg trust') ||
    combined.includes('iptc')
  ) {
    matched.add('forensics');
  }
  if (
    combined.includes('ai ethics') ||
    combined.includes('ai-ethics') ||
    combined.includes('ethic') ||
    combined.includes('clickbait') ||
    combined.includes('election') ||
    combined.includes('policy') ||
    combined.includes('trust') ||
    combined.includes('misinformation') ||
    combined.includes('ai-generated-papers')
  ) {
    matched.add('ethics');
  }
  if (
    combined.includes('cybersecurity') ||
    combined.includes('security') ||
    combined.includes('ccs') ||
    combined.includes('soups') ||
    combined.includes('law-enforcement') ||
    combined.includes('police') ||
    combined.includes('threat')
  ) {
    matched.add('security');
  }
  if (
    combined.includes('product design') ||
    combined.includes('user-centered design') ||
    combined.includes('explainable') ||
    combined.includes('interface') ||
    combined.includes('ux') ||
    combined.includes('tool')
  ) {
    matched.add('design');
  }
  if (
    combined.includes('branding') ||
    combined.includes('stop&scan') ||
    combined.includes('stop-and-scan') ||
    combined.includes('mascot') ||
    combined.includes('amito')
  ) {
    matched.add('branding');
  }

  return Array.from(matched);
}

// ─── 2. PROJECTS DATA ──────────────────────────────────────────────────────────
const allProjects = await getCollection('projects');

const defakeProject = allProjects.find((p) => p.id === 'defake-app');
const secondaryProjectIds = ['dungeons-and-deepfakes', 'stop-and-scan'] as const;
const secondaryProjects = secondaryProjectIds
  .map((id) => allProjects.find((p) => p.id === id))
  .filter((p): p is (typeof allProjects)[number] => Boolean(p));

const projectMetaCounts: Record<
  string,
  {
    displayName: string;
    shortSummary: string;
    pubs: number;
    media: number;
    topics: TopicId[];
  }
> = {
  'defake-app': {
    displayName: 'DeFake Project',
    shortSummary:
      'DeFake is an interdisciplinary research initiative aimed at developing deepfake detection solutions for journalists, forensic experts, and law enforcement agencies by focusing on usability, explainability, and robustness.',
    pubs: 7,
    media: 6,
    topics: ['deepfake', 'forensics', 'hci', 'security', 'design', 'branding'],
  },
  varuna: {
    displayName: 'Varuna Project',
    shortSummary:
      'Varuna is a digital media forensics ontology-driven platform to organize and interact with the vast ecosystem of tools, evidence types, and analyst reasoning.',
    pubs: 2,
    media: 3,
    topics: ['forensics', 'hci', 'security', 'design', 'deepfake'],
  },
  'dungeons-and-deepfakes': {
    displayName: 'Dungeons & Deepfakes',
    shortSummary:
      'A novel scenario-based role-playing training simulation to engage journalists and media professionals in learning and improving media verification skills.',
    pubs: 3,
    media: 4,
    topics: ['training', 'deepfake', 'hci', 'ethics', 'design', 'branding'],
  },
  'stop-and-scan': {
    displayName: 'STOP&SCAN',
    shortSummary:
      'A five-step public trust-calibration framework and mascot-guided educational toolkit built with the ITU AI for Good AMAS programme.',
    pubs: 1,
    media: 3,
    topics: ['ethics', 'design', 'branding', 'training', 'forensics'],
  },
};

// All projects for the Ctrl+K Topic Explorer modal
const modalProjects = [...allProjects]
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((proj) => {
    const custom = projectMetaCounts[proj.id];
    const topics =
      custom?.topics ??
      resolveCloudTopics(
        [...(proj.data.tags ?? []), ...(proj.data.domains ?? [])],
        `${proj.data.title} ${proj.data.subtitle ?? ''} ${proj.data.abstract}`
      );
    return {
      id: proj.id,
      title: custom?.displayName ?? proj.data.title,
      subtitle: proj.data.subtitle ?? proj.data.type,
      year: proj.data.year,
      role: proj.data.role,
      href: `/projects/${proj.id}`,
      topics,
    };
  });

// ─── 3. LATEST RIBBON DATA (MERGED JOURNEY + SPEAKING) ─────────────────────────
const allJourney = await getCollection('journey');
const allSpeaking = await getCollection('speaking');

const mergedUpdates = [
  ...allJourney.map((entry) => ({
    id: `journey-${entry.id}`,
    date: entry.data.date,
    title: entry.data.title,
    type: entry.data.type,
    href: `/journey#journey-${entry.id}`,
  })),
  ...allSpeaking.map((entry) => ({
    id: `speaking-${entry.id}`,
    date: entry.data.date,
    title: entry.data.title.replace(/^Upcoming:\s*/i, '').trim(),
    type: entry.data.type,
    href: `/journey#speaking-${entry.id}`,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4);

function formatIsoShort(date: Date): string {
  const y = date.getUTCFullYear();
  const m = date.getUTCMonth() + 1;
  const d = date.getUTCDate();
  return `${y}-${m}-${d}`;
}

// ─── 4. PUBLICATIONS DATA ──────────────────────────────────────────────────────
const allPublications = await getCollection('publications');
const isUnpublished = (status: string | undefined) =>
  status === 'underReview' || status === 'inSubmission' || status === 'inPreparation';
const publishedPapers = allPublications.filter((p) => !isUnpublished(p.data.status));

const selectedPublications = publishedPapers
  .filter((pub) => {
    const venue = pub.data.venue.toLowerCase();
    const selectedVenue =
      venue.includes('chi') ||
      venue.includes('ccs') ||
      pub.data.kind === 'journal' ||
      pub.data.kind === 'dissertation' ||
      pub.data.kind === 'bookChapter';
    return selectedVenue && !venue.includes('icdim');
  })
  .sort((a, b) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 4);

const modalPublications = [...publishedPapers]
  .sort((a, b) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .map((pub) => {
    const topics = resolveCloudTopics(
      pub.data.tags ?? [],
      `${pub.data.title} ${pub.data.venue} ${pub.data.abstract ?? ''}`
    );
    return {
      id: pub.id,
      title: pub.data.title,
      venue: pub.data.venue,
      year: pub.data.year,
      authors: pub.data.authors,
      href: pub.data.url || '/publications',
      external: Boolean(pub.data.url),
      topics,
    };
  });

// ─── 5. MEDIA ARTICLES & TALKS DATA ────────────────────────────────────────────
const mediaDateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

function inferMediaBadge(title: string, event: string, customBadge?: string): string {
  if (customBadge) return customBadge;
  const lower = `${title} ${event}`.toLowerCase();
  if (lower.includes('explainer') || lower.includes('what are')) return 'explainer';
  if (lower.includes('guide') || lower.includes('tow center')) return 'field guide';
  if (lower.includes('interview')) return 'interview';
  if (lower.includes('real or fake') || lower.includes('policy')) return 'fact check';
  return 'press feature';
}

const mediaArticles = await Promise.all(
  allSpeaking
    .filter((entry) => entry.data.type === 'media')
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 3)
    .map(async (entry) => ({
      id: entry.id,
      title: entry.data.title,
      outlet: entry.data.event.replace(/\s*\(.*?\)\s*/g, '').trim(),
      dateLabel: mediaDateFormatter.format(entry.data.date),
      datetime: entry.data.date.toISOString().slice(0, 10),
      href: entry.data.url || `/journey#speaking-${entry.id}`,
      external: Boolean(entry.data.url),
      thumbnail: await resolveArticleThumbnail({
        slug: entry.id,
        url: entry.data.url,
        explicitThumbnail: entry.data.thumbnail,
      }),
      badge: inferMediaBadge(entry.data.title, entry.data.event, entry.data.badge),
    }))
);

const modalMediaAndTalks = [...allSpeaking]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => {
    const topics = resolveCloudTopics(
      entry.data.topics ?? [],
      `${entry.data.title} ${entry.data.event} ${entry.data.description}`
    );
    const external = Boolean(entry.data.url);
    return {
      id: entry.id,
      title: entry.data.title.replace(/^Upcoming:\s*/i, '').trim(),
      outlet: entry.data.event,
      year: entry.data.date.getUTCFullYear(),
      kindLabel: entry.data.type === 'media' ? 'Press / Media' : 'Invited Talk',
      href: entry.data.url || `/journey#speaking-${entry.id}`,
      external,
      topics,
    };
  });
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${siteConfig.author.name} (${publishedName})`}
    description={`${siteConfig.author.name} (${publishedName}) works on usable systems for internet safety: digital media forensics, content verification, and media literacy.`}
    type="website"
    image="/og/home.png"
    noSuffix
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-main">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. HERO SECTION (Indigo full-bleed + 3-photo Real/Fake carousel + Word Cloud)
         ════════════════════════════════════════════════════════════════════════ -->
    <section class="hero-banner" aria-label="Introduction and research overview">
      <!-- Decorative Figma corner geometry -->
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="314"
        height="194"
        class="hero-corner hero-corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="314"
        height="194"
        class="hero-corner hero-corner--br"
        aria-hidden="true"
      />

      <div class="hero-container">
        <!-- Top row: 3-photo deepfake teaser + Intro copy -->
        <div class="hero-top-grid">
          <div
            class="deepfake-teaser"
            data-deepfake-carousel
            aria-label="Interactive deepfake detection photo teaser: cycles between real photo in green and AI-manipulated photos in red"
          >
            <div class="deepfake-stage">
              <!-- Card 0: Fake 1 (Mustache / Pedro Pascal lookalike) -->
              <button
                type="button"
                class="df-card df-card--fake"
                data-df-card="0"
                data-df-slot="left"
                data-df-kind="fake"
                aria-label="Inspect AI-manipulated portrait 1 (Face Swap)"
              >
                <div class="df-card__frame">
                  <Image
                    src={heroFake1}
                    alt="Synthetic face-swapped variation of John Sohrawardi"
                    widths={[280, 560]}
                    sizes="(max-width: 768px) 220px, 281px"
                    format="webp"
                    quality={85}
                    loading="eager"
                    class="df-card__img"
                  />
                  <div class="df-face-box df-face-box--1" aria-hidden="true">
                    <span class="df-corner df-corner--tl"></span>
                    <span class="df-corner df-corner--tr"></span>
                    <span class="df-corner df-corner--bl"></span>
                    <span class="df-corner df-corner--br"></span>
                    <span class="df-face-tag">
                      <ScanFace size={11} stroke-width={2.5} />
                      FAKE · FACE SWAP
                    </span>
                  </div>
                </div>
              </button>

              <!-- Card 1: Real Photo (Green) -->
              <button
                type="button"
                class="df-card df-card--real"
                data-df-card="1"
                data-df-slot="center"
                data-df-kind="real"
                aria-label="Inspect authentic portrait of John Sohrawardi"
              >
                <div class="df-card__frame">
                  <Image
                    src={heroPortrait}
                    alt="John Sohrawardi (Authentic photo)"
                    widths={[320, 640]}
                    sizes="(max-width: 768px) 240px, 281px"
                    format="webp"
                    quality={88}
                    loading="eager"
                    fetchpriority="high"
                    class="df-card__img"
                  />
                  <div class="df-real-badge" aria-hidden="true">
                    <ShieldCheck size={12} stroke-width={2.5} />
                    <span>REAL · AUTHENTIC</span>
                  </div>
                </div>
              </button>

              <!-- Card 2: Fake 2 (Long-haired AI variation) -->
              <button
                type="button"
                class="df-card df-card--fake"
                data-df-card="2"
                data-df-slot="right"
                data-df-kind="fake"
                aria-label="Inspect AI-generated portrait 2 (Synthetic Restyle)"
              >
                <div class="df-card__frame">
                  <Image
                    src={heroFake2}
                    alt="AI-generated long-haired variation of John Sohrawardi"
                    widths={[280, 560]}
                    sizes="(max-width: 768px) 220px, 281px"
                    format="webp"
                    quality={85}
                    loading="eager"
                    class="df-card__img"
                  />
                  <div class="df-face-box df-face-box--2" aria-hidden="true">
                    <span class="df-corner df-corner--tl"></span>
                    <span class="df-corner df-corner--tr"></span>
                    <span class="df-corner df-corner--bl"></span>
                    <span class="df-corner df-corner--br"></span>
                    <span class="df-face-tag">
                      <ScanFace size={11} stroke-width={2.5} />
                      FAKE · AI GENERATED
                    </span>
                  </div>
                </div>
              </button>
            </div>

            <!-- Status / cycle indicator bar -->
            <div class="df-controls" aria-hidden="true">
              <span class="df-status-pill" data-df-status-pill data-kind="real">
                <span class="df-status-dot"></span>
                <span data-df-status-text>Verified Real Portrait · Authentic</span>
              </span>
              <div class="df-dots">
                <span class="df-dot" data-df-dot="0"></span>
                <span class="df-dot is-active" data-df-dot="1"></span>
                <span class="df-dot" data-df-dot="2"></span>
              </div>
            </div>
          </div>

          <div class="hero-bio">
            <div class="hero-identity">
              <p class="hero-greeting">Hi, I’m</p>
              <h1 class="hero-name">{siteConfig.author.name}</h1>
              <p class="hero-published">I publish as: {publishedName}</p>
            </div>

            <p class="hero-description">
              I’m a <strong>Researcher</strong> and <strong>Technologist</strong> empowering journalists,
              intelligence analysts, and law enforcement with user-centered tools for detecting and
              interpreting digital manipulated content. With 5+ years of industry and 7+ years of
              academic research experience I transform cutting-edge research into real-world solutions
              that the users can comprehend.
            </p>

            <div class="hero-links">
              <a href="/experience" class="hero-more-link">
                more about me <span aria-hidden="true">→</span>
              </a>
              <a href={cvPdfPath} class="hero-cv-pill">
                <FileText size={14} stroke-width={2} aria-hidden="true" />
                CV (PDF)
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom row: Tagline + Interactive Physics Word Cloud -->
        <div class="hero-bottom-grid">
          <p class="hero-tagline">
            Keeping it <span class="hero-tagline__real">Real</span> in the world where anything can be AI Generated
          </p>

          <div class="hero-cloud-wrap">
            <div
              class="hero-wordcloud"
              data-word-cloud
              role="group"
              aria-label="Interactive research topics cloud — hover to preview or click to open topic index"
            >
              {wordCloudTopics.map((topic, idx) => (
                <button
                  type="button"
                  class:list={['cloud-node', `cloud-node--${topic.size}`]}
                  data-cloud-node
                  data-topic-id={topic.id}
                  data-topic-label={topic.label}
                  data-topic-blurb={topic.blurb}
                  data-seed={idx}
                  aria-haspopup="dialog"
                >
                  {topic.label}
                </button>
              ))}
            </div>
            <!-- Fixed-height caption box so hovering never shifts layout -->
            <div class="hero-cloud-caption" data-cloud-caption aria-live="polite">
              <span class="cloud-caption-text" data-cloud-caption-text>
                Hover a topic to preview or click any keyword to browse matching projects, papers &amp; press.
              </span>
              <button
                type="button"
                class="cloud-cmdk-trigger"
                data-open-cmdk
                aria-label="Open topic explorer (Ctrl+K)"
              >
                <Search size={12} stroke-width={2.5} aria-hidden="true" />
                <span>Ctrl K</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. "LATEST" RIBBON (Static, high-contrast bar replacing marquee)
         ════════════════════════════════════════════════════════════════════════ -->
    <section class="latest-ribbon" aria-label="Latest updates and appearances">
      <div class="latest-ribbon__inner">
        <div class="latest-ribbon__items">
          <span class="latest-ribbon__badge">LATEST</span>
          {mergedUpdates.map((item) => (
            <a href={item.href} class="latest-item">
              <time datetime={item.date.toISOString().slice(0, 10)} class="latest-item__date">
                {formatIsoShort(item.date)}
              </time>
              <span class="latest-item__title">{item.title}</span>
            </a>
          ))}
        </div>

        <a href="/journey" class="latest-ribbon__cta">
          view all latest <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. SELECTED PUBLICATIONS (Split layout + Figma paper blocks)
         ════════════════════════════════════════════════════════════════════════ -->
    <section class="home-section home-publications" id="publications" aria-labelledby="home-pubs-heading">
      <div class="section-split">
        <div class="section-intro-col">
          <h2 id="home-pubs-heading" class="section-brand-title">Publications</h2>
          <p class="section-brand-copy">
            I publish at top tier venues in the fields of HCI, AI, Cybersecurity and Psychology with{' '}
            <strong>{publishedPapers.length}</strong> papers in total having been cited{' '}
            <strong>414</strong> times.
          </p>
          <a href="/publications" class="figma-yellow-btn">
            <span>View All</span>
            <ArrowRight size={17} stroke-width={2.25} aria-hidden="true" />
          </a>
        </div>

        <div class="pub-cards-grid">
          {selectedPublications.map((pub) => {
            const bibtex = pub.data.bibtex?.trim() ?? '';
            return (
              <article class="pub-block">
                {pub.data.thumbnail && (
                  <div class="pub-block__thumb">
                    <img
                      src={pub.data.thumbnail}
                      alt=""
                      width="320"
                      height="140"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                <h3 class="pub-block__title">
                  {pub.data.url ? (
