<script>
  // ─── 1. HERO DEEPFAKE 3-PHOTO CYCLING CAROUSEL ───────────────────────────────
  function initDeepfakeCarousel() {
    const root = document.querySelector<HTMLElement>('[data-deepfake-carousel]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-df-card]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-df-dot]'));
    const statusPill = root.querySelector<HTMLElement>('[data-df-status-pill]');
    const statusText = root.querySelector<HTMLElement>('[data-df-status-text]');
    if (cards.length !== 3) return;

    const statusDescriptions: Record<number, { text: string; kind: 'real' | 'fake' }> = {
      0: { text: 'Deepfake Detected · Face Swap Anomaly', kind: 'fake' },
      1: { text: 'Verified Real Portrait · Authentic', kind: 'real' },
      2: { text: 'Deepfake Detected · Synthetic Generation', kind: 'fake' },
    };

    let centerIndex = 1;
    let paused = false;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function applyPositions(activeIdx: number) {
      centerIndex = ((activeIdx % 3) + 3) % 3;
      const leftIdx = (centerIndex + 2) % 3;
      const rightIdx = (centerIndex + 1) % 3;

      cards.forEach((card, idx) => {
        let slot = 'center';
        if (idx === leftIdx) slot = 'left';
        else if (idx === rightIdx) slot = 'right';
        card.setAttribute('data-df-slot', slot);
        card.setAttribute('aria-current', slot === 'center' ? 'true' : 'false');
      });

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === centerIndex);
      });

      const info = statusDescriptions[centerIndex];
      if (statusPill && statusText && info) {
        statusPill.setAttribute('data-kind', info.kind);
        statusText.textContent = info.text;
      }
    }

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        applyPositions(idx);
      });
    });

    root.addEventListener('mouseenter', () => {
      paused = true;
    });
    root.addEventListener('mouseleave', () => {
      paused = false;
    });
    root.addEventListener('focusin', () => {
      paused = true;
    });
    root.addEventListener('focusout', () => {
      paused = false;
    });

    if (!reducedMotion) {
      const intervalId = window.setInterval(() => {
        if (!document.body.contains(root)) {
          window.clearInterval(intervalId);
          return;
        }
        if (!paused) {
          applyPositions(centerIndex + 1);
        }
      }, 3600);
    }
  }

  // ─── 2. PHYSICS WORD CLOUD + CTRL+K TOPIC EXPLORER MODAL ─────────────────────
  function initWordCloudAndModal() {
    const cloud = document.querySelector<HTMLElement>('[data-word-cloud]');
    const modal = document.querySelector<HTMLElement>('[data-cmdk-modal]');
    if (!cloud || !modal || cloud.dataset.bound === '1') return;
    cloud.dataset.bound = '1';

    const nodes = Array.from(cloud.querySelectorAll<HTMLButtonElement>('[data-cloud-node]'));
    const captionText = document.querySelector<HTMLElement>('[data-cloud-caption-text]');
    const openCmdkBtn = document.querySelector<HTMLButtonElement>('[data-open-cmdk]');

    const searchInput = modal.querySelector<HTMLInputElement>('[data-cmdk-input]');
    const closeBtn = modal.querySelector<HTMLButtonElement>('[data-cmdk-close]');
    const topicsBar = modal.querySelector<HTMLElement>('[data-cmdk-topics-bar]');
    const topicPills = Array.from(modal.querySelectorAll<HTMLButtonElement>('[data-cmdk-topic]'));
    const blurbEl = modal.querySelector<HTMLElement>('[data-cmdk-blurb]');
    const groups = Array.from(modal.querySelectorAll<HTMLElement>('[data-cmdk-group]'));
    const allItems = Array.from(modal.querySelectorAll<HTMLAnchorElement>('[data-cmdk-item]'));
    const emptyEl = modal.querySelector<HTMLElement>('[data-cmdk-empty]');

    const defaultCaption =
      'Hover a topic to preview or click any keyword to browse matching projects, papers & press.';
    let hoveredNode: HTMLButtonElement | null = null;
    let pointerX = -9999;
    let pointerY = -9999;

    let currentTopic = 'all';
    let activeItemIndex = -1;
    let lastFocusedElement: HTMLElement | null = null;

    function getVisibleItems(): HTMLAnchorElement[] {
      return allItems.filter((item) => !item.hidden);
    }

    function updateKeyboardHighlight(newIndex: number) {
      const visible = getVisibleItems();
      allItems.forEach((item) => item.classList.remove('is-kbd-active'));
      if (visible.length === 0) {
        activeItemIndex = -1;
        return;
      }
      activeItemIndex = ((newIndex % visible.length) + visible.length) % visible.length;
      const target = visible[activeItemIndex];
      if (target) {
        target.classList.add('is-kbd-active');
        target.scrollIntoView({ block: 'nearest' });
      }
    }

    function filterModalResults() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let totalVisible = 0;

      groups.forEach((group) => {
        const groupItems = Array.from(group.querySelectorAll<HTMLAnchorElement>('[data-cmdk-item]'));
        let groupVisible = 0;

        groupItems.forEach((item) => {
          const itemTopics = (item.dataset.topics || '').split(',');
          const topicMatches = currentTopic === 'all' || itemTopics.includes(currentTopic);
          const searchStr = item.dataset.search || '';
          const queryMatches = !query || searchStr.includes(query);
          const show = topicMatches && queryMatches;
          item.hidden = !show;
          if (show) {
            groupVisible++;
            totalVisible++;
          }
        });

        group.hidden = groupVisible === 0;
      });

      if (emptyEl) {
        emptyEl.hidden = totalVisible > 0;
      }
      updateKeyboardHighlight(0);
    }

    function selectModalTopic(topicId: string) {
      currentTopic = topicId;
      let activePillEl: HTMLButtonElement | null = null;
      topicPills.forEach((pill) => {
        const isMatch = pill.dataset.cmdkTopic === topicId;
        pill.classList.toggle('is-active', isMatch);
        if (isMatch) {
          activePillEl = pill;
          if (blurbEl && pill.dataset.topicBlurb) {
            blurbEl.textContent = pill.dataset.topicBlurb;
          }
        }
      });
      filterModalResults();
      if (activePillEl && topicsBar) {
        window.requestAnimationFrame(() => {
          activePillEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
      }
    }

    function openModal(topicId = 'all') {
      lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (searchInput) searchInput.value = '';
      selectModalTopic(topicId);
      modal!.hidden = false;
      document.body.style.overflow = 'hidden';
      window.requestAnimationFrame(() => {
        searchInput?.focus();
      });
    }

    function closeModal() {
      if (modal!.hidden) return;
      modal!.hidden = true;
      document.body.style.removeProperty('overflow');
      if (lastFocusedElement) {
        lastFocusedElement.focus();
      }
    }

    // Word cloud hover + click -> open modal for that topic
    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => {
        hoveredNode = node;
        if (captionText && node.dataset.topicBlurb) {
          captionText.textContent = `${node.dataset.topicLabel}: ${node.dataset.topicBlurb}`;
        }
      });

      node.addEventListener('mouseleave', () => {
        if (hoveredNode === node) hoveredNode = null;
        if (captionText) {
          captionText.textContent = defaultCaption;
        }
      });

      node.addEventListener('focus', () => {
        if (captionText && node.dataset.topicBlurb) {
          captionText.textContent = `${node.dataset.topicLabel}: ${node.dataset.topicBlurb}`;
        }
      });

      node.addEventListener('blur', () => {
        if (captionText) {
          captionText.textContent = defaultCaption;
        }
      });

      node.addEventListener('click', () => {
        openModal(node.dataset.topicId || 'all');
      });
    });

    openCmdkBtn?.addEventListener('click', () => openModal('all'));
    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    let isDraggingTopics = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartScrollLeft = 0;

    if (topicsBar) {
      topicsBar.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        isDraggingTopics = true;
        dragMoved = false;
        dragStartX = e.clientX;
        dragStartScrollLeft = topicsBar.scrollLeft;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDraggingTopics) return;
        const dx = e.clientX - dragStartX;
        if (Math.abs(dx) > 4) {
          dragMoved = true;
          topicsBar.classList.add('is-dragging');
        }
        if (dragMoved) {
          e.preventDefault();
          topicsBar.scrollLeft = dragStartScrollLeft - dx;
        }
      });

      window.addEventListener('mouseup', () => {
        if (!isDraggingTopics) return;
        isDraggingTopics = false;
        topicsBar.classList.remove('is-dragging');
        window.setTimeout(() => {
          dragMoved = false;
        }, 0);
      });

      topicsBar.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            e.preventDefault();
            topicsBar.scrollLeft += e.deltaY;
          }
        },
        { passive: false }
      );
    }

    topicPills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        if (dragMoved) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        selectModalTopic(pill.dataset.cmdkTopic || 'all');
        searchInput?.focus();
      });
    });

    searchInput?.addEventListener('input', () => {
      filterModalResults();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.hidden) {
          openModal('all');
        } else {
          closeModal();
        }
        return;
      }

      if (modal.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateKeyboardHighlight(activeItemIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateKeyboardHighlight(activeItemIndex - 1);
      } else if (e.key === 'Enter' && document.activeElement === searchInput) {
        const visible = getVisibleItems();
        const activeItem = visible[activeItemIndex];
        if (activeItem) {
          e.preventDefault();
          activeItem.click();
          if (activeItem.target !== '_blank') {
            closeModal();
          }
        }
      }
    });

    // Floating physics animation for word cloud
    cloud.addEventListener('mousemove', (e) => {
      const rect = cloud.getBoundingClientRect();
      pointerX = e.clientX - rect.left;
      pointerY = e.clientY - rect.top;
    });

    cloud.addEventListener('mouseleave', () => {
      pointerX = -9999;
      pointerY = -9999;
    });

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      const states = nodes.map((node, i) => ({
        node,
        phaseX: i * 1.37 + 0.4,
        phaseY: i * 2.11 + 1.1,
        speedX: 0.00075 + (i % 3) * 0.00018,
        speedY: 0.0009 + ((i + 1) % 3) * 0.0002,
        ampX: 5 + (i % 4) * 1.5,
        ampY: 4 + (i % 3) * 1.5,
        currX: 0,
        currY: 0,
      }));

      function tick(now: number) {
        if (!document.body.contains(cloud)) return;

        for (const s of states) {
          const isHovered = s.node === hoveredNode;
          let targetX = Math.sin(now * s.speedX + s.phaseX) * s.ampX;
          let targetY = Math.cos(now * s.speedY + s.phaseY) * s.ampY;

          if (isHovered) {
            targetX *= 0.2;
            targetY *= 0.2;
          } else if (pointerX > -1000) {
            const rect = s.node.getBoundingClientRect();
            const cloudRect = cloud!.getBoundingClientRect();
            const cx = rect.left - cloudRect.left + rect.width / 2;
            const cy = rect.top - cloudRect.top + rect.height / 2;
            const dx = cx - pointerX;
            const dy = cy - pointerY;
            const dist = Math.hypot(dx, dy);
            if (dist > 1 && dist < 130) {
              const push = ((130 - dist) / 130) * 10;
              targetX += (dx / dist) * push;
              targetY += (dy / dist) * push;
            }
          }

          s.currX += (targetX - s.currX) * 0.08;
          s.currY += (targetY - s.currY) * 0.08;
          const scale = isHovered ? 1.09 : 1;
          s.node.style.transform = `translate3d(${s.currX.toFixed(2)}px, ${s.currY.toFixed(2)}px, 0) scale(${scale})`;
        }

        window.requestAnimationFrame(tick);
      }

      window.requestAnimationFrame(tick);
    }
  }

  // ─── 3. HOMEPAGE BIBTEX COPY BUTTONS ─────────────────────────────────────────
  function initHomeBibtex() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-home-bibtex]');
    buttons.forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', async () => {
        const bibtex = btn.dataset.homeBibtex || '';
        const label = btn.querySelector<HTMLElement>('[data-bibtex-label]');
        if (!bibtex) return;
        try {
          await navigator.clipboard.writeText(bibtex);
          btn.classList.add('is-copied');
          if (label) label.textContent = 'copied';
          window.setTimeout(() => {
            btn.classList.remove('is-copied');
            if (label) label.textContent = 'bibtex';
          }, 1800);
        } catch {
          if (label) label.textContent = 'error';
        }
      });
    });
  }

  function initMediaThumbFallbacks() {
    const imgs = document.querySelectorAll<HTMLImageElement>('img[data-media-thumb]');
    imgs.forEach((img) => {
      if (img.dataset.bound === '1') return;
      img.dataset.bound = '1';
      img.addEventListener('error', () => {
        const fallback = img.dataset.fallbackSrc || '/images/media/media-default-thumb.png';
        if (img.getAttribute('src') !== fallback) {
          img.setAttribute('src', fallback);
        }
      });
    });
  }

  function initHomePage() {
    initDeepfakeCarousel();
    initWordCloudAndModal();
    initHomeBibtex();
    initMediaThumbFallbacks();
  }

  document.addEventListener('astro:page-load', initHomePage);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomePage, { once: true });
  } else {
    initHomePage();
  }
</script>

