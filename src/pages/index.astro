---
/**
 * Home Page — researcher-focused: HCI, digital media forensics, DeFake / verification research.
 * Route: /
 * @page
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import { truncateForPreview } from '../utils/preview';
import { formatTimelineDate } from '../utils/timelineDate';

/**
 * Queries and filters featured projects for hero section
 * 
 * Retrieves all projects, filters for featured ones, sorts by custom order
 * (if specified), and limits to top 2 for the hero snapshots.
 */
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

/**
 * Case snapshots for hero display
 * 
 * Takes up to 3 featured projects to showcase in the hero section,
 * providing immediate evidence of impact and outcomes.
 */
const caseSnapshots = featuredProjects.slice(0, 3);

/**
 * Five most recent timeline rows (journey + speaking), same ordering as /journey.
 */
const journeyForHero = await getCollection('journey');
const speakingForHero = await getCollection('speaking');
const heroJourneyFeed = [
  ...journeyForHero.map((e) => ({
    date: e.data.date,
    title: e.data.title,
  })),
  ...speakingForHero.map((e) => ({
    date: e.data.date,
    title: e.data.title,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

/**
 * Recent publications for homepage preview (newest by year, then order).
 */
const allPublications = await getCollection('publications');
const recentPublications = allPublications
  .sort((a, b) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 5);

const PUB_STATUS_LABELS: Record<string, string> = {
  inSubmission: 'In submission',
  underReview: 'Under review',
  inPreparation: 'In preparation',
};
---

<BaseLayout>
  <SEO
    slot="head"
    title={siteConfig.title}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  <!-- Structured Data for Homepage -->
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <h1 class="hero-title">
            <span class="hero-title-small">Research at the intersection of</span><br/>
            <span class="hero-title-emphasis">human factors, usability, and AI‑assisted media verification.</span>
          </h1>
          <p class="hero-sub">
            I study how journalists, analysts, and investigators work with <strong>deepfakes and manipulated media</strong>—and how to build <strong>explainable, trustworthy tools</strong> that support human judgment instead of replacing it.
          </p>
          <p class="hero-meta">
            {siteConfig.author.name} · {siteConfig.author.title}
          </p>
          <p class="hero-affiliation">
            ESL Global Cybersecurity Institute, Rochester Institute of Technology
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn-primary">Research projects</a>
            <a href="/publications" class="btn-secondary">Publications</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="case-snapshots">
            {caseSnapshots.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class="case-label">Research · {project.data.role}</span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{truncateForPreview(project.data.abstract)}</span>
              </a>
            ))}
          </div>

          {heroJourneyFeed.length > 0 && (
            <div
              class="hero-journey-ticker"
              id="hero-journey-ticker"
              data-count={heroJourneyFeed.length}
              aria-labelledby="hero-journey-updates-label"
            >
              <div class="hero-journey-header">
                <p id="hero-journey-updates-label" class="hero-journey-label">Latest updates</p>
                <ForwardLink href="/journey" text="View all" variant="muted" class="hero-journey-view-all" />
              </div>
              <div class="hero-journey-viewport">
                {heroJourneyFeed.map((row, i) => (
                  <a
                    href="/journey"
                    class:list={['hero-journey-slide', i === 0 && 'is-active']}
                    data-slide-index={i}
                  >
                    <time class="hero-journey-date" datetime={row.date.toISOString()}>
                      {formatTimelineDate(row.date)}
                    </time>
                    <span class="hero-journey-slide-title">{row.title}</span>
                  </a>
                ))}
              </div>
              {heroJourneyFeed.length > 1 && (
                <div class="hero-journey-dots" aria-hidden="true">
                  {heroJourneyFeed.map((_, i) => (
                    <span
                      class:list={['hero-journey-dot', i === 0 && 'is-active']}
                      data-dot-index={i}
                    ></span>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="research-focus" aria-labelledby="research-focus-heading">
      <div class="research-focus-inner">
        <h2 id="research-focus-heading" class="research-focus-heading">Focus</h2>
        <p class="research-focus-body">
          I co-founded and lead the <strong>DeFake Project</strong>, an interdisciplinary initiative spanning four universities, working at the boundary of qualitative inquiry, interface design, and machine-learning deployment. Seven-plus years in HCI and ML research and four in industry UX have taught me to stay on the user&rsquo;s side of a problem while being honest about what is technically and organizationally feasible.
        </p>
        <p class="research-focus-themes">
          Usable deepfake detection · Digital media forensics (vision, audio, metadata, identity) · Mixed-methods HCI with expert practitioners · Explainable AI and automation bias · Simulation-based training for verification
        </p>
        <figure class="research-focus-photo">
          <img
            src="/images/john.jpg"
            alt={`Portrait of ${siteConfig.author.name}`}
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- Recent publications -->
    <section class="recent-publications">
      <div class="section-header">
        <h2>Recent publications</h2>
        <ForwardLink href="/publications" text="View all" variant="muted" />
      </div>

      {recentPublications.length > 0 ? (
        <div class="publications-preview-list">
          {recentPublications.map((pub) => {
            const href = pub.data.url ?? '/publications';
            const external = Boolean(pub.data.url);
            return (
              <a
                href={href}
                class="publication-preview-item"
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <div class="publication-preview-main">
                  <span class="publication-preview-meta">
                    {pub.data.status && pub.data.status !== 'published' && (
                      <span class="publication-preview-status">{PUB_STATUS_LABELS[pub.data.status]}</span>
                    )}
                    {pub.data.year}
                    {pub.data.tags && pub.data.tags.length > 0 && (
                      <> · {pub.data.tags.slice(0, 3).join(' · ')}</>
                    )}
                    <span class="publication-preview-quality">{pub.data.quality && ` · ${pub.data.quality}`}</span>
                  </span>
                  <h3 class="publication-preview-title">{pub.data.title}</h3>
                  <p class="publication-preview-authors">{pub.data.authors}</p>
                  <p class="publication-preview-venue">{pub.data.venue}</p>
                </div>
                <ArrowRight class="publication-preview-arrow" size={14} aria-hidden="true" />
              </a>
            );
          })}
        </div>
      ) : (
        <p class="no-publications">No publications listed yet.</p>
      )}
    </section>

    <section class="cta">
      <h2>Collaborate or get in touch</h2>
      <p>
        Open to research partnerships, invited talks, and conversations about usable verification tools, synthetic media, and human-centered security. Reach out if our work aligns.
      </p>
      <div class="cta-buttons">
        <a href="/publications" class="btn-primary">Publications</a>
        <a href="/contact" class="btn-secondary">Contact</a>
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 4rem 0 5rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 4rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .hero-left {
      padding-right: 2rem;
    }

    .hero-title {
      font-size: 2.25rem;
      line-height: 1.3;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
      color: var(--color-text);
    }

    .hero-title-emphasis {
      color: var(--color-text-secondary);
    }

    .hero-title-small {
      font-size: 1.125rem;
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .hero-meta {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: 0.35rem;
      letter-spacing: 0.01em;
    }

    .hero-affiliation {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin: 0 0 2rem;
      line-height: 1.45;
    }

    .research-focus {
      margin-bottom: 4rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid var(--color-border);
    }

    .research-focus-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
      column-gap: 2.75rem;
      row-gap: 0;
      align-items: start;
    }

    .research-focus-heading {
      grid-column: 1;
      grid-row: 1;
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin: 0 0 1rem;
      color: var(--color-text);
    }

    .research-focus-body {
      grid-column: 1;
      grid-row: 2;
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--color-text-secondary);
      margin: 0 0 1.25rem;
    }

    .research-focus-themes {
      grid-column: 1;
      grid-row: 3;
      font-size: 0.9375rem;
      line-height: 1.65;
      color: var(--color-text-muted);
      margin: 0;
    }

    .research-focus-photo {
      grid-column: 2;
      grid-row: 1 / 4;
      margin: 0;
      align-self: start;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-bg-secondary);
    }

    .research-focus-photo img {
      display: block;
      width: 100%;
      height: auto;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--color-text-secondary);
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .case-snapshot {
      display: block;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .case-snapshot:hover {
      border-color: var(--color-text-muted);
      background: var(--color-bg-elevated);
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* Recent timeline — auto slider, no card (under project snapshots) */
    .hero-journey-ticker {
      margin-top: 1.25rem;
    }

    .hero-journey-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin: 0 0 0.5rem;
    }

    .hero-journey-label {
      margin: 0;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
    }

    .hero-journey-header :global(.hero-journey-view-all) {
      flex-shrink: 0;
      font-size: 0.75rem;
    }

    .hero-journey-header :global(.hero-journey-view-all .arrow-icon) {
      width: 12px;
      height: 12px;
    }

    .hero-journey-viewport {
      position: relative;
      min-height: 4.25rem;
    }

    .hero-journey-slide {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      text-decoration: none;
      color: inherit;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.45s ease,
        visibility 0.45s ease;
      outline: none;
    }

    .hero-journey-slide.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 1;
    }

    .hero-journey-slide:focus-visible {
      border-radius: 4px;
      box-shadow: 0 0 0 2px var(--color-accent);
    }

    .hero-journey-date {
      font-size: 0.75rem;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
    }

    .hero-journey-slide-title {
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      margin: 0;
    }

    .hero-journey-slide:hover .hero-journey-slide-title {
      color: var(--color-accent);
    }

    .hero-journey-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.65rem;
    }

    .hero-journey-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--color-text-muted);
      opacity: 0.35;
      transition: opacity 0.25s ease;
    }

    .hero-journey-dot.is-active {
      opacity: 1;
      background: var(--color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-journey-viewport {
        min-height: 0;
      }

      .hero-journey-slide {
        position: relative !important;
        left: auto;
        top: auto;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transition: none;
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--color-border);
      }

      .hero-journey-slide:last-of-type {
        border-bottom: none;
      }

      .hero-journey-dots {
        display: none;
      }
    }

    .introduction {
      max-width: 600px;
      margin-bottom: 5rem;
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-child {
      color: var(--color-text);
    }

    .recent-publications {
      margin-bottom: 5rem;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .section-header h2 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .publications-preview-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--color-border);
    }

    .publication-preview-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--color-border);
      text-decoration: none;
      color: inherit;
      outline: none;
    }

    .publication-preview-item:last-child {
      border-bottom: none;
    }

    .publication-preview-item:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
      border-radius: 4px;
    }

    .publication-preview-main {
      flex: 1;
      min-width: 0;
    }

    .publication-preview-meta {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }

    .publication-preview-quality {
      color: var(--color-tertiary);
    }

    .publication-preview-status {
      display: inline-block;
      margin-right: 0.5rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      background: rgba(234, 179, 8, 0.14);
      color: #ca8a04;
    }

    .publication-preview-title {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-text);
      margin-bottom: 0.35rem;
      transition: color 0.2s ease;
    }

    .publication-preview-arrow {
      flex-shrink: 0;
      align-self: center;
      color: var(--color-text-muted);
      transition:
        color 0.2s ease,
        transform 0.2s ease;
    }

    .publication-preview-arrow :global(svg) {
      display: block;
    }

    .publication-preview-item:hover .publication-preview-title,
    .publication-preview-item:hover .publication-preview-arrow {
      color: var(--color-accent);
    }

    .publication-preview-item:hover .publication-preview-arrow {
      transform: translateX(0.25rem);
    }

    .publication-preview-authors,
    .publication-preview-venue {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--color-text-secondary);
      margin: 0;
    }

    .publication-preview-venue {
      margin-top: 0.25rem;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }

    .no-publications {
      color: var(--color-text-muted);
      font-style: italic;
      padding: 1.5rem 0;
    }

    .thinking {
      margin-bottom: 5rem;
    }

    .thinking h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
    }

    .thinking-list {
      font-size: 1.0625rem;
      line-height: 1.9;
      color: var(--color-text-secondary);
      max-width: 680px;
    }

    .cta {
      padding: 3rem 0;
      border-top: 1px solid var(--color-border);
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 500px;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.5rem 0 3rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-left {
        padding-right: 0;
      }

      .hero-title {
        font-size: 1.75rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        text-align: center;
        width: 100%;
      }

      .case-snapshot {
        padding: 1rem 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .decision-title {
        font-size: 1rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn-primary,
      .cta-buttons .btn-secondary {
        width: 100%;
      }

      .research-focus-inner {
        grid-template-columns: 1fr;
        row-gap: 1rem;
      }

      .research-focus-heading {
        grid-column: 1;
        grid-row: 1;
        margin-bottom: 0.5rem;
      }

      .research-focus-photo {
        grid-column: 1;
        grid-row: 2;
        max-width: min(280px, 85vw);
        width: 100%;
        justify-self: center;
        margin: 0.25rem 0 0.25rem;
      }

      .research-focus-body {
        grid-column: 1;
        grid-row: 3;
      }

      .research-focus-themes {
        grid-column: 1;
        grid-row: 4;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var root = document.getElementById('hero-journey-ticker');
      if (!root) return;
      var slides = root.querySelectorAll('.hero-journey-slide');
      var dots = root.querySelectorAll('.hero-journey-dot');
      if (slides.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var i = 0;
      var n = slides.length;
      var timer;

      function go(index) {
        i = ((index % n) + n) % n;
        slides.forEach(function (el, j) {
          el.classList.toggle('is-active', j === i);
        });
        dots.forEach(function (el, j) {
          el.classList.toggle('is-active', j === i);
        });
      }

      function tick() {
        go(i + 1);
      }

      function start() {
        clearInterval(timer);
        timer = setInterval(tick, 5000);
      }

      function stop() {
        clearInterval(timer);
      }

      start();
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', function (e) {
        if (!root.contains(e.relatedTarget)) start();
      });
    })();
  </script>
</BaseLayout>
