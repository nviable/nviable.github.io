---
/**
 * Contact Page — Figma design language:
 * - Full-bleed Indigo Hero (#282b61) with direct email/ORCID/Scholar/CV links
 * - Full-bleed Yellow Band (#f6eb0f) with quick topic mailto pills
 * - Rounded contact form card + social links
 *
 * Route: /contact
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import { cvPdfPath, siteConfig } from '../config';
import { pagesConfig } from '../pages.config';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const env = (Astro.locals as any)?.runtime?.env ?? {};
const mailerConfigured = Boolean(env.CONTACT_MAILER);

const TOPICS = [
  'Research partnership or collaboration',
  'Invited talk or panel',
  'Student / mentee inquiry',
  'Media or press request',
  'Something else',
];

const socialLinks = Object.entries(siteConfig.social)
  .filter(([platform, url]) => url && platform !== 'orcid' && platform !== 'scholar')
  .map(([platform, url]) => ({
    platform: platform.charAt(0).toUpperCase() + platform.slice(1),
    url,
  }));

/** Strip CR/LF so user-supplied values can't inject extra email headers. */
function headerSafe(value: string): string {
  return value.replace(/[\r\n]+/g, ' ').trim();
}

function buildMime(opts: {
  from: string;
  to: string;
  replyTo: string;
  replyToName: string;
  subject: string;
  text: string;
}): string {
  const headers = [
    `From: Website Contact <${headerSafe(opts.from)}>`,
    `To: <${headerSafe(opts.to)}>`,
    `Reply-To: ${headerSafe(opts.replyToName)} <${headerSafe(opts.replyTo)}>`,
    `Subject: ${headerSafe(opts.subject)}`,
    `Date: ${new Date().toUTCString()}`,
    'MIME-Version: 1.0',
    'Content-Type: text/plain; charset="utf-8"',
    'Content-Transfer-Encoding: 8bit',
  ];
  const body = opts.text.replace(/\r?\n/g, '\r\n');
  return headers.join('\r\n') + '\r\n\r\n' + body + '\r\n';
}

type FormStatus = 'idle' | 'sent' | 'error' | 'invalid' | 'notconfigured';
let formStatus: FormStatus = 'idle';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const topic = String(data.get('topic') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const honeypot = String(data.get('company') ?? '').trim();
    const token = String(data.get('cf-turnstile-response') ?? '');

    if (honeypot) return Astro.redirect('/contact?status=sent', 303);

    const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!name || !emailValid || !message) {
      return Astro.redirect('/contact?status=invalid', 303);
    }

    if (env.TURNSTILE_SECRET_KEY) {
      const res = await fetch(
        'https://challenges.cloudflare.com/turnstile/v0/siteverify',
        {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            secret: String(env.TURNSTILE_SECRET_KEY),
            response: token,
            remoteip: Astro.request.headers.get('cf-connecting-ip') ?? '',
          }),
        },
      );
      const outcome: any = await res.json();
      if (!outcome?.success) return Astro.redirect('/contact?status=invalid', 303);
    }

    if (!env.CONTACT_MAILER) {
      return Astro.redirect('/contact?status=notconfigured', 303);
    }

    const host = (() => {
      try {
        return new URL(siteConfig.url).hostname;
      } catch {
        return 'nviable.me';
      }
    })();
    const from = String(env.CONTACT_FROM || `website@${host}`);
    const to = String(env.CONTACT_TO || from);
    const text = [
      'New message from the website contact form.',
      '',
      `Name:   ${name}`,
      `Email:  ${email}`,
      `Topic:  ${topic || '—'}`,
      '',
      'Message:',
      message,
    ].join('\n');

    const { EmailMessage } = await import('cloudflare:email');
    const raw = buildMime({
      from,
      to,
      replyTo: email,
      replyToName: name,
      subject: `[Website] ${topic || 'Contact'} — ${name}`,
      text,
    });
    await env.CONTACT_MAILER.send(new EmailMessage(from, to, raw));
    return Astro.redirect('/contact?status=sent', 303);
  } catch {
    return Astro.redirect('/contact?status=error', 303);
  }
} else {
  const param = Astro.url.searchParams.get('status');
  if (param === 'sent' || param === 'error' || param === 'invalid' || param === 'notconfigured') {
    formStatus = param;
  }
}

const banners: Record<Exclude<FormStatus, 'idle'>, { kind: 'ok' | 'err'; text: string }> = {
  sent: { kind: 'ok', text: 'Thanks — your message is on its way. I read every email and reply within a few days.' },
  error: { kind: 'err', text: 'Something went wrong sending your message. Please email me directly using the address below.' },
  invalid: { kind: 'err', text: 'Please check your name, a valid email, and a message, then try again.' },
  notconfigured: { kind: 'err', text: 'The form isn’t live yet — please email me directly using the address below.' },
};
const banner = formStatus !== 'idle' ? banners[formStatus] : null;
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.contact.title}
    description={pagesConfig.contact.description}
    type="website"
    image="/og/contact.png"
  />

  <main class="contact-page-wrap">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. PURPLE INDIGO HERO
         ════════════════════════════════════════════════════════════════════════ -->
    <header class="indigo-hero">
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="350"
        height="196"
        class="indigo-hero__corner indigo-hero__corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="368"
        height="219"
        class="indigo-hero__corner indigo-hero__corner--br"
        aria-hidden="true"
      />

      <div class="indigo-hero__inner">
        <p class="indigo-hero__eyebrow">Collaborations, Talks &amp; Media Inquiries</p>
        <h1 class="indigo-hero__title">{pagesConfig.contact.heading}</h1>
        <p class="indigo-hero__lead">
          I’m open to new roles and collaborations, in academia and in industry.
        </p>

        <div class="indigo-hero__stats">
          <a href={`mailto:${siteConfig.author.email}`} class="figma-yellow-btn">
            {siteConfig.author.email}
          </a>
          {siteConfig.social.orcid && (
            <a
              href={siteConfig.social.orcid}
              target="_blank"
              rel="noopener noreferrer"
              class="indigo-hero__stat-pill contact-hero-link"
            >
              ORCID ↗
            </a>
          )}
          {siteConfig.social.scholar && (
            <a
              href={siteConfig.social.scholar}
              target="_blank"
              rel="noopener noreferrer"
              class="indigo-hero__stat-pill contact-hero-link"
            >
              Google Scholar ↗
            </a>
          )}
          <a href={cvPdfPath} class="indigo-hero__stat-pill contact-hero-link">
            CV (PDF)
          </a>
        </div>
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. YELLOW BAND WITH QUICK EMAIL TOPICS
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="yellow-band">
      <div class="yellow-band__inner">
        <div class="yellow-band__group">
          <span class="yellow-band__label">Quick email:</span>
          {TOPICS.map((t) => (
            <a
              class="yellow-band__pill"
              href={`mailto:${siteConfig.author.email}?subject=${encodeURIComponent(t)}`}
            >
              {t}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. CONTACT FORM & SOCIAL LINKS
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="contact-page">
      {banner && (
        <p
          id="contact-form-banner"
          class:list={['form-banner', banner.kind === 'ok' ? 'form-banner--ok' : 'form-banner--err']}
          role="status"
        >
          {banner.text}
        </p>
      )}
      {!banner && (
        <p id="contact-form-banner" class="form-banner" role="status" hidden></p>
      )}

      <section class="form-zone">
        {mailerConfigured && (
          <form method="POST" action="/contact" class="contact-form" data-contact-form>
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="topic">What’s this about?</label>
              <select id="topic" name="topic">
                {TOPICS.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <div class="hp" aria-hidden="true">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            {turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
            )}

            <button type="submit" class="figma-yellow-btn submit-btn">Send message</button>
          </form>
        )}

        <p class="mailto-intro">
          {mailerConfigured ? 'Or start an email with a topic filled in:' : 'Start an email with a topic filled in:'}
        </p>
        <div class="mailto-buttons">
          {TOPICS.map((t) => (
            <a class="mailto-btn" href={`mailto:${siteConfig.author.email}?subject=${encodeURIComponent(t)}`}>
              {t}
            </a>
          ))}
        </div>
      </section>

      {socialLinks.length > 0 && (
        <section class="secondary-zone">
          <h2>Elsewhere</h2>
          <div class="social-links">
            {socialLinks.map((link, index) => (
              <>
                <a href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}</a>
                {index < socialLinks.length - 1 && <span class="separator">·</span>}
              </>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  {turnstileSiteKey && mailerConfigured && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )}

  <script>
    const STATUS_MESSAGES: Record<string, { kind: 'ok' | 'err'; text: string }> = {
      sent: {
        kind: 'ok',
        text: 'Thanks — your message is on its way. I read every email and reply within a few days.',
      },
      error: {
        kind: 'err',
        text: 'Something went wrong sending your message. Please email me directly using the address below.',
      },
      invalid: {
        kind: 'err',
        text: 'Please check your name, a valid email, and a message, then try again.',
      },
      notconfigured: {
        kind: 'err',
        text: 'The form isn’t live yet — please email me directly using the address below.',
      },
    };

    function bindContactForm() {
      const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
      const bannerEl = document.getElementById('contact-form-banner');
      if (!form || !bannerEl || form.dataset.bound === '1') return;
      form.dataset.bound = '1';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            redirect: 'follow',
          });
          const statusParam = new URL(res.url, window.location.origin).searchParams.get('status');
          const status = statusParam && STATUS_MESSAGES[statusParam] ? statusParam : (res.ok ? 'sent' : 'error');
          const info = STATUS_MESSAGES[status] ?? STATUS_MESSAGES.error;

          bannerEl.textContent = info.text;
          bannerEl.classList.remove('form-banner--ok', 'form-banner--err');
          bannerEl.classList.add(info.kind === 'ok' ? 'form-banner--ok' : 'form-banner--err');
          bannerEl.hidden = false;

          if (status === 'sent') {
            form.reset();
          }
        } catch {
          const info = STATUS_MESSAGES.error;
          bannerEl.textContent = info.text;
          bannerEl.classList.remove('form-banner--ok', 'form-banner--err');
          bannerEl.classList.add('form-banner--err');
          bannerEl.hidden = false;
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    document.addEventListener('astro:page-load', bindContactForm);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindContactForm, { once: true });
    } else {
      bindContactForm();
    }
  </script>

  <style>
    .contact-page-wrap {
      width: 100%;
    }

    .contact-hero-link {
      text-decoration: none;
      transition: border-color 0.15s ease, color 0.15s ease;
    }

    .contact-hero-link:hover {
      border-color: #f6eb0f;
      color: #f6eb0f;
    }

    .contact-page {
      max-width: 740px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 5rem;
    }

    .form-banner {
      margin: 0 0 1.75rem;
      padding: 0.85rem 1rem;
      border-radius: 12px;
      font-size: 0.9375rem;
      line-height: 1.5;
      border: 1px solid var(--color-border);
    }

    .form-banner[hidden] {
      display: none;
    }

    .form-banner--ok {
      background: rgba(34, 197, 94, 0.12);
      border-color: rgba(34, 197, 94, 0.4);
      color: var(--color-text);
    }

    .form-banner--err {
      background: rgba(234, 179, 8, 0.12);
      border-color: rgba(234, 179, 8, 0.4);
      color: var(--color-text);
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.65rem 1.75rem;
      border-radius: 16px;
      background: var(--color-card);
      border: 1px solid var(--color-border);
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .field label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-text-secondary);
    }

    .field input,
    .field select,
    .field textarea {
      font-family: inherit;
      font-size: 1rem;
      color: var(--color-text);
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      padding: 0.65rem 0.85rem;
      width: 100%;
      transition: border-color 0.15s ease;
    }

    .field textarea {
      resize: vertical;
      min-height: 7rem;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: none;
      border-color: var(--color-accent);
    }

    .hp {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .submit-btn {
      align-self: flex-start;
    }

    .mailto-intro {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      margin: 0 0 1rem;
    }

    .contact-form + .mailto-intro {
      margin-top: 2rem;
    }

    .mailto-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 2rem;
    }

    .mailto-btn {
      font-size: 0.9375rem;
      font-weight: 500;
      padding: 0.55rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius-pill);
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: border-color 0.15s ease, color 0.15s ease;
    }

    .mailto-btn:hover {
      border-color: var(--color-accent);
      color: var(--color-text);
    }

    .secondary-zone {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .secondary-zone h2 {
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-muted);
      margin-bottom: 0.85rem;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .social-links a {
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.2s ease;
    }

    .social-links a:hover {
      color: var(--color-text);
    }

    .separator {
      color: var(--color-text-muted);
      user-select: none;
    }

    @media (max-width: 640px) {
      .contact-page {
        padding: 1.75rem 1rem 4rem;
      }

      .contact-form {
        padding: 1.25rem;
      }
    }
  </style>
</BaseLayout>
