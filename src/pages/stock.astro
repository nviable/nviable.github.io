---
/**
 * iPhone Duo Apple Store Stock Tracker & Restock History
 * Route: /stock
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Smartphone from '@lucide/astro/icons/smartphone';
import MapPin from '@lucide/astro/icons/map-pin';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ExternalLink from '@lucide/astro/icons/external-link';
import History from '@lucide/astro/icons/history';
import ListFilter from '@lucide/astro/icons/list-filter';
import Bell from '@lucide/astro/icons/bell';
import Sparkles from '@lucide/astro/icons/sparkles';
import Trash2 from '@lucide/astro/icons/trash-2';
import Download from '@lucide/astro/icons/download';

const TRACKED_MODELS = [
  { sku: 'MK1F4LL/A', name: 'iPhone Duo 256GB Night Sky', color: 'Night Sky', storage: '256GB' },
  { sku: 'MK1G4LL/A', name: 'iPhone Duo 512GB Star White', color: 'Star White', storage: '512GB' },
  { sku: 'MK1H4LL/A', name: 'iPhone Duo 512GB Night Sky', color: 'Night Sky', storage: '512GB' },
];

const TARGET_STORES = [
  { id: 'R140', name: 'Eastview', city: 'Victor / Rochester', state: 'NY', distance: '11.3 mi', url: 'https://www.apple.com/retail/eastview/' },
  { id: 'R016', name: 'Walden Galleria', city: 'Buffalo', state: 'NY', distance: '57.4 mi', url: 'https://www.apple.com/retail/waldengalleria/' },
  { id: 'R107', name: 'Syracuse', city: 'Destiny USA, Syracuse', state: 'NY', distance: '74.6 mi', url: 'https://www.apple.com/retail/syracuse/' },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title="iPhone Duo Stock Tracker · Upstate NY (14623)"
    description="Real-time Apple Store pickup stock tracker and historical restock log for iPhone Duo around Rochester, Buffalo, and Syracuse (Zip 14623)."
    type="website"
  />

  <main class="stock-container">
    <header class="stock-header">
      <div class="stock-badge-row">
        <span class="stock-badge">
          <Smartphone size={13} aria-hidden="true" />
          Hardware Tracker
        </span>
        <span class="stock-badge stock-badge--geo">
          <MapPin size={13} aria-hidden="true" />
          Zip 14623 · Upstate NY
        </span>
      </div>

      <h1 class="stock-title">iPhone Duo Stock Monitor</h1>
      <p class="stock-intro">
        Continuous pickup availability monitor across Apple Stores near Rochester (Eastview), Buffalo (Walden Galleria), and Syracuse (Destiny USA).
      </p>

      <!-- Quick Control & Stats Bar -->
      <div class="monitor-bar">
        <div class="monitor-status">
          <span class="pulse-indicator" id="pulseIndicator"></span>
          <span class="status-text" id="monitorStatusText">Ready to check</span>
          <span class="status-sep">·</span>
          <span class="last-checked" id="lastCheckedText">Last checked: Never</span>
        </div>

        <div class="monitor-actions">
          <button type="button" class="btn btn-primary check-now-btn" id="checkNowBtn">
            <RefreshCw size={15} class="spin-icon" id="refreshIcon" aria-hidden="true" />
            <span>Check Stock Now</span>
          </button>

          <label class="auto-refresh-toggle">
            <input type="checkbox" id="autoRefreshToggle" />
            <span class="toggle-label">Auto-check (60s)</span>
          </label>

          <button type="button" class="btn btn-secondary sound-toggle-btn" id="soundToggleBtn" title="Toggle audio alert on restock" aria-pressed="false">
            <Bell size={14} aria-hidden="true" />
            <span id="soundToggleLabel">Alert Sound: Off</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Key Metrics Grid -->
    <section class="stats-grid" aria-label="Inventory overview metrics">
      <div class="stat-card">
        <div class="stat-label">Total In-Stock Locations</div>
        <div class="stat-value" id="statInStockCount">—</div>
        <div class="stat-sub" id="statInStockSub">Checking Rochester, Buffalo &amp; Syracuse</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Fastest Pickup Location</div>
        <div class="stat-value" id="statNearest">Eastview (11 mi)</div>
        <div class="stat-sub">Victor, NY · Store R140</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Restock Events Detected</div>
        <div class="stat-value" id="statRestocksCount">0</div>
        <div class="stat-sub" id="statRestocksSub">Saved in local session history</div>
      </div>
    </section>

    <!-- Store Live Inventory Cards -->
    <section class="stores-section" aria-labelledby="stores-heading">
      <div class="section-title-row">
        <h2 id="stores-heading" class="section-heading">Store Locations (Nearest to 14623)</h2>
        <span class="section-hint">Queried directly via Apple Retail Fulfillment API</span>
      </div>

      <div class="stores-grid" id="storesGrid">
        {TARGET_STORES.map((store) => (
          <div class="store-card" id={`store-card-${store.id}`} data-store={store.id}>
            <div class="store-card__header">
              <div class="store-info">
                <span class="store-badge">Store {store.id}</span>
                <h3 class="store-name">Apple {store.name}</h3>
                <p class="store-meta">
                  <span>{store.city}, {store.state}</span>
                  <span class="dot">·</span>
                  <span class="distance-chip">{store.distance}</span>
                </p>
              </div>

              <div class="store-overall-status">
                <span class="status-pill status-pill--pending" id={`store-pill-${store.id}`}>Checking...</span>
              </div>
            </div>

            <div class="store-models" id={`store-models-${store.id}`}>
              {TRACKED_MODELS.map((model) => (
                <div class="model-row" id={`model-${store.id}-${model.sku.replace(/[^a-zA-Z0-9]/g, '')}`}>
                  <div class="model-details">
                    <span class="model-name">{model.name}</span>
                    <span class="model-sku">SKU: {model.sku}</span>
                  </div>
                  <div class="model-status">
                    <span class="status-chip status-chip--neutral" id={`chip-${store.id}-${model.sku.replace(/[^a-zA-Z0-9]/g, '')}`}>
                      Checking
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="store-card__footer">
              <a href={store.url} target="_blank" rel="noopener noreferrer" class="reserve-btn" id={`reserve-btn-${store.id}`}>
                <span>Open Apple {store.name} Page</span>
                <ExternalLink size={13} aria-hidden="true" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Restock History & Activity Log -->
    <section class="history-section" aria-labelledby="history-heading">
      <div class="history-header">
        <div>
          <h2 id="history-heading" class="section-heading">
            <History size={18} class="heading-icon" aria-hidden="true" />
            Restock History &amp; Activity Log
          </h2>
          <p class="history-desc">Records every availability status transition and poll cycle.</p>
        </div>

        <div class="history-controls">
          <div class="filter-group">
            <ListFilter size={14} class="filter-icon" aria-hidden="true" />
            <select id="historyFilterSelect" class="history-select" aria-label="Filter history entries">
              <option value="all">All Events</option>
              <option value="restock">Restocks Only</option>
              <option value="R140">Rochester (Eastview)</option>
              <option value="R016">Buffalo (Walden Galleria)</option>
              <option value="R107">Syracuse (Destiny USA)</option>
            </select>
          </div>

          <button type="button" class="btn btn-tertiary history-tool-btn" id="exportHistoryBtn" title="Download history JSON">
            <Download size={13} aria-hidden="true" />
            <span>Export</span>
          </button>

          <button type="button" class="btn btn-tertiary history-tool-btn" id="clearHistoryBtn" title="Clear local history log">
            <Trash2 size={13} aria-hidden="true" />
            <span>Clear</span>
          </button>
        </div>
      </div>

      <div class="history-table-wrapper">
        <table class="history-table">
          <thead>
            <tr>
              <th scope="col">Time</th>
              <th scope="col">Store</th>
              <th scope="col">Model / SKU</th>
              <th scope="col">Availability</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody id="historyTableBody">
            <tr class="empty-row">
              <td colspan="5">No stock checks logged yet. Click "Check Stock Now" above.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Architecture & Cloudflare Worker Free Tier Guide -->
    <section class="architecture-guide">
      <details class="guide-details">
        <summary class="guide-summary">
          <span class="guide-summary-title">
            <Sparkles size={16} class="guide-icon" aria-hidden="true" />
            Do I need the $5/mo Cloudflare Worker Plan? (Setup Guide)
          </span>
          <span class="guide-badge">100% Free on Cloudflare</span>
        </summary>

        <div class="guide-content">
          <div class="guide-answer-box">
            <h4>No, you do not need the $5/month Workers Paid plan.</h4>
            <p>
              Checking 3 stores every 30 minutes consumes only <strong>48 requests/day</strong> (using location 14623 which queries all 3 stores in one HTTP call) or <strong>144 requests/day</strong> (if queried store-by-store). Cloudflare's Free tier provides <strong>100,000 requests/day</strong> and <strong>Scheduled Cron Triggers</strong> at zero charge.
            </p>
          </div>

          <div class="guide-comparison-grid">
            <div class="guide-card">
              <h5>Option 1: Cloudflare D1 (Recommended, Free)</h5>
              <p>Cloudflare's serverless SQLite database. Free tier includes <strong>5,000,000 reads/day</strong> and <strong>100,000 writes/day</strong>. Zero credit card or external signup needed.</p>
              <code>npx wrangler d1 create apple-stock-db</code>
            </div>

            <div class="guide-card">
              <h5>Option 2: Cloudflare KV (Fast, Free)</h5>
              <p>Key-Value storage built directly into Workers. Free tier includes <strong>100,000 reads/day</strong> and <strong>1,000 writes/day</strong>, ideal for caching the last restock timestamp.</p>
              <code>npx wrangler kv namespace create STOCK_KV</code>
            </div>

            <div class="guide-card">
              <h5>Option 3: Supabase (Free Tier)</h5>
              <p>If you prefer an external Postgres database with an instant web dashboard, Supabase free tier gives 500 MB storage. Can be called directly via <code>fetch()</code> in the worker.</p>
              <code>POST https://&lt;project&gt;.supabase.co/rest/v1/stock_history</code>
            </div>
          </div>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

<script>
  interface PartItem {
    title: string;
    available: boolean;
    pickupDisplay: string;
    quote: string;
  }

  interface StoreItem {
    storeNumber: string;
    storeName: string;
    city: string;
    state: string;
    distance: string;
    reservationUrl: string;
    parts: Record<string, PartItem>;
  }

  interface HistoryRecord {
    id: string;
    timestamp: string;
    storeNumber: string;
    storeName: string;
    city: string;
    partNumber: string;
    productTitle: string;
    available: boolean;
    isRestock: boolean;
    reservationUrl: string;
  }

  const STORAGE_KEY = 'apple_stock_history_14623';
  const STATE_KEY = 'apple_stock_last_state';
  const SOUND_KEY = 'apple_stock_sound_enabled';

  let autoRefreshTimer: number | null = null;
  let soundEnabled = false;

  function initTracker() {
    const checkBtn = document.getElementById('checkNowBtn');
    const autoToggle = document.getElementById('autoRefreshToggle') as HTMLInputElement | null;
    const soundBtn = document.getElementById('soundToggleBtn');
    const filterSelect = document.getElementById('historyFilterSelect') as HTMLSelectElement | null;
    const exportBtn = document.getElementById('exportHistoryBtn');
    const clearBtn = document.getElementById('clearHistoryBtn');

    if (!checkBtn) return;

    // Load sound preference
    soundEnabled = localStorage.getItem(SOUND_KEY) === 'true';
    updateSoundButtonState();

    // Load initial history
    renderHistoryTable();
    updateStatSummary();

    // Event listeners
    checkBtn.addEventListener('click', () => {
      performStockCheck();
    });

    if (autoToggle) {
      autoToggle.addEventListener('change', (e) => {
        const checked = (e.target as HTMLInputElement).checked;
        if (checked) {
          performStockCheck();
          autoRefreshTimer = window.setInterval(() => {
            performStockCheck();
          }, 60000);
        } else {
          if (autoRefreshTimer) {
            clearInterval(autoRefreshTimer);
            autoRefreshTimer = null;
          }
        }
      });
    }

    if (soundBtn) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        localStorage.setItem(SOUND_KEY, String(soundEnabled));
        updateSoundButtonState();
        if (soundEnabled) playChime();
      });
    }

    if (filterSelect) {
      filterSelect.addEventListener('change', () => {
        renderHistoryTable();
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', exportHistoryData);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Clear local restock history log?')) {
          localStorage.removeItem(STORAGE_KEY);
          localStorage.removeItem(STATE_KEY);
          renderHistoryTable();
          updateStatSummary();
        }
      });
    }

    // Run initial stock check on load
    performStockCheck();
  }

  function updateSoundButtonState() {
    const btn = document.getElementById('soundToggleBtn');
    const label = document.getElementById('soundToggleLabel');
    if (!btn || !label) return;
    btn.setAttribute('aria-pressed', String(soundEnabled));
    label.textContent = soundEnabled ? 'Alert Sound: On' : 'Alert Sound: Off';
    btn.classList.toggle('sound-active', soundEnabled);
  }

  function playChime() {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
      osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1); // A5
      gain.gain.setValueAtTime(0.15, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.4);
    } catch {
      // AudioContext unavailable or blocked
    }
  }

  async function performStockCheck() {
    const refreshIcon = document.getElementById('refreshIcon');
    const statusText = document.getElementById('monitorStatusText');
    const lastChecked = document.getElementById('lastCheckedText');
    const pulse = document.getElementById('pulseIndicator');
    const checkBtn = document.getElementById('checkNowBtn') as HTMLButtonElement | null;

    if (refreshIcon) refreshIcon.classList.add('is-spinning');
    if (statusText) statusText.textContent = 'Querying Apple Store API...';
    if (pulse) pulse.className = 'pulse-indicator pulse-indicator--active';
    if (checkBtn) checkBtn.disabled = true;

    try {
      const res = await fetch('/api/stock?zip=14623');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (data.status === 'ok' && Array.isArray(data.stores)) {
        processStoreData(data.stores);
        const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        if (lastChecked) lastChecked.textContent = `Last checked: ${nowStr}`;
        if (statusText) statusText.textContent = 'Monitoring active';
        if (pulse) pulse.className = 'pulse-indicator pulse-indicator--healthy';
      } else {
        throw new Error(data.error || 'Invalid API response');
      }
    } catch (err: any) {
      if (statusText) statusText.textContent = 'Check failed (will retry)';
      if (pulse) pulse.className = 'pulse-indicator pulse-indicator--error';
      console.warn('Apple stock query failed:', err);
    } finally {
      if (refreshIcon) refreshIcon.classList.remove('is-spinning');
      if (checkBtn) checkBtn.disabled = false;
    }
  }

  function processStoreData(stores: StoreItem[]) {
    const prevStates: Record<string, boolean> = JSON.parse(localStorage.getItem(STATE_KEY) || '{}');
    const currentStates: Record<string, boolean> = {};
    const newHistoryRecords: HistoryRecord[] = [];
    let anyRestockDetected = false;
    let totalInStockCount = 0;

    stores.forEach((store) => {
      const storeCard = document.getElementById(`store-card-${store.storeNumber}`);
      const storePill = document.getElementById(`store-pill-${store.storeNumber}`);
      let storeHasStock = false;

      Object.entries(store.parts).forEach(([sku, partInfo]) => {
        const cleanSku = sku.replace(/[^a-zA-Z0-9]/g, '');
        const chip = document.getElementById(`chip-${store.storeNumber}-${cleanSku}`);
        const stateKey = `${store.storeNumber}:${sku}`;
        const isAvailable = partInfo.available;
        const wasAvailable = Boolean(prevStates[stateKey]);

        currentStates[stateKey] = isAvailable;

        if (isAvailable) {
          storeHasStock = true;
          totalInStockCount++;
        }

        if (chip) {
          chip.textContent = isAvailable ? 'Available for Pickup' : 'Unavailable';
          chip.className = `status-chip ${isAvailable ? 'status-chip--success' : 'status-chip--neutral'}`;
        }

        // Detect restock transition (was out of stock, now in stock)
        const isRestock = isAvailable && !wasAvailable;
        if (isRestock) {
          anyRestockDetected = true;
        }

        // Add history entry if state changed OR if manual check
        if (isRestock || isAvailable) {
          newHistoryRecords.push({
            id: `${Date.now()}-${store.storeNumber}-${cleanSku}`,
            timestamp: new Date().toISOString(),
            storeNumber: store.storeNumber,
            storeName: store.storeName,
            city: store.city,
            partNumber: sku,
            productTitle: partInfo.title,
            available: isAvailable,
            isRestock,
            reservationUrl: store.reservationUrl,
          });
        }
      });

      if (storePill) {
        storePill.textContent = storeHasStock ? 'Stock Available!' : 'Out of Stock';
        storePill.className = `status-pill ${storeHasStock ? 'status-pill--success' : 'status-pill--muted'}`;
      }

      if (storeCard) {
        storeCard.classList.toggle('has-stock', storeHasStock);
      }
    });

    // Save states
    localStorage.setItem(STATE_KEY, JSON.stringify(currentStates));

    // Save history entries
    if (newHistoryRecords.length > 0) {
      const existingHistory: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      const updatedHistory = [...newHistoryRecords, ...existingHistory].slice(0, 100); // keep up to 100 entries
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updatedHistory));
      renderHistoryTable();
    }

    // Play sound if restock occurred
    if (anyRestockDetected && soundEnabled) {
      playChime();
    }

    updateStatSummary(totalInStockCount);
  }

  function updateStatSummary(inStockCount?: number) {
    const inStockEl = document.getElementById('statInStockCount');
    const inStockSub = document.getElementById('statInStockSub');
    const restocksEl = document.getElementById('statRestocksCount');

    const history: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    const restockEvents = history.filter((h) => h.isRestock).length;

    if (inStockEl && typeof inStockCount === 'number') {
      inStockEl.textContent = String(inStockCount);
      if (inStockSub) {
        inStockSub.textContent = inStockCount > 0 ? `${inStockCount} models ready for pickup` : 'None currently available';
      }
    }

    if (restocksEl) {
      restocksEl.textContent = String(restockEvents);
    }
  }

  function renderHistoryTable() {
    const tbody = document.getElementById('historyTableBody');
    const filterSelect = document.getElementById('historyFilterSelect') as HTMLSelectElement | null;
    if (!tbody) return;

    const history: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    const filter = filterSelect ? filterSelect.value : 'all';

    const filtered = history.filter((item) => {
      if (filter === 'all') return true;
      if (filter === 'restock') return item.isRestock;
      return item.storeNumber === filter;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr class="empty-row">
          <td colspan="5">No matching entries in history. Checks are logged as stock updates occur.</td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered
      .map((item) => {
        const time = new Date(item.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const date = new Date(item.timestamp).toLocaleDateString([], { month: 'short', day: 'numeric' });
        const badgeClass = item.isRestock
          ? 'table-pill table-pill--restock'
          : item.available
            ? 'table-pill table-pill--avail'
            : 'table-pill table-pill--out';
        const badgeText = item.isRestock ? 'RESTOCKED!' : item.available ? 'In Stock' : 'Out of Stock';

        return `
          <tr class="${item.isRestock ? 'highlight-row' : ''}">
            <td class="cell-time">
              <span class="time-main">${time}</span>
              <span class="time-sub">${date}</span>
            </td>
            <td class="cell-store">
              <strong>Apple ${escapeHtml(item.storeName)}</strong>
              <span class="store-code">(${item.storeNumber})</span>
            </td>
            <td class="cell-product">
              <span class="product-title">${escapeHtml(item.productTitle)}</span>
              <span class="product-sku">${escapeHtml(item.partNumber)}</span>
            </td>
            <td class="cell-status">
              <span class="${badgeClass}">${badgeText}</span>
            </td>
            <td class="cell-action">
              <a href="${item.reservationUrl}" target="_blank" rel="noopener noreferrer" class="table-link">
                Reserve ↗
              </a>
            </td>
          </tr>
        `;
      })
      .join('');
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function exportHistoryData() {
    const history = localStorage.getItem(STORAGE_KEY) || '[]';
    const blob = new Blob([history], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `apple-stock-history-14623-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  document.addEventListener('astro:page-load', initTracker);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTracker, { once: true });
  } else {
    initTracker();
  }
</script>

<style>
  .stock-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .stock-header {
    margin-bottom: 2rem;
  }

  .stock-badge-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius-pill);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .stock-badge--geo {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }

  .stock-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .stock-intro {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 48rem;
    margin: 0 0 1.5rem;
  }

  /* Control bar */
  .monitor-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-bottom: 3px solid var(--color-card-edge);
  }

  .monitor-status {
    display: flex;
    align-items: center;
