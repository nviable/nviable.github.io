---
/**
 * iPhone Duo Apple Store Stock Tracker & Restock History
 * Route: /stock
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Smartphone from '@lucide/astro/icons/smartphone';
import MapPin from '@lucide/astro/icons/map-pin';
import Database from '@lucide/astro/icons/database';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ExternalLink from '@lucide/astro/icons/external-link';
import History from '@lucide/astro/icons/history';
import ListFilter from '@lucide/astro/icons/list-filter';
import Bell from '@lucide/astro/icons/bell';
import Volume2 from '@lucide/astro/icons/volume-2';
import Map from '@lucide/astro/icons/map';
import Trash2 from '@lucide/astro/icons/trash-2';
import Download from '@lucide/astro/icons/download';

const TRACKED_MODELS = [
  { sku: 'MK1F4LL/A', name: 'iPhone Duo 256GB Night Sky', color: 'Night Sky', storage: '256GB' },
  { sku: 'MK1G4LL/A', name: 'iPhone Duo 512GB Star White', color: 'Star White', storage: '512GB' },
  { sku: 'MK1H4LL/A', name: 'iPhone Duo 512GB Night Sky', color: 'Night Sky', storage: '512GB' },
];

const TARGET_STORES = [
  { id: 'R140', name: 'Eastview', city: 'Victor / Rochester', state: 'NY', distance: '11.3 mi', url: 'https://www.apple.com/retail/eastview/' },
  { id: 'R016', name: 'Walden Galleria', city: 'Buffalo', state: 'NY', distance: '57.4 mi', url: 'https://www.apple.com/retail/waldengalleria/' },
  { id: 'R107', name: 'Syracuse', city: 'Destiny USA, Syracuse', state: 'NY', distance: '74.6 mi', url: 'https://www.apple.com/retail/syracuse/' },
];
---

<BaseLayout>
  <SEO
    slot="head"
    title="iPhone Duo Stock Tracker · Upstate NY (14623)"
    description="Real-time Apple Store pickup stock tracker and historical restock log for iPhone Duo around Rochester, Buffalo, and Syracuse (Zip 14623)."
    type="website"
  />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" slot="head" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" slot="head"></script>

  <main class="stock-container">
    <header class="stock-header">
      <div class="stock-header-grid">
        <div class="stock-header-main">
          <div class="stock-badge-row">
            <span class="stock-badge">
              <Smartphone size={13} aria-hidden="true" />
              Hardware Tracker
            </span>
            <span class="stock-badge stock-badge--geo">
              <MapPin size={13} aria-hidden="true" />
              Zip 14623 · Upstate NY
            </span>
            <span class="stock-badge stock-badge--d1" id="d1Badge">
              <Database size={13} aria-hidden="true" />
              Cloudflare D1 &amp; Cron
            </span>
          </div>

          <h1 class="stock-title">iPhone Duo Stock Monitor</h1>
          <p class="stock-intro">
            Continuous pickup availability monitor across Apple Stores near Rochester (Eastview), Buffalo (Walden Galleria), and Syracuse (Destiny USA).
          </p>
        </div>

        <!-- Compact Monitoring Control Card alongside Title -->
        <div class="monitor-card" aria-label="Live monitor controls">
          <div class="monitor-status">
            <span class="pulse-indicator" id="pulseIndicator"></span>
            <span class="status-text" id="monitorStatusText">Ready to check</span>
            <span class="status-sep">·</span>
            <span class="last-checked" id="lastCheckedText">Last: Never</span>
          </div>

          <div class="monitor-actions">
            <button type="button" class="btn btn-primary check-now-btn" id="checkNowBtn">
              <RefreshCw size={13} class="spin-icon" id="refreshIcon" aria-hidden="true" />
              <span>Check Now</span>
            </button>

            <div class="autocheck-picker">
              <label class="auto-refresh-toggle" for="autoRefreshToggle">
                <input type="checkbox" id="autoRefreshToggle" />
                <span class="toggle-label">Auto</span>
              </label>
              <select id="autoRefreshIntervalSelect" class="interval-select" aria-label="Auto-check frequency">
                <option value="300000">5m</option>
                <option value="600000">10m</option>
                <option value="900000">15m</option>
                <option value="1800000" selected>30m</option>
                <option value="3600000">60m</option>
              </select>
            </div>

            <button type="button" class="btn btn-secondary sound-toggle-btn" id="soundToggleBtn" title="Toggle audio chime on restock" aria-pressed="false">
              <Volume2 size={13} aria-hidden="true" />
              <span id="soundToggleLabel">Chime: Off</span>
            </button>

            <button type="button" class="btn btn-secondary notify-toggle-btn" id="notifyToggleBtn" title="Toggle desktop browser notifications on restock" aria-pressed="false">
              <Bell size={13} aria-hidden="true" />
              <span id="notifyToggleLabel">Alerts: Off</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Key Metrics Grid -->
    <section class="stats-grid" aria-label="Inventory overview metrics">
      <div class="stat-card">
        <div class="stat-label">Total In-Stock Locations</div>
        <div class="stat-value" id="statInStockCount">—</div>
        <div class="stat-sub" id="statInStockSub">Checking Rochester, Buffalo &amp; Syracuse</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Fastest Pickup Location</div>
        <div class="stat-value" id="statNearest">Eastview (11 mi)</div>
        <div class="stat-sub">Victor, NY · Store R140</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Restock Events Detected</div>
        <div class="stat-value" id="statRestocksCount">0</div>
        <div class="stat-sub" id="statRestocksSub">Saved in local session history</div>
      </div>
    </section>

    <!-- Store Live Inventory Cards -->
    <section class="stores-section" aria-labelledby="stores-heading">
      <div class="section-title-row">
        <h2 id="stores-heading" class="section-heading">Store Locations (Nearest to 14623)</h2>
        <span class="section-hint">Queried directly via Apple Retail Fulfillment API</span>
      </div>

      <div class="stores-grid" id="storesGrid">
        {TARGET_STORES.map((store) => (
          <div class="store-card" id={`store-card-${store.id}`} data-store={store.id}>
            <div class="store-card__header">
              <div class="store-info">
                <span class="store-badge">Store {store.id}</span>
                <h3 class="store-name">Apple {store.name}</h3>
                <p class="store-meta">
                  <span>{store.city}, {store.state}</span>
                  <span class="dot">·</span>
                  <span class="distance-chip">{store.distance}</span>
                </p>
              </div>

              <div class="store-overall-status">
                <span class="status-pill status-pill--pending" id={`store-pill-${store.id}`}>Checking...</span>
              </div>
            </div>

            <div class="store-models" id={`store-models-${store.id}`}>
              {TRACKED_MODELS.map((model) => (
                <div class="model-row" id={`model-${store.id}-${model.sku.replace(/[^a-zA-Z0-9]/g, '')}`}>
                  <div class="model-details">
                    <span class="model-name">{model.name}</span>
                    <span class="model-sku">SKU: {model.sku}</span>
                  </div>
                  <div class="model-status">
                    <span class="status-chip status-chip--neutral" id={`chip-${store.id}-${model.sku.replace(/[^a-zA-Z0-9]/g, '')}`}>
                      Checking
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="store-card__footer">
              <a href={store.url} target="_blank" rel="noopener noreferrer" class="reserve-btn" id={`reserve-btn-${store.id}`}>
                <span>Open Apple {store.name} Page</span>
                <ExternalLink size={13} aria-hidden="true" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Upstate NY Store Availability Map -->
    <section class="map-section" aria-labelledby="map-heading">
      <div class="section-title-row">
        <div>
          <h2 id="map-heading" class="section-heading">
            <Map size={18} class="heading-icon" aria-hidden="true" />
            Regional Inventory Map
          </h2>
          <span class="section-hint">Western &amp; Central NY Corridor: Buffalo (R016) · Victor / Rochester (R140) · Syracuse (R107)</span>
        </div>
        <div class="map-legend">
          <span class="legend-item"><span class="legend-dot legend-dot--green"></span> In Stock (Ping)</span>
          <span class="legend-item"><span class="legend-dot legend-dot--red"></span> Out of Stock (Ping)</span>
        </div>
      </div>

      <div class="map-container-card">
        <div id="stockMap" class="stock-map" aria-label="Interactive map of Upstate NY Apple Store inventory"></div>
      </div>
    </section>

    <!-- Restock History & Activity Log -->
    <section class="history-section" aria-labelledby="history-heading">
      <div class="history-header">
        <div>
          <h2 id="history-heading" class="section-heading">
            <History size={18} class="heading-icon" aria-hidden="true" />
            Restock History &amp; Activity Log
          </h2>
          <p class="history-desc">Records every availability status transition and poll cycle.</p>
        </div>

        <div class="history-controls">
          <div class="filter-group">
            <ListFilter size={14} class="filter-icon" aria-hidden="true" />
            <select id="historyFilterSelect" class="history-select" aria-label="Filter history entries">
              <option value="all">All Events</option>
              <option value="restock">Restocks Only</option>
              <option value="R140">Rochester (Eastview)</option>
              <option value="R016">Buffalo (Walden Galleria)</option>
              <option value="R107">Syracuse (Destiny USA)</option>
            </select>
          </div>

          <button type="button" class="btn btn-tertiary history-tool-btn" id="exportHistoryBtn" title="Download history JSON">
            <Download size={13} aria-hidden="true" />
            <span>Export</span>
          </button>

          <button type="button" class="btn btn-tertiary history-tool-btn" id="clearHistoryBtn" title="Clear local history log">
            <Trash2 size={13} aria-hidden="true" />
            <span>Clear</span>
          </button>
        </div>
      </div>

      <div class="history-table-wrapper">
        <table class="history-table">
          <thead>
            <tr>
              <th scope="col">Time</th>
              <th scope="col">Store</th>
              <th scope="col">Model / SKU</th>
              <th scope="col">Availability</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody id="historyTableBody">
            <tr class="empty-row">
              <td colspan="5">No stock checks logged yet. Click "Check Stock Now" above.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  interface PartItem {
    title: string;
    available: boolean;
    pickupDisplay: string;
    quote: string;
  }

  interface StoreItem {
    storeNumber: string;
    storeName: string;
    city: string;
    state: string;
    distance: string;
    reservationUrl: string;
    parts: Record<string, PartItem>;
  }

  interface HistoryRecord {
    id: string;
    timestamp: string;
    storeNumber: string;
    storeName: string;
    city: string;
    partNumber: string;
    productTitle: string;
    available: boolean;
    isRestock: boolean;
    reservationUrl: string;
    source?: string;
  }

  const STORAGE_KEY = 'apple_stock_history_14623';
  const STATE_KEY = 'apple_stock_last_state';
  const SOUND_KEY = 'apple_stock_sound_enabled';
  const NOTIFY_KEY = 'apple_stock_browser_notifications';
  const INTERVAL_KEY = 'apple_stock_autocheck_interval';
  const AUTOCHECK_KEY = 'apple_stock_autocheck_enabled';

  interface StoreGeo {
    id: string;
    name: string;
    city: string;
    dist: string;
    lat: number;
    lng: number;
  }

  const STORES_GEO: StoreGeo[] = [
    { id: 'R016', name: 'Walden Galleria', city: 'Buffalo, NY', dist: '57.4 mi', lat: 42.9135, lng: -78.7615 },
    { id: 'R140', name: 'Eastview', city: 'Victor / Rochester, NY', dist: '11.3 mi', lat: 43.0270, lng: -77.4410 },
    { id: 'R107', name: 'Syracuse', city: 'Destiny USA, Syracuse, NY', dist: '74.6 mi', lat: 43.0697, lng: -76.1722 },
  ];

  let mapInstance: any = null;
  let currentTileLayer: any = null;
  const mapMarkers: Record<string, any> = {};

  let autoRefreshTimer: number | null = null;
  let soundEnabled = false;
  let notifyEnabled = false;

  function getTileConfig(isDark: boolean) {
    // 100% free open tile sources with NO API key and NO watermarks
    if (isDark) {
      return {
        url: 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}',
        attribution: 'Tiles &copy; Esri &mdash; OpenStreetMap contributors',
        maxZoom: 16,
      };
    }
    return {
      url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors',
      maxZoom: 19,
    };
  }

  function initMap() {
    const mapEl = document.getElementById('stockMap');
    if (!mapEl) return;

    const L = (window as any).L;
    if (!L) {
      setTimeout(initMap, 150);
      return;
    }

    if (mapInstance) {
      mapInstance.remove();
      mapInstance = null;
      currentTileLayer = null;
      Object.keys(mapMarkers).forEach((k) => delete mapMarkers[k]);
    }

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const tileConfig = getTileConfig(isDark);

    mapInstance = L.map('stockMap', {
      zoomControl: true,
      scrollWheelZoom: false,
    });

    currentTileLayer = L.tileLayer(tileConfig.url, {
      attribution: tileConfig.attribution,
      maxZoom: tileConfig.maxZoom,
    }).addTo(mapInstance);

    mapInstance.fitBounds(
      [
        [42.75, -79.0],
        [43.25, -75.9],
      ],
      { padding: [35, 35] }
    );

    // Watch for theme toggle to swap tiles seamlessly
    const themeObserver = new MutationObserver(() => {
      if (!mapInstance || !(window as any).L) return;
      const nowDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const nextConfig = getTileConfig(nowDark);
      if (currentTileLayer) {
        mapInstance.removeLayer(currentTileLayer);
      }
      currentTileLayer = (window as any).L.tileLayer(nextConfig.url, {
        attribution: nextConfig.attribution,
        maxZoom: nextConfig.maxZoom,
      }).addTo(mapInstance);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Initial markers with current state from localStorage
    const prevStates: Record<string, boolean> = JSON.parse(localStorage.getItem(STATE_KEY) || '{}');
    const storeAvailMap: Record<string, boolean> = {};
    STORES_GEO.forEach((s) => {
      let hasStock = false;
      ['MK1F4LL/A', 'MK1G4LL/A', 'MK1H4LL/A'].forEach((sku) => {
        if (prevStates[`${s.id}:${sku}`]) hasStock = true;
      });
      storeAvailMap[s.id] = hasStock;
    });

    updateMapMarkers(storeAvailMap);
  }

  function updateMapMarkers(storeAvailMap: Record<string, boolean>) {
    const L = (window as any).L;
    if (!L || !mapInstance) return;

    STORES_GEO.forEach((store) => {
      const hasStock = Boolean(storeAvailMap[store.id]);
      const statusClass = hasStock ? 'map-ping--avail' : 'map-ping--out';

      const icon = L.divIcon({
        className: 'custom-map-icon',
        html: `
          <div class="map-marker-wrapper ${statusClass}">
            <div class="map-marker-pin">
              <span class="map-ping-ring"></span>
              <span class="map-ping-dot"></span>
            </div>
            <div class="map-marker-label">
              <span>Apple ${store.name}</span>
            </div>
          </div>
        `,
        iconSize: [120, 36],
        iconAnchor: [60, 10],
      });

      if (mapMarkers[store.id]) {
        mapMarkers[store.id].setIcon(icon);
      } else {
        const marker = L.marker([store.lat, store.lng], { icon }).addTo(mapInstance);
        marker.bindPopup(`
          <div class="map-popup-card">
            <h4 style="margin:0 0 0.25rem;font-size:0.95rem;color:var(--color-text,#1e293b);">Apple ${store.name}</h4>
            <div style="font-size:0.8125rem;color:var(--color-text-secondary,#64748b);margin-bottom:0.4rem;">${store.city} · ${store.dist} away</div>
            <div style="font-size:0.8125rem;font-weight:700;color:${hasStock ? '#10b981' : '#ef4444'};margin-bottom:0.6rem;">
              ${hasStock ? '● Units available for pickup' : '○ Currently out of stock'}
            </div>
            <a href="#store-card-${store.id}" style="display:inline-block;font-size:0.75rem;font-weight:600;padding:0.35rem 0.65rem;background:#0284c7;color:#fff;text-decoration:none;border-radius:4px;">
              View Stock Cards ↓
            </a>
          </div>
        `);
        mapMarkers[store.id] = marker;
      }
    });
  }

  function initTracker() {
    const checkBtn = document.getElementById('checkNowBtn');
    const autoToggle = document.getElementById('autoRefreshToggle') as HTMLInputElement | null;
    const intervalSelect = document.getElementById('autoRefreshIntervalSelect') as HTMLSelectElement | null;
    const soundBtn = document.getElementById('soundToggleBtn');
    const notifyBtn = document.getElementById('notifyToggleBtn');
    const filterSelect = document.getElementById('historyFilterSelect') as HTMLSelectElement | null;
    const exportBtn = document.getElementById('exportHistoryBtn');
    const clearBtn = document.getElementById('clearHistoryBtn');

    if (!checkBtn) return;

    // Load sound preference
    soundEnabled = localStorage.getItem(SOUND_KEY) === 'true';
    updateSoundButtonState();

    // Load browser notifications preference
    notifyEnabled = localStorage.getItem(NOTIFY_KEY) === 'true';
    updateNotifyButtonState();

    // Load interval preference
    const savedInterval = localStorage.getItem(INTERVAL_KEY);
    if (savedInterval && intervalSelect) {
      intervalSelect.value = savedInterval;
    }

    // Load auto-check preference
    const savedAutocheck = localStorage.getItem(AUTOCHECK_KEY);
    if (savedAutocheck === 'true' && autoToggle) {
      autoToggle.checked = true;
      restartAutoCheck();
    }

    // Load initial history
    renderHistoryTable();
    updateStatSummary();

    // Event listeners
    checkBtn.addEventListener('click', () => {
      performStockCheck();
    });

    if (autoToggle) {
      autoToggle.addEventListener('change', () => {
        localStorage.setItem(AUTOCHECK_KEY, String(autoToggle.checked));
        restartAutoCheck();
      });
    }

    if (intervalSelect) {
      intervalSelect.addEventListener('change', () => {
        localStorage.setItem(INTERVAL_KEY, intervalSelect.value);
        if (autoToggle && autoToggle.checked) {
          restartAutoCheck();
        }
      });
    }

    if (soundBtn) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        localStorage.setItem(SOUND_KEY, String(soundEnabled));
        updateSoundButtonState();
        if (soundEnabled) playChime();
      });
    }

    if (notifyBtn) {
      notifyBtn.addEventListener('click', async () => {
        if (!('Notification' in window)) {
          alert('Desktop notifications are not supported by this browser.');
          return;
        }

        if (Notification.permission === 'denied') {
          alert('Browser alerts are currently blocked in your browser site permissions. Please allow notifications for this site in your address bar icon.');
          updateNotifyButtonState();
          return;
        }

        if (Notification.permission === 'default') {
          const res = await Notification.requestPermission();
          if (res === 'granted') {
            notifyEnabled = true;
            localStorage.setItem(NOTIFY_KEY, 'true');
            sendBrowserNotification('Alerts Enabled', 'You will receive immediate alerts when iPhone Duo is in stock near 14623.');
          } else {
            notifyEnabled = false;
            localStorage.setItem(NOTIFY_KEY, 'false');
          }
          updateNotifyButtonState();
          return;
        }

        // Permission is already granted, toggle on/off
        notifyEnabled = !notifyEnabled;
        localStorage.setItem(NOTIFY_KEY, String(notifyEnabled));
        updateNotifyButtonState();
        if (notifyEnabled) {
          sendBrowserNotification('Alerts Active', 'Browser restock alerts are enabled.');
        }
      });
    }

    if (filterSelect) {
      filterSelect.addEventListener('change', () => {
        renderHistoryTable();
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', exportHistoryData);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Clear local restock history log?')) {
          localStorage.removeItem(STORAGE_KEY);
          localStorage.removeItem(STATE_KEY);
          renderHistoryTable();
          updateStatSummary();
        }
      });
    }

    // Initialize interactive regional map
    initMap();

    // Run initial stock check on load
    performStockCheck();
  }

  function restartAutoCheck() {
    if (autoRefreshTimer) {
      clearInterval(autoRefreshTimer);
      autoRefreshTimer = null;
    }
    const autoToggle = document.getElementById('autoRefreshToggle') as HTMLInputElement | null;
    const intervalSelect = document.getElementById('autoRefreshIntervalSelect') as HTMLSelectElement | null;
    if (autoToggle && autoToggle.checked) {
      const ms = Number(intervalSelect?.value) || 1800000;
      autoRefreshTimer = window.setInterval(() => {
        performStockCheck();
      }, ms);
    }
  }

  function updateNotifyButtonState() {
    const btn = document.getElementById('notifyToggleBtn');
    const label = document.getElementById('notifyToggleLabel');
    if (!btn || !label) return;

    if (!('Notification' in window)) {
      label.textContent = 'Alerts: N/A';
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.add('notify-blocked');
      btn.title = 'Desktop notifications are not supported in this browser';
      return;
    }

    if (Notification.permission === 'denied') {
      label.textContent = 'Alerts: Blocked';
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('notify-active');
      btn.classList.add('notify-blocked');
      btn.title = 'Notifications are blocked in your browser site permissions';
      return;
    }

    btn.classList.remove('notify-blocked');
    if (Notification.permission === 'granted' && notifyEnabled) {
      label.textContent = 'Alerts: On';
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.add('notify-active');
      btn.title = 'Browser restock notifications enabled';
    } else {
      label.textContent = 'Alerts: Off';
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('notify-active');
      btn.title = 'Click to enable desktop notifications for restocks';
    }
  }

  function sendBrowserNotification(title: string, body: string, url?: string) {
    if (!('Notification' in window)) return;
    if (Notification.permission !== 'granted' || !notifyEnabled) return;
    try {
      const notif = new Notification(title, {
        body,
        icon: '/favicon-48x48.png',
        tag: `apple-stock-restock-${Date.now()}`,
      });
      if (url) {
        notif.onclick = () => {
          window.focus();
          window.open(url, '_blank');
          notif.close();
        };
      }
    } catch (e) {
      console.warn('Could not display browser notification:', e);
    }
  }

  function updateSoundButtonState() {
    const btn = document.getElementById('soundToggleBtn');
    const label = document.getElementById('soundToggleLabel');
    if (!btn || !label) return;
    btn.setAttribute('aria-pressed', String(soundEnabled));
    label.textContent = soundEnabled ? 'Chime: On' : 'Chime: Off';
    btn.classList.toggle('sound-active', soundEnabled);
  }

  function playChime() {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
      osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1); // A5
      gain.gain.setValueAtTime(0.15, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.4);
    } catch {
      // AudioContext unavailable or blocked
    }
  }

  async function performStockCheck() {
    const refreshIcon = document.getElementById('refreshIcon');
    const statusText = document.getElementById('monitorStatusText');
    const lastChecked = document.getElementById('lastCheckedText');
    const pulse = document.getElementById('pulseIndicator');
    const checkBtn = document.getElementById('checkNowBtn') as HTMLButtonElement | null;

    if (refreshIcon) refreshIcon.classList.add('is-spinning');
    if (statusText) statusText.textContent = 'Querying Apple Store API...';
    if (pulse) pulse.className = 'pulse-indicator pulse-indicator--active';
    if (checkBtn) checkBtn.disabled = true;

    try {
      const res = await fetch('/api/stock?zip=14623');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (data.status === 'ok' && Array.isArray(data.stores)) {
        processStoreData(data.stores, data.history);
        const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        if (lastChecked) lastChecked.textContent = `Last checked: ${nowStr}`;
        if (statusText) statusText.textContent = data.d1Active ? 'Monitoring active · D1 Synced' : 'Monitoring active';
        if (pulse) pulse.className = 'pulse-indicator pulse-indicator--healthy';
      } else {
        throw new Error(data.error || 'Invalid API response');
      }
    } catch (err: any) {
      if (statusText) statusText.textContent = 'Check failed (will retry)';
      if (pulse) pulse.className = 'pulse-indicator pulse-indicator--error';
      console.warn('Apple stock query failed:', err);
    } finally {
      if (refreshIcon) refreshIcon.classList.remove('is-spinning');
      if (checkBtn) checkBtn.disabled = false;
    }
  }

  function processStoreData(stores: StoreItem[], d1History?: any[]) {
    const prevStates: Record<string, boolean> = JSON.parse(localStorage.getItem(STATE_KEY) || '{}');
    const currentStates: Record<string, boolean> = {};
    const newHistoryRecords: HistoryRecord[] = [];
    let anyRestockDetected = false;
    let totalInStockCount = 0;

    stores.forEach((store) => {
      const storeCard = document.getElementById(`store-card-${store.storeNumber}`);
      const storePill = document.getElementById(`store-pill-${store.storeNumber}`);
      let storeHasStock = false;

      Object.entries(store.parts).forEach(([sku, partInfo]) => {
        const cleanSku = sku.replace(/[^a-zA-Z0-9]/g, '');
        const chip = document.getElementById(`chip-${store.storeNumber}-${cleanSku}`);
        const stateKey = `${store.storeNumber}:${sku}`;
        const isAvailable = partInfo.available;
        const wasAvailable = Boolean(prevStates[stateKey]);

        currentStates[stateKey] = isAvailable;

        if (isAvailable) {
          storeHasStock = true;
          totalInStockCount++;
        }

        if (chip) {
          chip.textContent = isAvailable ? 'Available for Pickup' : 'Unavailable';
          chip.className = `status-chip ${isAvailable ? 'status-chip--success' : 'status-chip--neutral'}`;
        }

        // Detect restock transition (was out of stock, now in stock)
        const isRestock = isAvailable && !wasAvailable;
        if (isRestock) {
          anyRestockDetected = true;
        }

        // Add history entry if state changed OR if in stock
        if (isRestock || isAvailable) {
          newHistoryRecords.push({
            id: `${Date.now()}-${store.storeNumber}-${cleanSku}`,
            timestamp: new Date().toISOString(),
            storeNumber: store.storeNumber,
            storeName: store.storeName,
            city: store.city,
            partNumber: sku,
            productTitle: partInfo.title,
            available: isAvailable,
            isRestock,
            reservationUrl: store.reservationUrl,
            source: 'Live Check',
          });
        }
      });

      if (storePill) {
        storePill.textContent = storeHasStock ? 'Stock Available!' : 'Out of Stock';
        storePill.className = `status-pill ${storeHasStock ? 'status-pill--success' : 'status-pill--muted'}`;
      }

      if (storeCard) {
        storeCard.classList.toggle('has-stock', storeHasStock);
      }
    });

    // Update map markers with live store availability
    const storeAvailMap: Record<string, boolean> = {};
    stores.forEach((store) => {
      let storeHasStock = false;
      Object.values(store.parts).forEach((part) => {
        if (part.available) storeHasStock = true;
      });
      storeAvailMap[store.storeNumber] = storeHasStock;
    });
    updateMapMarkers(storeAvailMap);

    // Save states
    localStorage.setItem(STATE_KEY, JSON.stringify(currentStates));

    // Map D1 history entries
    const d1Mapped: HistoryRecord[] = Array.isArray(d1History)
      ? d1History.map((dh: any) => ({
          id: `d1-${dh.id || dh.timestamp}-${dh.store_number}-${dh.part_number}`,
          timestamp: dh.timestamp,
          storeNumber: dh.store_number,
          storeName: dh.store_name,
          city: dh.store_name,
          partNumber: dh.part_number,
          productTitle: dh.product_title,
          available: Boolean(dh.is_available),
          isRestock: Boolean(dh.is_restock),
          reservationUrl: dh.reservation_url || 'https://www.apple.com/shop/buy-iphone',
          source: 'D1 Sync',
        }))
      : [];

    // Save history entries & merge with D1 entries
    const existingHistory: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    const combined = [...newHistoryRecords, ...d1Mapped, ...existingHistory];
    const seen = new Set<string>();
    const deduplicatedHistory: HistoryRecord[] = [];

    for (const record of combined) {
      const timeMinute = (record.timestamp || '').slice(0, 16);
      const key = `${record.storeNumber}:${record.partNumber}:${record.isRestock ? '1' : '0'}:${timeMinute}`;
      if (!seen.has(key)) {
        seen.add(key);
        deduplicatedHistory.push(record);
      }
    }

    deduplicatedHistory.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
    const finalHistory = deduplicatedHistory.slice(0, 120);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(finalHistory));
    renderHistoryTable();

    // Play sound and dispatch browser notifications if restock occurred
    if (anyRestockDetected) {
      if (soundEnabled) {
        playChime();
      }
      if (notifyEnabled) {
        const restocked = newHistoryRecords.filter((r) => r.isRestock);
        if (restocked.length > 0) {
          const first = restocked[0];
          const summary = restocked.length > 1
            ? `${first.productTitle} + ${restocked.length - 1} more models are available at Apple ${first.storeName}!`
            : `${first.productTitle} is available at Apple ${first.storeName}! Click to reserve.`;
          sendBrowserNotification('🚨 Apple Store Restock Alert!', summary, first.reservationUrl);
        }
      }
    }

    updateStatSummary(totalInStockCount);
  }

  function updateStatSummary(inStockCount?: number) {
    const inStockEl = document.getElementById('statInStockCount');
    const inStockSub = document.getElementById('statInStockSub');
    const restocksEl = document.getElementById('statRestocksCount');

    const history: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    const restockEvents = history.filter((h) => h.isRestock).length;

    if (inStockEl && typeof inStockCount === 'number') {
      inStockEl.textContent = String(inStockCount);
      if (inStockSub) {
        inStockSub.textContent = inStockCount > 0 ? `${inStockCount} models ready for pickup` : 'None currently available';
      }
    }

    if (restocksEl) {
      restocksEl.textContent = String(restockEvents);
    }
  }

  function renderHistoryTable() {
    const tbody = document.getElementById('historyTableBody');
    const filterSelect = document.getElementById('historyFilterSelect') as HTMLSelectElement | null;
    if (!tbody) return;

    const history: HistoryRecord[] = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    const filter = filterSelect ? filterSelect.value : 'all';

    const filtered = history.filter((item) => {
      if (filter === 'all') return true;
      if (filter === 'restock') return item.isRestock;
      return item.storeNumber === filter;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr class="empty-row">
          <td colspan="5">No matching entries in history. Checks are logged as stock updates occur.</td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered
      .map((item) => {
        const time = new Date(item.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const date = new Date(item.timestamp).toLocaleDateString([], { month: 'short', day: 'numeric' });
        const badgeClass = item.isRestock
          ? 'table-pill table-pill--restock'
          : item.available
            ? 'table-pill table-pill--avail'
            : 'table-pill table-pill--out';
        const badgeText = item.isRestock ? 'RESTOCKED!' : item.available ? 'In Stock' : 'Out of Stock';

        return `
          <tr class="${item.isRestock ? 'highlight-row' : ''}">
            <td class="cell-time">
              <span class="time-main">${time}</span>
              <span class="time-sub">${date}</span>
            </td>
            <td class="cell-store">
              <strong>Apple ${escapeHtml(item.storeName)}</strong>
              <span class="store-code">(${item.storeNumber})</span>
            </td>
            <td class="cell-product">
              <span class="product-title">${escapeHtml(item.productTitle)}</span>
              <span class="product-sku">${escapeHtml(item.partNumber)}</span>
            </td>
            <td class="cell-status">
              <span class="${badgeClass}">${badgeText}</span>
            </td>
            <td class="cell-action">
              <a href="${item.reservationUrl}" target="_blank" rel="noopener noreferrer" class="table-link">
                Reserve ↗
              </a>
            </td>
          </tr>
        `;
      })
      .join('');
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function exportHistoryData() {
    const history = localStorage.getItem(STORAGE_KEY) || '[]';
    const blob = new Blob([history], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `apple-stock-history-14623-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  document.addEventListener('astro:page-load', initTracker);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTracker, { once: true });
  } else {
    initTracker();
  }
</script>

