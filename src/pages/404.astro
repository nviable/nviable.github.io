---
/**
 * 404 Not Found Page
 * 
 * Custom error page displayed when a requested page doesn't exist.
 * Features a minimal, centered layout with an icon, message, and
 * navigation back to the homepage.
 * 
 * Design:
 * - No header, navigation, or footer for focused experience
 * - Centered content with SVG icon
 * - Clear messaging about the error
 * - Single CTA button to return home
 * 
 * Route: /404 (automatically served for non-existent pages)
 * 
 * @page
 */

import CircleAlert from '@lucide/astro/icons/circle-alert';
import { siteConfig } from '../config';

const pageTitle = '404 - Page Not Found';
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Inline critical styles -->
    <style>
      :root {
        /* Colors - Dark theme */
        --color-bg: #0a0a0a;
        --color-text: #e5e5e5;
        --color-text-secondary: #a3a3a3;
        --color-text-muted: #737373;
        --color-accent: #7E84D0;
        --color-accent-hover: #B9BDFF;
        --color-on-primary: #0a0a0a;
        --color-primary-edge: #43489C;
        --color-primary-fill-hover: #B9BDFF;
      }

      [data-theme="light"] {
        --color-bg: #ffffff;
        --color-text: #171717;
        --color-text-secondary: #525252;
        --color-text-muted: #737373;
        --color-accent: #43489C;
        --color-accent-hover: #32368A;
        --color-on-primary: #ffffff;
        --color-primary-edge: #32368A;
        --color-primary-fill-hover: #5A60B8;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }

      .container {
        max-width: 500px;
        width: 100%;
        text-align: center;
      }

      .icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 2rem;
        color: var(--color-text-muted);
        opacity: 0.6;
      }

      .error-code {
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        color: var(--color-text);
      }

      .description {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
      }

      .home-button {
        --btn-lip: 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.25rem;
        background: var(--color-accent);
        color: var(--color-on-primary);
        font-weight: 600;
        font-size: 0.9375rem;
        line-height: 1.2;
        text-decoration: none;
        border: 1px solid var(--color-primary-edge);
        border-bottom-width: var(--btn-lip);
        transition:
          transform 150ms ease,
          background-color 200ms ease,
          border-color 200ms ease;
      }

      .home-button:hover {
        background: var(--color-primary-fill-hover);
        color: var(--color-on-primary);
      }

      .home-button:active {
        border-bottom-width: 0;
        padding-bottom: calc(0.7rem + var(--btn-lip));
        transform: translateY(var(--btn-lip));
      }

      @media (max-width: 640px) {
        .icon {
          width: 64px;
          height: 64px;
          margin-bottom: 1.5rem;
        }

        .error-code {
          font-size: 0.875rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .description {
          font-size: 1rem;
          margin-bottom: 2rem;
        }

        .home-button {
          padding: 0.75rem 1.75rem;
          font-size: 0.9375rem;
        }
      }
    </style>

    <!-- Theme initialization script -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <!-- 404 Icon -->
      <CircleAlert class="icon" size={80} stroke-width={2} aria-hidden="true" />

      <div class="error-code">404 Error</div>
      
      <h1>Page Not Found</h1>
      
      <p class="description">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>

      <a href="/" class="home-button btn-primary">Back to Home</a>
    </div>
  </body>
</html>
