---
/**
 * Publications index — Figma design language:
 * - Full-bleed Indigo Hero (#282b61) with stats and Google Scholar CTA
 * - Full-bleed Yellow Band (#f6eb0f) with interactive group & tag filters
 * - Rounded paper blocks (PublicationCards.astro) matching the homepage
 * Route: /publications
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import PublicationCards from '../../components/PublicationCards.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';
import { siteConfig } from '../../config';

const allPublications = await getCollection('publications');

const byYear = (a: (typeof allPublications)[number], b: (typeof allPublications)[number]) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 999) - (b.data.order ?? 999);
};

const isUnpublished = (status: string | undefined) =>
  status === 'underReview' || status === 'inSubmission' || status === 'inPreparation';

const published = allPublications.filter((entry) => !isUnpublished(entry.data.status));

function publicationGroup(entry: (typeof published)[number]): 'earlier' | 'selected' | 'other' {
  if (entry.data.venue.toLowerCase().includes('icdim') || entry.data.year <= 2014) {
    return 'earlier';
  }
  const venue = entry.data.venue.toLowerCase();
  const selected =
    venue.includes('chi') ||
    venue.includes('ccs') ||
    entry.data.kind === 'journal' ||
    entry.data.kind === 'dissertation' ||
    entry.data.kind === 'bookChapter';
  return selected ? 'selected' : 'other';
}

const groups: { id: string; heading: string; items: typeof published }[] = [
  { id: 'selected', heading: 'Selected work', items: [] },
  { id: 'other', heading: 'Other publications', items: [] },
  { id: 'earlier', heading: 'Earlier work', items: [] },
];

for (const entry of published) {
  const group = groups.find((g) => g.id === publicationGroup(entry));
  group?.items.push(entry);
}
for (const group of groups) group.items.sort(byYear);

const total = published.length;
const selectedCount = groups.find((g) => g.id === 'selected')?.items.length ?? 0;

// Collect top research tags across published papers for the yellow band
const tagFrequency = new Map<string, number>();
for (const entry of published) {
  for (const tag of entry.data.tags ?? []) {
    const key = tag.toLowerCase();
    tagFrequency.set(key, (tagFrequency.get(key) ?? 0) + 1);
  }
}
const topTags = [...tagFrequency.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([tag]) => tag);
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.publications.title}
    description={pagesConfig.publications.description}
    type="website"
    image="/og/publications.png"
  />

  <StructuredData
    type="PublicationList"
    data={{
      publications: published.map((entry) => entry.data),
    }}
  />

  <main class="pubs-full-page">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. PURPLE INDIGO HERO
         ════════════════════════════════════════════════════════════════════════ -->
    <header class="indigo-hero">
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="350"
        height="196"
        class="indigo-hero__corner indigo-hero__corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="368"
        height="219"
        class="indigo-hero__corner indigo-hero__corner--br"
        aria-hidden="true"
      />

      <div class="indigo-hero__inner">
        <div class="indigo-hero__title-row">
          <div>
            <p class="indigo-hero__eyebrow">Peer-Reviewed Research &amp; Dissertation</p>
            <h1 class="indigo-hero__title">{pagesConfig.publications.heading}</h1>
          </div>

          {siteConfig.social.scholar && (
            <a
              href={siteConfig.social.scholar}
              target="_blank"
              rel="noopener noreferrer"
              class="figma-yellow-btn"
            >
              <span>Google Scholar</span>
              <ArrowUpRight size={15} stroke-width={2.25} aria-hidden="true" />
            </a>
          )}
        </div>

        <p class="indigo-hero__lead">{pagesConfig.publications.intro}</p>

        <div class="indigo-hero__stats" aria-label="Publication statistics">
          <span class="indigo-hero__stat-pill">
            <strong>{total}</strong> publications
          </span>
          <span class="indigo-hero__stat-pill">
            <strong>{selectedCount}</strong> selected top-tier &amp; archival
          </span>
          <span class="indigo-hero__stat-pill">
            <strong>414+</strong> citations
          </span>
        </div>
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. YELLOW BAND FILTER & TAG BAR
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="yellow-band" role="toolbar" aria-label="Filter publications by topic">
      <div class="yellow-band__inner">
        <div class="yellow-band__group" id="pub-tag-filters">
          <span class="yellow-band__label">Topic:</span>
          <button
            type="button"
            class="yellow-band__pill is-active"
            data-pub-filter="all"
            aria-pressed="true"
          >
            All ({total})
          </button>
          {topTags.map((tag) => (
            <button
              type="button"
              class="yellow-band__pill"
              data-pub-filter={tag}
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
        </div>

        <div class="yellow-band__group">
          {groups
            .filter((g) => g.items.length > 0)
            .map((g) => (
              <a href={`#pub-group-${g.id}`} class="yellow-band__pill">
                {g.heading}
              </a>
            ))}
        </div>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. ROUNDED PUBLICATION CARDS
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="pubs-body-container">
      {total > 0 ? (
        groups
          .filter((group) => group.items.length > 0)
          .map((group) => (
            <section
              class="pubs-section-group"
              data-pub-group-section
              aria-labelledby={`pub-group-${group.id}`}
            >
              <div class="pubs-section-group__header">
                <h2 id={`pub-group-${group.id}`} class="pubs-section-group__heading">
                  {group.heading}
                </h2>
                <span class="pubs-section-group__count">{group.items.length}</span>
              </div>
              <PublicationCards entries={group.items.map((entry) => entry.data)} columns={2} />
            </section>
          ))
      ) : (
        <p class="empty-state">No publications listed yet.</p>
      )}
    </div>
  </main>

  <script>
    function initPublicationsFilter() {
      const filterRoot = document.getElementById('pub-tag-filters');
      if (!filterRoot || filterRoot.dataset.bound === '1') return;
      filterRoot.dataset.bound = '1';

      const buttons = Array.from(
        filterRoot.querySelectorAll<HTMLButtonElement>('[data-pub-filter]')
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-pub-group-section]')
      );

      filterRoot.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest<HTMLButtonElement>('[data-pub-filter]');
        if (!btn) return;

        const activeTag = (btn.dataset.pubFilter || 'all').toLowerCase();
        buttons.forEach((b) => {
          const isOn = b === btn;
          b.classList.toggle('is-active', isOn);
          b.setAttribute('aria-pressed', isOn ? 'true' : 'false');
        });

        sections.forEach((section) => {
          const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-pub-card]'));
          let visibleInGroup = 0;
          cards.forEach((card) => {
            const tags = (card.dataset.pubTags || '').split('|').filter(Boolean);
            const match = activeTag === 'all' || tags.includes(activeTag);
            card.hidden = !match;
            if (match) visibleInGroup++;
          });
          section.hidden = visibleInGroup === 0;
        });
      });
    }

    document.addEventListener('astro:page-load', initPublicationsFilter);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPublicationsFilter, { once: true });
    } else {
      initPublicationsFilter();
    }
  </script>

  <style>
    .pubs-full-page {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .pubs-body-container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    .pubs-section-group + .pubs-section-group {
      margin-top: 3rem;
    }

    .pubs-section-group[hidden] {
      display: none !important;
    }

    .pubs-section-group :global([data-pub-card][hidden]) {
      display: none !important;
    }

    .pubs-section-group__header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.15rem;
    }

    .pubs-section-group__heading {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      text-transform: none;
      letter-spacing: -0.015em;
      color: var(--color-brand-heading, var(--color-text));
    }

    .pubs-section-group__count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.65rem;
      height: 1.5rem;
      padding: 0 0.45rem;
      border-radius: 999px;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-muted);
    }

    @media (max-width: 768px) {
      .pubs-body-container {
        padding: 1.75rem 1rem 3rem;
      }
    }
  </style>
</BaseLayout>
