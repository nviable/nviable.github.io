---
/**
 * Latest (Journey & speaking) — merged timeline with:
 * - Full-bleed Indigo Hero (#282b61)
 * - Full-bleed Yellow Band (#f6eb0f) housing the category filters
 * - Expandable timeline items + load-more batches
 * Route: /journey
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import TimelineListItem from '../components/TimelineListItem.astro';
import { getCollection, render } from 'astro:content';
import { pagesConfig } from '../pages.config';

const PAGE_SIZE = 10;

const categoryLabels: Record<string, string> = {
  all: 'All',
  conference: 'Conference',
  teaching: 'Teaching',
  milestone: 'Milestone',
  media: 'Media',
  engagement: 'Engagement',
};

/** Display order for the filter bar (most-requested first). */
const CATEGORY_ORDER = ['conference', 'media', 'teaching', 'engagement', 'milestone'];

const allJourney = await getCollection('journey');
const allSpeaking = await getCollection('speaking');

const journeyBlocks = await Promise.all(
  allJourney.map(async (entry) => {
    const { Content } = await render(entry);
    const hasContent = Boolean(entry.body && entry.body.trim().length > 0);
    return {
      kind: 'journey' as const,
      id: entry.id,
      category: entry.data.type,
      date: entry.data.date,
      entry,
      Content,
      hasContent,
    };
  })
);

const speakingBlocks = await Promise.all(
  allSpeaking.map(async (entry) => {
    const { Content } = await render(entry);
    const hasContent = Boolean(entry.body && entry.body.trim().length > 0);
    return {
      kind: 'speaking' as const,
      id: entry.id,
      category: entry.data.type,
      date: entry.data.date,
      entry,
      Content,
      hasContent,
    };
  })
);

type Block = (typeof journeyBlocks)[number] | (typeof speakingBlocks)[number];

const merged: Block[] = [...journeyBlocks, ...speakingBlocks].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

const usedCategories = [...new Set(merged.map((m) => m.category))].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b)
);
const filterOptions = [
  { value: 'all', label: 'All' },
  ...usedCategories.map((c) => ({ value: c, label: categoryLabels[c] ?? c })),
];

const journeyCount = journeyBlocks.length;
const speakingCount = speakingBlocks.length;
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.journey.title}
    description={pagesConfig.journey.description}
    type="website"
    image="/og/journey.png"
  />

  <main class="journey-full-page">
    <!-- ════════════════════════════════════════════════════════════════════════
         1. PURPLE INDIGO HERO
         ════════════════════════════════════════════════════════════════════════ -->
    <header class="indigo-hero">
      <img
        src="/images/figma/bck-corner-tl.svg"
        alt=""
        width="350"
        height="196"
        class="indigo-hero__corner indigo-hero__corner--tl"
        aria-hidden="true"
      />
      <img
        src="/images/figma/bck-corner-br.svg"
        alt=""
        width="368"
        height="219"
        class="indigo-hero__corner indigo-hero__corner--br"
        aria-hidden="true"
      />

      <div class="indigo-hero__inner">
        <p class="indigo-hero__eyebrow">Timeline &amp; Updates</p>
        <h1 class="indigo-hero__title">{pagesConfig.journey.heading}</h1>
        <p class="indigo-hero__lead">{pagesConfig.journey.intro}</p>

        <div class="indigo-hero__stats" aria-label="Timeline statistics">
          <span class="indigo-hero__stat-pill">
            <strong>{merged.length}</strong> total entries
          </span>
          <span class="indigo-hero__stat-pill">
            <strong>{journeyCount}</strong> career milestones
          </span>
          <span class="indigo-hero__stat-pill">
            <strong>{speakingCount}</strong> talks &amp; press
          </span>
        </div>
      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════════════════════
         2. YELLOW BAND FILTER TOOLBAR
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="yellow-band" role="toolbar" aria-label="Filter timeline by category">
      <div class="yellow-band__inner">
        <div class="yellow-band__group" id="timeline-filters">
          <span class="yellow-band__label">Filter:</span>
          {filterOptions.map(({ value, label }) => (
            <button
              type="button"
              class:list={['yellow-band__pill', 'timeline-filter', value === 'all' && 'is-active']}
              data-category={value}
              aria-pressed={value === 'all' ? 'true' : 'false'}
            >
              {label}
            </button>
          ))}
        </div>

        <span class="yellow-band__label" id="timeline-filter-count" aria-live="polite">
          Showing {Math.min(PAGE_SIZE, merged.length)} of {merged.length}
        </span>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════
         3. TIMELINE CONTENT
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="page-container journey-content">
      {merged.length === 0 ? (
        <p class="empty-state">
          No timeline entries yet. Add content under <code>src/content/journey/</code> or{' '}
          <code>src/content/speaking/</code>.
        </p>
      ) : (
        <>
          <div class="timeline-list" id="timeline-list" data-page-size={PAGE_SIZE}>
            {merged.map((item, index) => {
              const isLast = index === merged.length - 1;
              if (item.kind === 'journey') {
                const JourneyBody = item.Content;
                return (
                  <div
                    class="timeline-slot"
                    data-timeline-item
                    data-category={item.category}
                    data-source={item.kind}
                    hidden={index >= PAGE_SIZE}
                  >
                    <TimelineListItem
                      itemId={`journey-${item.id}`}
                      date={item.entry.data.date}
                      category={item.category}
                      title={item.entry.data.title}
                      description={item.entry.data.description}
                      isLast={isLast}
                      skills={item.entry.data.skills}
                      hasExpandable={item.hasContent}
                      event={item.entry.data.event}
                      url={item.entry.data.url}
                      location={item.entry.data.location}
                      duration={item.entry.data.duration}
                      topics={item.entry.data.topics}
                      slides={item.entry.data.slides}
                      video={item.entry.data.video}
                      featured={item.entry.data.featured}
                      relatedPresentation={item.entry.data.relatedPresentation}
                      relatedPaper={item.entry.data.relatedPaper}
                      relatedArticle={item.entry.data.relatedArticle}
                    >
                      {item.hasContent && <JourneyBody />}
                    </TimelineListItem>
                  </div>
                );
              }
              const SpeakingBody = item.Content;
              return (
                <div
                  class="timeline-slot"
                  data-timeline-item
                  data-category={item.category}
                  data-source={item.kind}
                  hidden={index >= PAGE_SIZE}
                >
                  <TimelineListItem
                    itemId={`speaking-${item.id}`}
                    date={item.entry.data.date}
                    category={item.category}
                    title={item.entry.data.title}
                    description={item.entry.data.description}
                    isLast={isLast}
                    event={item.entry.data.event}
                    url={item.entry.data.url}
                    location={item.entry.data.location}
                    duration={item.entry.data.duration}
                    topics={item.entry.data.topics}
                    slides={item.entry.data.slides}
                    video={item.entry.data.video}
                    featured={item.entry.data.featured}
                    relatedPresentation={item.entry.data.relatedPresentation}
                    relatedPaper={item.entry.data.relatedPaper}
                    relatedArticle={item.entry.data.relatedArticle}
                    hasExpandable={item.hasContent}
                  >
                    {item.hasContent && <SpeakingBody />}
                  </TimelineListItem>
                </div>
              );
            })}
          </div>

          <div class="timeline-load-wrap">
            <button
              type="button"
              class="figma-yellow-btn timeline-load-more"
              id="timeline-load-more"
              hidden
            >
              Load 10 more
            </button>
            <p class="timeline-end-note" id="timeline-end-note" hidden>
              Showing all entries for this filter.
            </p>
          </div>
        </>
      )}
    </div>
  </main>

  <script>
    function initTimeline() {
      const list = document.getElementById('timeline-list');
      const loadBtn = document.getElementById('timeline-load-more');
      const endNote = document.getElementById('timeline-end-note');
      const filterRoot = document.getElementById('timeline-filters');
      const countEl = document.getElementById('timeline-filter-count');
      if (!list || !loadBtn || !filterRoot || !endNote) return;

      const pageSize = Number(list.getAttribute('data-page-size')) || 10;

      const slots = () =>
        Array.from(list.querySelectorAll<HTMLElement>('[data-timeline-item]'));

      const validCategories = Array.from(
        filterRoot.querySelectorAll('.timeline-filter')
      ).map((b) => b.getAttribute('data-category') || 'all');

      function readFilterFromUrl() {
        const requested = new URLSearchParams(window.location.search).get('filter');
        return requested && validCategories.includes(requested) ? requested : 'all';
      }

      function syncUrl(value: string) {
        const url = new URL(window.location.href);
        if (value && value !== 'all') {
          url.searchParams.set('filter', value);
        } else {
          url.searchParams.delete('filter');
        }
        window.history.replaceState({}, '', url);
      }

      let filter = readFilterFromUrl();
      let visibleCount = pageSize;

      function matching() {
        return slots().filter((s) => {
          if (filter === 'all') return true;
          return s.getAttribute('data-category') === filter;
        });
      }

      function apply() {
        const m = matching();
        const show = Math.min(visibleCount, m.length);
        slots().forEach((s) => {
          s.hidden = true;
        });
        for (let i = 0; i < show; i++) {
          m[i].hidden = false;
        }
        const moreLeft = m.length > show;
        loadBtn!.hidden = !moreLeft;
        endNote!.hidden = moreLeft || m.length === 0;

        if (countEl) {
          countEl.textContent = `Showing ${show} of ${m.length}`;
        }

        filterRoot!.querySelectorAll('.timeline-filter').forEach((btn) => {
          const cat = btn.getAttribute('data-category');
          const isOn = cat === filter;
          btn.classList.toggle('is-active', isOn);
          btn.setAttribute('aria-pressed', isOn ? 'true' : 'false');
        });
      }

      if (list.dataset.timelineBound !== '1') {
        list.dataset.timelineBound = '1';

        filterRoot.addEventListener('click', (e) => {
          const el = e.target;
          if (!(el instanceof Element)) return;
          const t = el.closest('.timeline-filter');
          if (!t || !filterRoot.contains(t)) return;
          const cat = t.getAttribute('data-category') || 'all';
          filter = cat;
          visibleCount = pageSize;
          syncUrl(filter);
          apply();
        });

        loadBtn.addEventListener('click', () => {
          visibleCount += pageSize;
          apply();
        });

        window.addEventListener('popstate', () => {
          if (!document.body.contains(list)) return;
          filter = readFilterFromUrl();
          visibleCount = pageSize;
          apply();
        });
      }

      apply();
    }

    document.addEventListener('astro:page-load', initTimeline);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTimeline, { once: true });
    } else {
      initTimeline();
    }
  </script>

  <style>
    .journey-full-page {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .journey-content {
      max-width: 880px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.5rem;
    }

    .timeline-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-top: 0.25rem;
    }

    .timeline-slot[data-timeline-item][hidden] {
      display: none !important;
    }

    .timeline-load-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      margin: 2rem 0 1rem;
    }

    .timeline-load-more[hidden] {
      display: none;
    }

    .timeline-end-note {
      margin: 0;
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }

    .empty-state code {
      font-size: 0.85em;
    }
  </style>
</BaseLayout>
