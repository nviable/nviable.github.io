---
/**
 * RelatedContent Component
 *
 * Displays related projects and publications for cross-referencing content
 * using the unified Figma rounded card design language.
 */

import { getCollection } from 'astro:content';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PublicationCards from './PublicationCards.astro';

interface Props {
  /** Array of project slugs to display */
  relatedProjects?: string[];

  /** Array of publication entry IDs to display */
  relatedPublications?: string[];

  /** Section title (default: "Related Work") */
  title?: string;
}

const {
  relatedProjects = [],
  relatedPublications = [],
  title = 'Related Work',
} = Astro.props;

const allProjects = await getCollection('projects');
const allPublications = await getCollection('publications');

const projects = relatedProjects
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const publications = relatedPublications
  .map((id) => allPublications.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const hasRelated = projects.length > 0 || publications.length > 0;
---

{hasRelated && (
  <aside class="related-content">
    <h2 class="related-title">{title}</h2>

    {publications.length > 0 && (
      <div class="related-section">
        <h3 class="related-section-title">Related Publications</h3>
        <PublicationCards entries={publications.map((pub) => pub.data)} columns={2} />
      </div>
    )}

    {projects.length > 0 && (
      <div class="related-section">
        <h3 class="related-section-title">Related Projects</h3>
        <div class="related-projects-grid">
          {projects.map((project) => (
            <a href={`/projects/${project.id}`} class="related-project-card">
              <div class="related-project-card__top">
                <span class="related-project-card__meta">
                  {project.data.year} · {project.data.role}
                </span>
                <span class="related-project-card__title-row">
                  <span class="related-project-card__title">{project.data.title}</span>
                  <ArrowRight size={16} stroke-width={2.25} class="related-project-card__arrow" aria-hidden="true" />
                </span>
                <p class="related-project-card__desc">{project.data.abstract}</p>
              </div>
              {project.data.domains && project.data.domains.length > 0 && (
                <div class="related-project-card__tags">
                  {project.data.domains.slice(0, 3).map((d) => (
                    <span class="related-project-card__tag">{d}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    )}
  </aside>
)}

<style>
  .related-content {
    margin-top: 3rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-heading, var(--color-text));
    margin: 0 0 1.25rem;
  }

  .related-section + .related-section {
    margin-top: 2rem;
  }

  .related-section-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 0.85rem;
  }

  .related-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .related-project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1.25rem 1.4rem;
    border-radius: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .related-project-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .related-project-card__meta {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .related-project-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .related-project-card__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .related-project-card:hover .related-project-card__title {
    color: var(--color-accent-hover);
  }

  .related-project-card__arrow {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .related-project-card:hover .related-project-card__arrow {
    transform: translateX(4px);
  }

  .related-project-card__desc {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .related-project-card__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .related-projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
