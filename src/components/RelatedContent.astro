---
/**
 * RelatedContent Component
 * 
 * Displays related projects and publications for cross-referencing content.
 * Fetches actual content data from slugs and renders compact cards.
 * 
 * @component
 * 
 * @example
 * ```astro
 * <RelatedContent 
 *   relatedProjects={['project-slug-1', 'project-slug-2']}
 *   relatedPublications={['publication-slug-1']}
 * />
 * ```
 */

import { getCollection } from 'astro:content';
import PublicationRows from './PublicationRows.astro';

interface Props {
  /** Array of project slugs to display */
  relatedProjects?: string[];
  
  /** Array of publication entry IDs to display */
  relatedPublications?: string[];
  
  /** Section title (default: "Related") */
  title?: string;
}

const { 
  relatedProjects = [], 
  relatedPublications = [],
  title = "Related"
} = Astro.props;

// Fetch all collections once
const allProjects = await getCollection('projects');
const allPublications = await getCollection('publications');

// Filter to get related items
const projects = relatedProjects
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const publications = relatedPublications
  .map((id) => allPublications.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const hasRelated = projects.length > 0 || publications.length > 0;
const soleProject = projects.length === 1 && publications.length === 0;
---

{hasRelated && (
  <aside class="related-content">
    <h2 class="related-title">{soleProject ? 'Related' : title}</h2>

    {projects.length > 0 && (
      <div class="related-section">
        {!soleProject && <h3 class="related-section-title">Projects</h3>}
        <ul class="related-list">
          {projects.map((project) => (
            <li>
              <a href={`/projects/${project.id}`} class="related-line">
                <span class="related-token">{project.data.year}</span>
                <span class="related-line__title">{project.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {publications.length > 0 && (
      <div class="related-section">
        <h3 class="related-section-title">Publications</h3>
        <PublicationRows entries={publications.map((pub) => pub.data)} columns={2} />
      </div>
    )}
  </aside>
)}

<style>
  .related-content {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .related-section + .related-section {
    margin-top: 1.25rem;
  }

  .related-section-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 0.35rem;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
  }

  .related-line {
    display: block;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .related-line--static {
    margin: 0;
  }

  .related-token {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .related-token::after {
    content: " · ";
  }

  .related-token:nth-last-child(2)::after {
    content: " — ";
  }

  .related-line__title {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  a.related-line:hover .related-line__title {
    color: var(--color-accent-hover);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 640px) {
    .related-list {
      grid-template-columns: 1fr;
    }
  }
</style>
