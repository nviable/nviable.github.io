---
/**
 * BaseCard Component
 * 
 * Foundation component providing consistent styling and structure for all card types.
 * This component should not be used directly - instead use specialized cards like
 * ArticleCard, ProjectCard, PublicationCard, or TalkCard for specific content types.
 * 
 * Features:
 * - Consistent hover effects and transitions
 * - Responsive padding and typography
 * - Flexible slot-based content structure
 * - Accessible link wrapper
 * 
 * @component
 * 
 * @slot badge - Optional badge/label at top (e.g., "Featured")
 * @slot meta - Metadata line (date, role, category, etc.)
 * @slot title - Card heading/title
 * @slot description - Card description or summary text
 * @slot tags - Container for tag list
 * @slot default - CTA links or additional content at bottom
 * 
 * @example
 * ```astro
 * <BaseCard href="/example" class="custom-card">
 *   <Fragment slot="meta">January 2024</Fragment>
 *   <Fragment slot="title">Card Title</Fragment>
 *   <Fragment slot="description">Card description text</Fragment>
 *   <ForwardLink text="Read more" />
 * </BaseCard>
 * ```
 */

interface Props {
  /** Target URL for the card; when omitted, renders a static card (no link) */
  href?: string;

  /** Open link in a new tab (use for external URLs) */
  external?: boolean;
  
  /** Additional CSS classes to apply to the card */
  class?: string;
}

const { href, external = false, class: className } = Astro.props;
const linkRel = external ? 'noopener noreferrer' : undefined;
const linkTarget = external ? '_blank' : undefined;
---

{href ? (
  <a
    href={href}
    class:list={['base-card', className]}
    target={linkTarget}
    rel={linkRel}
  >
    <slot name="badge" />
    <span class="card-meta"><slot name="meta" /></span>
    <span class="card-title"><slot name="title" /></span>
    <span class="card-description"><slot name="description" /></span>
    <slot name="tags" />
    <slot />
  </a>
) : (
  <div class:list={['base-card', 'base-card--static', className]}>
    <slot name="badge" />
    <span class="card-meta"><slot name="meta" /></span>
    <span class="card-title"><slot name="title" /></span>
    <span class="card-description"><slot name="description" /></span>
    <slot name="tags" />
    <slot />
  </div>
)}

<style>
  .base-card {
    --card-pad-y: 1.5rem;
    --card-pad-x: 1.75rem;
    --card-lip: 3px;
    display: block;
    position: relative;
    padding: var(--card-pad-y) var(--card-pad-x);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition:
      border-color var(--transition-base),
      background-color var(--transition-base),
      transform var(--transition-fast);
  }

  .base-card:not(.base-card--static) {
    border-bottom-width: var(--card-lip);
  }

  .base-card:hover {
    border-color: var(--color-text-muted);
    background: var(--color-bg-elevated);
  }

  .base-card:not(.base-card--static):hover .card-title {
    color: var(--color-accent-hover);
  }

  .base-card:not(.base-card--static):hover :global(.arrow-icon) {
    color: var(--color-accent-hover);
    transform: translateX(var(--arrow-shift));
  }

  .base-card:not(.base-card--static):active {
    border-bottom-width: 0;
    padding-bottom: calc(var(--card-pad-y) + var(--card-lip));
    transform: translateY(var(--card-lip));
  }

  .base-card.project-tile {
    --card-pad-y: 1.25rem;
    --card-pad-x: 1.5rem;
    height: 100%;
    background: var(--color-card);
    border-style: solid;
    border-width: 0 0 var(--card-lip) 0;
    border-color: var(--color-card-edge);
  }

  .base-card.project-tile:hover {
    background: var(--color-card-hover);
    border-color: var(--color-card-edge);
  }

  .base-card--static {
    cursor: default;
  }

  .base-card--static:hover {
    border-color: var(--color-border);
    background: var(--color-bg-secondary);
  }

  .card-meta {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .card-title {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.625rem;
    line-height: 1.4;
    transition: color var(--transition-base);
  }

  .card-description {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .base-card:active,
    .base-card :global(.arrow-icon) {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .base-card {
      --card-pad-y: 1.25rem;
      --card-pad-x: 1.5rem;
    }

    .base-card.project-tile {
      --card-pad-y: 1rem;
      --card-pad-x: 1.25rem;
    }

    .card-title {
      font-size: 1rem;
    }

    .card-description {
      font-size: 0.875rem;
    }
  }
</style>
