---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

type ArtifactType = 'demo' | 'code' | 'dataset' | 'paper' | 'website' | 'other';

interface Artifact {
  label: string;
  url: string;
  type: ArtifactType;
}

interface Props {
  artifacts: Artifact[];
}

const { artifacts } = Astro.props;
---

{artifacts.length > 0 && (
  <nav class="project-artifacts" aria-label="More links">
    <ul>
      {artifacts.map((a) => (
        <li>
          <a href={a.url} target="_blank" rel="noopener noreferrer">
            {a.label}
            <ArrowUpRight class="leave-icon" size={14} stroke-width={2} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .project-artifacts {
    margin-bottom: 2rem;
  }

  .project-artifacts ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-artifacts li + li {
    margin-top: 0.35rem;
  }

  .project-artifacts a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
