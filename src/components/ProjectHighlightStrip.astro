---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
const shown = highlights.slice(0, 3);
---

{shown.length > 0 && (
  <ul class="project-highlights" aria-label="Project highlights">
    {shown.map((h) => (
      <li class="project-highlights__pill">{h}</li>
    ))}
  </ul>
)}

<style>
  .project-highlights {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .project-highlights__pill {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    padding: 0.375rem 0.75rem;
    border-radius: var(--border-radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
  }
</style>
