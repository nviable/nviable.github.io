---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
---

{highlights.length > 0 && (
  <ul class="project-highlights" aria-label="Project highlights">
    {highlights.map((h) => (
      <li class="project-highlights__pill">{h}</li>
    ))}
  </ul>
)}

<style>
  .project-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .project-highlights__pill {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-text-secondary);
  }
</style>
