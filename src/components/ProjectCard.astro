---
/**
 * Project card for the projects index — abstract preview, domains, role/year meta.
 */

import Star from '@lucide/astro/icons/star';
import BaseCard from './BaseCard.astro';
import ForwardLink from './ForwardLink.astro';
import { truncateForPreview } from '../utils/preview';

interface Props {
  title: string;
  slug: string;
  abstract: string;
  role: string;
  year: number;
  domains?: string[];
  featured?: boolean;
  status?: 'completed' | 'ongoing' | 'archived' | 'inactive';
  icon?: string;
}

const {
  title,
  slug,
  abstract,
  role,
  year,
  domains = [],
  featured = false,
  status = 'completed',
  icon,
} = Astro.props;

const preview = truncateForPreview(abstract);
const displayDomains = domains.slice(0, 4);
const hasMoreDomains = domains.length > 4;

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
  inactive: { label: 'Inactive', class: 'status--inactive' },
};
const statusInfo = statusConfig[status];
---

<BaseCard href={`/projects/${slug}`} class="project-card">
  <div slot="badge" class="card-badges">
    {icon && (
      <img src={icon} alt="" class="project-icon" width="28" height="28" loading="lazy" decoding="async" />
    )}
    {featured && (
      <span class="featured-badge">
        <Star size={12} aria-hidden="true" />
        Featured
      </span>
    )}
    {status !== 'completed' && (
      <span class:list={['status-badge', statusInfo.class]}>
        {statusInfo.label}
      </span>
    )}
  </div>

  <Fragment slot="meta">{role} · {year}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{preview}</Fragment>

  {displayDomains.length > 0 && (
    <div slot="tags" class="tags-list">
      {displayDomains.map((d) => (
        <span class="tag">{d}</span>
      ))}
      {hasMoreDomains && (
        <span class="tag-more">+{domains.length - 4}</span>
      )}
    </div>
  )}

  <ForwardLink text="View details" />
</BaseCard>

<style>
  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-badges:empty {
    display: none;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .featured-badge svg {
    flex-shrink: 0;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .status--ongoing {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .status--archived {
    background: rgba(115, 115, 115, 0.15);
    color: var(--color-text-muted);
  }

  .status--inactive {
    background: rgba(234, 179, 8, 0.12);
    color: #ca8a04;
  }

  .project-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .tag-more {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
  }
</style>
