---
/**
 * Project card for the projects index — abstract preview, domains, role/year meta.
 */

import Star from '@lucide/astro/icons/star';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BaseCard from './BaseCard.astro';
import { truncateForPreview } from '../utils/preview';
import { projectCoverKind } from '../utils/projectImage';

interface Props {
  title: string;
  slug: string;
  abstract: string;
  role: string;
  year: number;
  domains?: string[];
  featured?: boolean;
  status?: 'completed' | 'ongoing' | 'archived' | 'inactive';
  icon?: string;
  coverImage?: string;
}

const {
  title,
  slug,
  abstract,
  role,
  year,
  domains = [],
  featured = false,
  status = 'completed',
  icon,
  coverImage,
} = Astro.props;

const thumb = coverImage || icon;
const thumbKind = projectCoverKind(thumb);

const preview = truncateForPreview(abstract);
const displayDomains = domains.slice(0, 4);
const hasMoreDomains = domains.length > 4;

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
  inactive: { label: 'Inactive', class: 'status--inactive' },
};
const statusInfo = statusConfig[status];
const showBadges = featured || status !== 'completed';
---

<BaseCard href={`/projects/${slug}`} class="project-card project-tile">
  <div slot="badge">
  {thumb && thumbKind && (
    <img
      src={thumb}
      alt=""
      width="176"
      height="64"
      class="project-thumb"
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  )}
  {showBadges && (
  <div class="card-badges">
    {featured && (
      <span class="featured-badge">
        <Star size={12} aria-hidden="true" />
        Featured
      </span>
    )}
    {status !== 'completed' && (
      <span class:list={['status-badge', statusInfo.class]}>
        {statusInfo.label}
      </span>
    )}
  </div>
  )}
  </div>

  <Fragment slot="meta">{role} · {year}</Fragment>
  <Fragment slot="title">
    <span class="title-row">
      <span class="title-row__text">{title}</span>
      <ArrowRight class="arrow-icon" size={16} stroke-width={2} aria-hidden="true" />
    </span>
  </Fragment>
  <Fragment slot="description">{preview}</Fragment>

  {displayDomains.length > 0 && (
    <div slot="tags" class="tags-list">
      {displayDomains.map((d) => (
        <span class="tag">{d}</span>
      ))}
      {hasMoreDomains && (
        <span class="tag-more">+{domains.length - 4}</span>
      )}
    </div>
  )}

</BaseCard>

<style>
  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-badges:empty {
    display: none;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .featured-badge svg {
    flex-shrink: 0;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: var(--border-radius-pill);
  }

  .status--ongoing {
    background: color-mix(in srgb, var(--color-quaternary) 18%, transparent);
    color: var(--color-status-ongoing);
  }

  .status--archived {
    background: rgba(115, 115, 115, 0.15);
    color: var(--color-text-muted);
  }

  .status--inactive {
    background: var(--color-tertiary-surface);
    color: var(--color-status-caution);
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .title-row__text {
    min-width: 0;
  }

  .arrow-icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-accent);
    transition:
      color var(--transition-base),
      transform var(--arrow-duration) ease;
  }

  .tag-more {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
  }
</style>
