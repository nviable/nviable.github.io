---
/**
 * Navigation Component
 *
 * Main site navigation with theme toggle:
 * - At top of page (unscrolled): transparent background with semi-transparent bottom border,
 *   showing both the geometric logo mark on the left and the ".Nviable" logotype on the right.
 * - On scroll down (.is-scrolled): smoothly transitions to the theme's header background
 *   (var(--color-bg)) and collapses the logotype so only the logo mark remains visible.
 */
import { siteConfig } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  ...siteConfig.nav,
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
};
---

<nav class="site-nav" aria-label="Main navigation" data-nav-root>
  <div class="nav-mobile-backdrop" data-nav-backdrop aria-hidden="true"></div>

  <a
    href="/"
    class="nav-brand"
    aria-label={`${siteConfig.title} — Home`}
    data-nav-brand
  >
    <!-- Geometric Logo Mark (51x41 aspect ratio) -->
    <svg
      class="nav-brand__mark"
      width="42"
      height="34"
      viewBox="0 0 51 41"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M1.16972 41C1.00596 41 0.818807 40.9531 0.655046 40.8828C0.257339 40.6954 0 40.2737 0 39.8285V14.0553C0 14.0553 0 14.0553 0 14.0318C0 13.7507 0.116972 13.4695 0.304128 13.2821C0.327523 13.2586 0.350917 13.2118 0.397706 13.1884C0.421101 13.1649 0.444495 13.1415 0.46789 13.1415L16.6101 0.254879C17.0312 -0.0731437 17.6394 -0.0965739 18.0605 0.254879L33.6413 12.5557L49.1284 0.254879C49.4794 -0.0262833 49.9706 -0.0731437 50.3683 0.114298C50.7661 0.30174 51 0.723483 51 1.16866V26.9419C51 27.2465 50.883 27.5042 50.6959 27.7151C50.6725 27.7385 50.6491 27.7854 50.6023 27.8088C50.5789 27.8322 50.5555 27.8557 50.5321 27.8557L34.3899 40.7423C33.9688 41.0703 33.3605 41.0937 32.9394 40.7423L17.3821 28.418L1.89495 40.7423C1.6844 40.9063 1.42706 41 1.16972 41ZM19.3005 26.9184L33.6881 38.329L47.9587 26.9419L33.6179 15.5548L19.3005 26.9184ZM2.33945 16.4686V37.3918L15.5339 26.9184L2.33945 16.4686ZM3.04128 14.0553L17.4055 25.4423L31.7229 14.0553L17.3119 2.66819L3.04128 14.0553ZM35.4894 14.0553L48.6605 24.5286V3.58197L35.4894 14.0553Z"
        fill="currentColor"
      />
    </svg>

    <!-- ".Nviable" Logotype on the right (127x25 aspect ratio), visible at top of page -->
    <span class="nav-brand__type-wrap" aria-hidden="true">
      <svg
        class="nav-brand__type"
        width="102"
        height="20"
        viewBox="2.61 48.01 45.78 8.99"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M12.5933 56.9112H10.6944L7.51852 52.1029V56.9112H5.61963V49.1157H7.51852L10.6944 53.9462V49.1157H12.5933V56.9112Z"
          fill="currentColor"
        />
        <path
          d="M16.757 55.1344L18.1007 50.7148H20.1217L17.923 56.9112H15.5799L13.3812 50.7148H15.4134L16.757 55.1344Z"
          fill="currentColor"
        />
        <path
          d="M21.876 50.0707C21.5429 50.0707 21.269 49.9745 21.0543 49.782C20.847 49.5821 20.7433 49.3378 20.7433 49.0491C20.7433 48.753 20.847 48.5087 21.0543 48.3162C21.269 48.1163 21.5429 48.0164 21.876 48.0164C22.2017 48.0164 22.4683 48.1163 22.6755 48.3162C22.8902 48.5087 22.9976 48.753 22.9976 49.0491C22.9976 49.3378 22.8902 49.5821 22.6755 49.782C22.4683 49.9745 22.2017 50.0707 21.876 50.0707ZM22.8199 50.7148V56.9112H20.921V50.7148H22.8199Z"
          fill="currentColor"
        />
        <path
          d="M23.8184 53.8019C23.8184 53.1652 23.9369 52.6063 24.1738 52.1251C24.4181 51.6439 24.7475 51.2737 25.1621 51.0146C25.5767 50.7555 26.0394 50.6259 26.5502 50.6259C26.987 50.6259 27.3682 50.7148 27.694 50.8925C28.0271 51.0701 28.2825 51.3033 28.4602 51.592V50.7148H30.3591V56.9112H28.4602V56.0339C28.2751 56.3226 28.016 56.5558 27.6829 56.7335C27.3571 56.9112 26.9759 57 26.5391 57C26.0357 57 25.5767 56.8704 25.1621 56.6113C24.7475 56.3448 24.4181 55.971 24.1738 55.4898C23.9369 55.0012 23.8184 54.4385 23.8184 53.8019ZM28.4602 53.813C28.4602 53.3392 28.3269 52.9653 28.0604 52.6914C27.8013 52.4175 27.483 52.2805 27.1054 52.2805C26.7279 52.2805 26.4058 52.4175 26.1393 52.6914C25.8802 52.9579 25.7507 53.3281 25.7507 53.8019C25.7507 54.2757 25.8802 54.6532 26.1393 54.9345C26.4058 55.2084 26.7279 55.3454 27.1054 55.3454C27.483 55.3454 27.8013 55.2084 28.0604 54.9345C28.3269 54.6606 28.4602 54.2868 28.4602 53.813Z"
          fill="currentColor"
        />
        <path
          d="M33.6317 51.592C33.8094 51.3033 34.0648 51.0701 34.3979 50.8925C34.7311 50.7148 35.1123 50.6259 35.5417 50.6259C36.0525 50.6259 36.5152 50.7555 36.9298 51.0146C37.3444 51.2737 37.6701 51.6439 37.907 52.1251C38.1513 52.6063 38.2734 53.1652 38.2734 53.8019C38.2734 54.4385 38.1513 55.0012 37.907 55.4898C37.6701 55.971 37.3444 56.3448 36.9298 56.6113C36.5152 56.8704 36.0525 57 35.5417 57C35.1049 57 34.7237 56.9149 34.3979 56.7446C34.0722 56.5669 33.8168 56.3337 33.6317 56.045V56.9112H31.7328V48.6937H33.6317V51.592ZM36.3412 53.8019C36.3412 53.3281 36.208 52.9579 35.9415 52.6914C35.6824 52.4175 35.3603 52.2805 34.9754 52.2805C34.5978 52.2805 34.2758 52.4175 34.0093 52.6914C33.7502 52.9653 33.6206 53.3392 33.6206 53.813C33.6206 54.2868 33.7502 54.6606 34.0093 54.9345C34.2758 55.2084 34.5978 55.3454 34.9754 55.3454C35.3529 55.3454 35.675 55.2084 35.9415 54.9345C36.208 54.6532 36.3412 54.2757 36.3412 53.8019Z"
          fill="currentColor"
        />
        <path d="M41.1685 48.6937V56.9112H39.2697V48.6937H41.1685Z" fill="currentColor" />
        <path
          d="M48.3857 53.713C48.3857 53.8907 48.3746 54.0758 48.3524 54.2683H44.0549C44.0845 54.6532 44.2066 54.9493 44.4213 55.1566C44.6434 55.3565 44.9136 55.4565 45.232 55.4565C45.7058 55.4565 46.0352 55.2566 46.2203 54.8568H48.2413C48.1377 55.264 47.9489 55.6304 47.675 55.9562C47.4085 56.2819 47.0716 56.5373 46.6645 56.7224C46.2573 56.9075 45.802 57 45.2986 57C44.6915 57 44.1511 56.8704 43.6773 56.6113C43.2035 56.3522 42.8334 55.9821 42.5669 55.5009C42.3003 55.0197 42.1671 54.457 42.1671 53.813C42.1671 53.1689 42.2966 52.6063 42.5558 52.1251C42.8223 51.6439 43.1924 51.2737 43.6662 51.0146C44.14 50.7555 44.6841 50.6259 45.2986 50.6259C45.8982 50.6259 46.4313 50.7518 46.8977 51.0035C47.364 51.2552 47.7268 51.6143 47.9859 52.0806C48.2524 52.547 48.3857 53.0912 48.3857 53.713ZM46.4424 53.2133C46.4424 52.8876 46.3313 52.6285 46.1092 52.436C45.8871 52.2435 45.6095 52.1473 45.2764 52.1473C44.958 52.1473 44.6878 52.2398 44.4657 52.4249C44.2511 52.61 44.1178 52.8728 44.066 53.2133H46.4424Z"
          fill="currentColor"
        />
        <path d="M2.61047 55.1761H4.34557V56.9112H2.61047V55.1761Z" fill="#F6EB0F" />
      </svg>
    </span>
  </a>

  <div
    id="site-nav-panel"
    class="nav-panel"
    data-nav-panel
    aria-hidden="false"
  >
    <ul class="nav-list">
      <li class="nav-highlight" data-nav-highlight aria-hidden="true"></li>
      {
        navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <button
    type="button"
    class="nav-menu-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-nav-panel"
    data-nav-toggle
  >
    <span class="nav-hamburger" aria-hidden="true">
      <span class="nav-hamburger__bar"></span>
      <span class="nav-hamburger__bar"></span>
      <span class="nav-hamburger__bar"></span>
    </span>
  </button>

  <div class="nav-end">
    <ThemeToggle />
  </div>
</nav>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      let active = false;

      if (href === '/') {
        active = currentPath === '/';
      } else if (href) {
        active = currentPath.startsWith(href);
      }

      link.classList.toggle('nav-link--active', active);
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function syncNavScrollState() {
    const rootEl = document.querySelector('[data-nav-root]');
    if (!(rootEl instanceof HTMLElement)) return;
    const hasHero = Boolean(document.querySelector('.hero-banner, .indigo-hero'));
    const scrolled = window.scrollY > 14;
    rootEl.classList.toggle('is-scrolled', scrolled);
    rootEl.classList.toggle('has-no-hero', !hasHero);
  }

  function setupMobileNav() {
    const rootEl = document.querySelector('[data-nav-root]');
    if (!(rootEl instanceof HTMLElement)) return;

    if (rootEl.dataset.navBound === '1') {
      updateActiveNav();
      syncNavScrollState();
      return;
    }
    rootEl.dataset.navBound = '1';

    const panelEl = rootEl.querySelector('[data-nav-panel]');
    const toggleEl = rootEl.querySelector('[data-nav-backdrop]')
      ? rootEl.querySelector('[data-nav-toggle]')
      : null;
    const backdropEl = rootEl.querySelector('[data-nav-backdrop]');
    const listEl = rootEl.querySelector('.nav-list');
    if (
      !(panelEl instanceof HTMLElement) ||
      !(toggleEl instanceof HTMLButtonElement) ||
      !(backdropEl instanceof HTMLElement)
    ) {
      return;
    }
    const root = rootEl;
    const panel = panelEl;
    const toggle = toggleEl;
    const backdrop = backdropEl;

    const mq = window.matchMedia('(min-width: 769px)');

    function syncPanelTop() {
      const top = root.getBoundingClientRect().bottom;
      document.documentElement.style.setProperty('--nav-panel-top', `${Math.ceil(top)}px`);
    }

    function isMobileNav() {
      return !mq.matches;
    }

    function setOpen(open = false) {
      if (!isMobileNav()) {
        root.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        panel.removeAttribute('inert');
        panel.setAttribute('aria-hidden', 'false');
        document.body.style.removeProperty('overflow');
        return;
      }

      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

      if (open) {
        syncPanelTop();
        panel.removeAttribute('inert');
        panel.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        const first = listEl?.querySelector('a[href]');
        window.requestAnimationFrame(() => {
          if (first instanceof HTMLElement) first.focus();
        });
      } else {
        panel.setAttribute('inert', '');
        panel.setAttribute('aria-hidden', 'true');
        document.body.style.removeProperty('overflow');
        if (document.activeElement instanceof Node && panel.contains(document.activeElement)) {
          toggle.focus();
        }
      }
    }

    function closeMenu() {
      setOpen(false);
    }

    function toggleMenu() {
      setOpen(!root.classList.contains('is-open'));
    }

    function applyMode() {
      if (isMobileNav()) {
        if (!root.classList.contains('is-open')) {
          panel.setAttribute('inert', '');
          panel.setAttribute('aria-hidden', 'true');
        }
      } else {
        root.classList.remove('is-open');
        panel.removeAttribute('inert');
        panel.setAttribute('aria-hidden', 'false');
        document.body.style.removeProperty('overflow');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      }
    }

    applyMode();

    toggle.addEventListener('click', () => {
      if (!isMobileNav()) return;
      toggleMenu();
    });

    backdrop.addEventListener('click', closeMenu);

    listEl?.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof Element && t.closest('a') && isMobileNav()) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        closeMenu();
      }
    });

    mq.addEventListener('change', () => {
      closeMenu();
      applyMode();
    });

    window.addEventListener(
      'resize',
      () => {
        if (root.classList.contains('is-open')) syncPanelTop();
      },
      { passive: true }
    );

    window.addEventListener('scroll', syncNavScrollState, { passive: true });
    syncNavScrollState();
  }

  function placeNavHighlight(animate: boolean, explicitLink?: HTMLElement) {
    const list = document.querySelector('.nav-list');
    const highlight = document.querySelector('[data-nav-highlight]');
    if (!(list instanceof HTMLElement) || !(highlight instanceof HTMLElement)) return;

    const desktop = window.matchMedia('(min-width: 769px)').matches;
    if (!desktop) {
      highlight.classList.remove('is-ready');
      return;
    }

    const link =
      explicitLink instanceof HTMLElement
        ? explicitLink
        : list.querySelector('.nav-link--active');
    if (!(link instanceof HTMLElement)) {
      highlight.classList.remove('is-ready');
      return;
    }

    const listRect = list.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const x = linkRect.left - listRect.left;
    const y = linkRect.top - listRect.top;

    if (!animate) {
      highlight.style.transition = 'none';
    }
    highlight.style.width = `${linkRect.width}px`;
    highlight.style.height = `${linkRect.height}px`;
    highlight.style.transform = `translate(${x}px, ${y}px)`;
    highlight.classList.add('is-ready');
    if (!animate) {
      highlight.getBoundingClientRect();
      highlight.style.removeProperty('transition');
    }
  }

  function setupNavHighlight() {
    const list = document.querySelector('.nav-list');
    if (!(list instanceof HTMLElement)) return;
    if (list.dataset.highlightBound === '1') {
      placeNavHighlight(false);
      return;
    }
    list.dataset.highlightBound = '1';

    list.addEventListener('mouseover', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('.nav-link');
      if (link instanceof HTMLElement) placeNavHighlight(true, link);
    });

    list.addEventListener('mouseleave', () => {
      placeNavHighlight(true);
    });

    list.addEventListener('focusin', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('.nav-link');
      if (link instanceof HTMLElement) placeNavHighlight(true, link);
    });

    list.addEventListener('focusout', (e) => {
      const next = e.relatedTarget;
      if (next instanceof Node && list.contains(next)) return;
      placeNavHighlight(true);
    });

    if (document.documentElement.dataset.navHighlightResize !== '1') {
      document.documentElement.dataset.navHighlightResize = '1';
      window.addEventListener('resize', () => placeNavHighlight(false), { passive: true });
    }
    window.requestAnimationFrame(() => placeNavHighlight(false));
  }

  function onNavPageLoad() {
    updateActiveNav();
    syncNavScrollState();
    const root = document.querySelector('[data-nav-root]');
    if (root instanceof HTMLElement && root.classList.contains('is-open')) {
      root.classList.remove('is-open');
      document.body.style.removeProperty('overflow');
      const panel = root.querySelector('[data-nav-panel]');
      const toggle = root.querySelector('[data-nav-toggle]');
      if (panel instanceof HTMLElement) {
        panel.setAttribute('inert', '');
        panel.setAttribute('aria-hidden', 'true');
      }
      if (toggle instanceof HTMLButtonElement) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      }
    }
    setupMobileNav();
    setupNavHighlight();
  }

  document.addEventListener('astro:page-load', onNavPageLoad);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onNavPageLoad, { once: true });
  } else {
    onNavPageLoad();
  }
</script>

<style>
  .site-nav {
    --nav-toggle-w: 48px;
    --site-nav-h: 4.15rem;
    min-height: var(--site-nav-h);
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background-color: transparent;
    padding: 0;
    margin-bottom: 0;
    position: relative;
    z-index: 120;
    transition:
      background-color 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      min-height 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* When scrolled down (or on a page without an indigo hero, or when mobile menu is open) */
  .site-nav.is-scrolled,
  .site-nav.has-no-hero,
  .site-nav.is-open {
    --site-nav-h: 3.6rem;
    background-color: var(--color-bg);
    border-bottom-color: var(--color-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .nav-mobile-backdrop {
    display: none;
  }

  .nav-brand {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    align-self: center;
    margin-left: 1.25rem;
    padding: 0.45rem 0;
    line-height: 0;
    text-decoration: none;
    outline-offset: 3px;
    position: relative;
    z-index: 3;
    color: #ffffff;
    transition: color 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav.is-scrolled .nav-brand,
  .site-nav.has-no-hero .nav-brand,
  .site-nav.is-open .nav-brand {
    color: var(--color-text);
  }

  .nav-brand:focus-visible {
    outline: 2px solid var(--color-accent);
  }

  .nav-brand__mark {
    display: block;
    width: 42px;
    height: 34px;
    flex-shrink: 0;
    transition:
      width 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav.is-scrolled .nav-brand__mark {
    width: 37px;
    height: 30px;
  }

  .nav-brand__type-wrap {
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    max-width: 120px;
    margin-left: 0.65rem;
    opacity: 1;
    transform: translateX(0);
    transition:
      max-width 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease,
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      margin-left 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav.is-scrolled .nav-brand__type-wrap {
    max-width: 0;
    margin-left: 0;
    opacity: 0;
    transform: translateX(-8px);
    pointer-events: none;
  }

  .nav-brand__type {
    display: block;
    width: 102px;
    height: 20px;
    flex-shrink: 0;
  }

  .nav-panel {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    position: relative;
    z-index: 2;
  }

  .nav-panel::-webkit-scrollbar {
    display: none;
  }

  .nav-list {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0 1.5rem;
    min-width: max-content;
    height: 100%;
  }

  .nav-highlight {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.12);
    z-index: 0;
    opacity: 0;
    transition:
      transform var(--transition-base),
      width var(--transition-base),
      height var(--transition-base),
      background-color 0.32s ease;
  }

  .site-nav.is-scrolled .nav-highlight,
  .site-nav.has-no-hero .nav-highlight,
  .site-nav.is-open .nav-highlight {
    background: var(--color-nav-highlight);
  }

  .nav-highlight.is-ready {
    opacity: 1;
  }

  .nav-item {
    margin: 0;
    flex-shrink: 0;
    display: flex;
    align-items: stretch;
    position: relative;
    z-index: 1;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 0 0.7rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.28s ease;
    white-space: nowrap;
