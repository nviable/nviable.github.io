---
/**
 * Unified timeline row for /journey — flat layout, category-colored icon-in-circle + vertical spine.
 */
import Flag from '@lucide/astro/icons/flag';
import BookOpen from '@lucide/astro/icons/book-open';
import Presentation from '@lucide/astro/icons/presentation';
import Users from '@lucide/astro/icons/users';
import Mic from '@lucide/astro/icons/mic';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ExternalLink from '@lucide/astro/icons/external-link';
import Play from '@lucide/astro/icons/play';
import FileText from '@lucide/astro/icons/file-text';
import Newspaper from '@lucide/astro/icons/newspaper';
import { formatTimelineDate } from '../utils/timelineDate';

/** Lucide outline icons per timeline category */
const ICON_BY_CATEGORY: Record<string, typeof Flag> = {
  conference: Presentation,
  teaching: BookOpen,
  milestone: Flag,
  media: Mic,
  engagement: Users,
};

const CATEGORY_LABELS: Record<string, string> = {
  conference: 'Conference',
  teaching: 'Teaching',
  milestone: 'Milestone',
  media: 'Media',
  engagement: 'Engagement',
};

interface Props {
  /** Stable id for expand target (e.g. entry id) */
  itemId: string;
  date: Date;
  category: string;
  title: string;
  description: string;
  /** Omit grey spine below last row */
  isLast?: boolean;
  skills?: string[];
  hasExpandable?: boolean;
  event?: string;
  url?: string;
  location?: string;
  duration?: string;
  topics?: string[];
  slides?: string;
  video?: string;
  featured?: boolean;
  relatedPresentation?: string;
  relatedPaper?: string;
  relatedArticle?: string;
}

const {
  itemId,
  date,
  category,
  title,
  description,
  isLast = false,
  skills = [],
  hasExpandable = false,
  event = '',
  url,
  location = '',
  duration,
  topics = [],
  slides,
  video,
  featured = false,
  relatedPresentation,
  relatedPaper,
  relatedArticle,
} = Astro.props;

const safeId = itemId.replace(/[^a-zA-Z0-9_-]/g, '-');
const bodyId = `tl-expand-${safeId}`;
const formattedDate = formatTimelineDate(date);
const categoryLabel = CATEGORY_LABELS[category] ?? category;
const CategoryIcon = ICON_BY_CATEGORY[category] ?? Flag;

const hasPrimaryMeta = Boolean((url && event) || event || url);
const showLocation = Boolean(location);
const showDuration = Boolean(duration);
const showMeta = hasPrimaryMeta || showLocation || showDuration;
const showSkillPills = skills.length > 0;
const showTopicPills = topics.length > 0;
const showResourceLinks = Boolean(
  slides ||
    video ||
    relatedPresentation ||
    relatedPaper ||
    relatedArticle
);
---

<article class="tl-item" data-category={category}>
  <div class="tl-track" aria-hidden="true">
    <div class="tl-bubble" data-category={category}>
      <CategoryIcon class="tl-icon" size={18} stroke-width={2} aria-hidden="true" />
    </div>
    {!isLast && <div class="tl-spine"></div>}
  </div>

  <div class="tl-main">
    <header class="tl-head">
      <time class="tl-date" datetime={date.toISOString()}>{formattedDate}</time>
      <span class="tl-badge" data-category={category}>{categoryLabel}</span>
      {featured && <span class="tl-featured">Featured</span>}
    </header>

    <h3 class="tl-title">{title}</h3>
    <p class="tl-desc">{description}</p>

    {showMeta && (
      <p class="tl-meta">
        {url && event ? (
          <a href={url} class="tl-meta__link" target="_blank" rel="noopener noreferrer">
            {event}
            <ExternalLink size={12} aria-hidden="true" />
          </a>
        ) : event ? (
          <span>{event}</span>
        ) : url ? (
          <a href={url} class="tl-meta__link" target="_blank" rel="noopener noreferrer">
            Link
            <ExternalLink size={12} aria-hidden="true" />
          </a>
        ) : null}
        {showLocation && (
          <>
            {hasPrimaryMeta && <span class="tl-meta__sep" aria-hidden="true">·</span>}
            <span>{location}</span>
          </>
        )}
        {showDuration && (
          <>
            {(hasPrimaryMeta || showLocation) && (
              <span class="tl-meta__sep" aria-hidden="true">·</span>
            )}
            <span>{duration}</span>
          </>
        )}
      </p>
    )}

    {showSkillPills && (
      <ul class="tl-pills" aria-label="Skills">
        {skills.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    )}

    {showTopicPills && (
      <ul class="tl-pills" aria-label="Topics">
        {topics.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )}

    {showResourceLinks && (
      <p class="tl-links">
        {slides && (
          <a href={slides} class="tl-link" target="_blank" rel="noopener noreferrer">
            <Presentation size={14} aria-hidden="true" />
            Slides
          </a>
        )}
        {video && (
          <a href={video} class="tl-link" target="_blank" rel="noopener noreferrer">
            <Play size={14} aria-hidden="true" />
            Video
          </a>
        )}
        {relatedPresentation && (
          <a
            href={relatedPresentation}
            class="tl-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Presentation size={14} aria-hidden="true" />
            Presentation
          </a>
        )}
        {relatedPaper && (
          <a href={relatedPaper} class="tl-link" target="_blank" rel="noopener noreferrer">
            <FileText size={14} aria-hidden="true" />
            Paper
          </a>
        )}
        {relatedArticle && (
          <a href={relatedArticle} class="tl-link" target="_blank" rel="noopener noreferrer">
            <Newspaper size={14} aria-hidden="true" />
            Article
          </a>
        )}
      </p>
    )}

    {hasExpandable && (
      <>
        <button
          type="button"
          class="tl-expand-btn"
          aria-expanded="false"
          aria-controls={bodyId}
        >
          <span class="tl-expand-text">Read more</span>
          <ChevronDown class="tl-expand-icon" size={16} aria-hidden="true" />
        </button>
        <div id={bodyId} class="tl-expand-body" aria-hidden="true">
          <div class="tl-expand-inner prose">
            <slot />
          </div>
        </div>
      </>
    )}
  </div>
</article>

<style>
  .tl-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem 1.25rem;
    align-items: stretch;
    margin: 0;
    padding: 0 0 2.5rem;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .tl-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 3rem;
    min-height: 100%;
    padding-top: 0.15rem;
  }

  .tl-bubble {
    box-sizing: border-box;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 2px solid var(--tl-accent, var(--color-accent));
    background: transparent;
    color: var(--tl-accent, var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tl-bubble :global(.tl-icon) {
    flex-shrink: 0;
  }

  .tl-spine {
    width: 2px;
    flex: 1 1 auto;
    min-height: 1.5rem;
    margin-top: 0.5rem;
    background: var(--color-border);
    border-radius: 1px;
    opacity: 0.9;
  }

  /* Icon ring + badge share category accent */
  .tl-bubble[data-category='milestone'],
  .tl-badge[data-category='milestone'] {
    --tl-accent: var(--color-accent);
  }
  .tl-bubble[data-category='conference'],
  .tl-badge[data-category='conference'] {
    --tl-accent: #3b82f6;
  }
  .tl-bubble[data-category='teaching'],
  .tl-badge[data-category='teaching'] {
    --tl-accent: #10b981;
  }
  .tl-bubble[data-category='media'],
  .tl-badge[data-category='media'] {
    --tl-accent: #8b5cf6;
  }
  .tl-bubble[data-category='engagement'],
  .tl-badge[data-category='engagement'] {
    --tl-accent: #f59e0b;
  }

  .tl-main {
    min-width: 0;
  }

  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .tl-date {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .tl-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--tl-accent, var(--color-border));
    color: var(--tl-accent, var(--color-text-muted));
    background: transparent;
  }

  .tl-featured {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .tl-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .tl-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
  }

  .tl-meta {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.35rem;
  }

  .tl-meta__sep {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .tl-meta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .tl-meta__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .tl-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
  }

  .tl-pills li {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .tl-pills li:last-child {
    margin-bottom: auto;
  }

  .tl-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
  }

  .tl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .tl-link:hover {
    text-decoration: underline;
  }

  .tl-expand-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    padding: 0.35rem 0;
    background: none;
    border: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    cursor: pointer;
    font-family: inherit;
  }

  .tl-expand-btn:hover {
    opacity: 0.85;
  }

  .tl-expand-icon {
    transition: transform 0.2s ease;
  }

  .tl-expand-btn[aria-expanded='true'] .tl-expand-icon {
    transform: rotate(180deg);
  }

  .tl-expand-btn[aria-expanded='true'] .tl-expand-text {
    font-size: 0;
  }

  .tl-expand-btn[aria-expanded='true'] .tl-expand-text::before {
    content: 'Show less';
    font-size: 0.875rem;
  }

  .tl-expand-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
    overflow: hidden;
  }

  .tl-expand-body[aria-hidden='false'] {
    grid-template-rows: 1fr;
  }

  .tl-expand-inner {
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .tl-expand-inner.prose :global(h2) {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
  }

  .tl-expand-inner.prose :global(p) {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  @media (max-width: 768px) {
    .tl-item {
      grid-template-columns: 2.75rem 1fr;
      gap: 0.75rem 1rem;
      padding-bottom: 2rem;
    }

    .tl-track {
      width: 2.75rem;
    }

    .tl-bubble {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tl-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .tl-title {
      font-size: 1.0625rem;
    }
  }
</style>

<script is:inline>
  (function () {
    function onExpandClick(e) {
      var btn = e.target && e.target.closest && e.target.closest('.tl-expand-btn');
      if (!btn) return;
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var id = btn.getAttribute('aria-controls');
      var target = id ? document.getElementById(id) : null;
      if (target) {
        btn.setAttribute('aria-expanded', String(!expanded));
        target.setAttribute('aria-hidden', String(expanded));
      }
    }
    document.addEventListener('click', onExpandClick);
  })();
</script>
