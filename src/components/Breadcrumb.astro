---
/**
 * Accessible breadcrumb trail (Home → … → current page).
 * Pass ordered crumbs; omit `href` on the last item or set current explicitly.
 */
export interface BreadcrumbItem {
  label: string;
  /** Omit on the final crumb when it is the current page */
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const safeItems = items.filter((i) => i.label.trim().length > 0);
---

{
  safeItems.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        {safeItems.map((item, index) => {
          const isLast = index === safeItems.length - 1;
          const hasHref = Boolean(item.href);
          return (
            <li class="breadcrumb__item">
              {!isLast && hasHref ? (
                <a class="breadcrumb__link" href={item.href}>
                  {item.label}
                </a>
              ) : (
                <span
                  class={isLast ? 'breadcrumb__current' : 'breadcrumb__muted'}
                  aria-current={isLast ? 'page' : undefined}
                >
                  {item.label}
                </span>
              )}
              {!isLast && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumb {
    margin: 0 0 1.25rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
  }

  .breadcrumb__link {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 4px;
    padding: 0.1rem 0.15rem;
    margin: -0.1rem -0.15rem;
    transition: color var(--transition-fast);
  }

  .breadcrumb__link:hover {
    color: var(--color-accent);
  }

  .breadcrumb__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .breadcrumb__sep {
    color: var(--color-text-muted);
    opacity: 0.55;
    user-select: none;
    font-weight: 400;
    margin-left: 0.15rem;
  }

  .breadcrumb__current {
    color: var(--color-text);
    font-weight: 600;
  }

  .breadcrumb__muted {
    color: var(--color-text-secondary);
    font-weight: 500;
  }
</style>
