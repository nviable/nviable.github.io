# Site Configuration
# Copy this file to .env and fill in your values

# Required: Your site URL (used for sitemap, canonical URLs, OG tags)
SITE_URL=https://example.com

# Site language (ISO 639-1 code, e.g., en, id, de, fr, es, ja, zh)
SITE_LANGUAGE=en

# Personal Information
SITE_AUTHOR_NAME="John Sohrawardi"
SITE_AUTHOR_TITLE="Postdoctoral Researcher · HCI & Digital Media Forensics"
SITE_AUTHOR_BIO="Human–computer interaction and digital media forensics researcher focused on building usable, trustworthy deepfake detection tools for journalists, intelligence analysts, and law enforcement. Founder and lead of the DeFake Project — an interdisciplinary initiative across four universities. Over 7 years of HCI and ML research experience; 4 years of UX and product-facing industry work."
SITE_AUTHOR_EMAIL=hello@example.com
SITE_AUTHOR_LOCATION="Rochester, NY"

# Social Links (leave empty to hide)
SOCIAL_GITHUB=https://github.com/username
SOCIAL_LINKEDIN=https://linkedin.com/in/username
SOCIAL_TWITTER=
SOCIAL_MASTODON=
SOCIAL_BLUESKY=
SOCIAL_ORCID=https://orcid.org/0000-0002-4707-7035
SOCIAL_SCHOLAR=https://scholar.google.com/citations?user=YOUR_ID&hl=en

# Site Metadata (browser tab, Open Graph, default SEO)
SITE_TITLE="John Sohrawardi — Portfolio Website"
SITE_DESCRIPTION="Human–computer interaction and digital media forensics researcher focused on building usable, trustworthy deepfake detection tools for journalists, intelligence analysts, and law enforcement. Founder and lead of the DeFake Project — an interdisciplinary initiative across four universities. Over 7 years of HCI and ML research experience; 4 years of UX and product-facing industry work."
