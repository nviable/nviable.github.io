# Site Configuration
# Copy this file to .env and fill in your values

# Required: Your site URL (used for sitemap, canonical URLs, OG tags)
SITE_URL=https://nviable.me

# Site language (ISO 639-1 code, e.g., en, id, de, fr, es, ja, zh)
SITE_LANGUAGE=en

# Personal Information
SITE_AUTHOR_NAME="John Sohrawardi"
SITE_AUTHOR_TITLE="Postdoctoral researcher, ESL Global Cybersecurity Institute, RIT"
SITE_AUTHOR_BIO="I work on usable systems for internet safety: digital media forensics, content verification, and media literacy."
SITE_AUTHOR_EMAIL=john.sohrawardi@rit.edu
SITE_AUTHOR_LOCATION="Rochester, NY"

# Social Links (leave empty to hide)
SOCIAL_GITHUB=https://github.com/username
SOCIAL_LINKEDIN=https://linkedin.com/in/username
SOCIAL_TWITTER=
SOCIAL_MASTODON=
SOCIAL_BLUESKY=
SOCIAL_ORCID=https://orcid.org/0000-0002-4707-7035
SOCIAL_SCHOLAR=https://scholar.google.com/citations?user=12j0HoYAAAAJ&hl=en

# Site Metadata (browser tab, Open Graph, default SEO)
SITE_TITLE="John Sohrawardi"
SITE_DESCRIPTION="I work on usable systems for internet safety: digital media forensics, content verification, and media literacy."

# --- R2 / CDN images (optional) ---
# Base URL for public object URLs (no trailing slash). Used by astro.config remotePatterns + RemoteImage.
# If the browser URL includes the bucket name in the path (e.g. https://cdn.example.com/my-bucket/key),
# set PUBLIC_ASSETS_URL to that full prefix: https://cdn.example.com/my-bucket
# Set the same in Cloudflare Pages build env for CI.
PUBLIC_ASSETS_URL=

# S3-compatible upload (local or CI that publishes assets only). Never commit real keys.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=   # usually same as PUBLIC_ASSETS_URL so uploads print the correct https://.../key URL

# --- Google Analytics (optional) ---
# GA4 measurement ID from Google Analytics → Admin → Data streams. Empty = disabled.
# Set the same in Cloudflare Pages → Settings → Environment variables for production.
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# --- Contact form (optional) ---
# Cloudflare Turnstile site key (public) for the contact-form anti-spam widget.
# The secret key + Email Routing binding live in Cloudflare. See docs/CONTACT-FORM-SETUP.md.
PUBLIC_TURNSTILE_SITE_KEY=
